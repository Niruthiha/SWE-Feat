+import json
+
+import pytest
+from click.testing import CliRunner
+
+import mlflow
+from mlflow.cli.scorers import commands
+from mlflow.genai.judges import make_judge
+
+
+@pytest.fixture
+def runner():
+    return CliRunner(catch_exceptions=False)
+
+
+@pytest.fixture
+def experiment_id():
+    return mlflow.create_experiment("test_scorers_cli")
+
+
+def _register_judge(experiment_id, name, description=None):
+    judge = make_judge(
+        name=name,
+        instructions="Evaluate {{ outputs }}",
+        model="openai:/gpt-4",
+        description=description,
+    )
+    judge.register(experiment_id=experiment_id)
+
+
+def test_list_scorers_table(runner, experiment_id):
+    _register_judge(experiment_id, "quality", description="Checks quality")
+    _register_judge(experiment_id, "safety")
+
+    result = runner.invoke(commands, ["list", "--experiment-id", experiment_id])
+
+    assert result.exit_code == 0
+    assert result.output.splitlines() == [
+        "Scorer Name  Description   ",
+        "-----------  --------------",
+        "quality      Checks quality",
+        "safety                     ",
+    ]
+
+
+def test_list_scorers_json(runner, experiment_id):
+    _register_judge(experiment_id, "quality", description="Checks quality")
+    _register_judge(experiment_id, "safety")
+
+    result = runner.invoke(commands, ["list", "-x", experiment_id, "--output", "json"])
+
+    assert result.exit_code == 0
+    assert json.loads(result.output) == {
+        "scorers": [
+            {"name": "quality", "description": "Checks quality"},
+            {"name": "safety", "description": None},
+        ]
+    }
+
+
+def test_list_scorers_empty(runner, experiment_id):
+    result = runner.invoke(commands, ["list", "-x", experiment_id])
+
+    assert result.exit_code == 0
+    assert result.output.strip() == ""
+
+
+def test_list_scorers_with_env_var(runner, experiment_id, monkeypatch):
+    _register_judge(experiment_id, "quality")
+    monkeypatch.setenv("MLFLOW_EXPERIMENT_ID", experiment_id)
+
+    result = runner.invoke(commands, ["list", "--output", "json"])
+
+    assert result.exit_code == 0
+    assert json.loads(result.output) == {"scorers": [{"name": "quality", "description": None}]}
+
+
+def test_register_llm_judge(runner, experiment_id):
+    result = runner.invoke(
+        commands,
+        [
+            "register-llm-judge",
+            "-n",
+            "my_judge",
+            "-i",
+            "Is {{ outputs }} a good answer to {{ inputs }}?",
+            "-m",
+            "openai:/gpt-4",
+            "-x",
+            experiment_id,
+            "-d",
+            "Checks answers",
+        ],
+    )
+
+    assert result.exit_code == 0
+    assert result.output.strip() == (
+        f"Successfully created and registered judge scorer 'my_judge' in experiment {experiment_id}"
+    )
+    scorers = mlflow.genai.scorers.list_scorers(experiment_id=experiment_id)
+    assert len(scorers) == 1
+    assert scorers[0].name == "my_judge"
+    assert scorers[0].description == "Checks answers"
+    assert scorers[0].instructions == "Is {{ outputs }} a good answer to {{ inputs }}?"
+    assert scorers[0].model == "openai:/gpt-4"
+    assert scorers[0]._feedback_value_type is str
+
+
+def test_register_llm_judge_with_env_var(runner, experiment_id, monkeypatch):
+    monkeypatch.setenv("MLFLOW_EXPERIMENT_ID", experiment_id)
+
+    result = runner.invoke(
+        commands,
+        ["register-llm-judge", "-n", "my_judge", "-i", "Rate {{ outputs }}", "-m", "openai:/gpt-4"],
+    )
+
+    assert result.exit_code == 0
+    assert f"in experiment {experiment_id}" in result.output
+
+
+def test_register_llm_judge_invalid_instructions(runner, experiment_id):
+    result = CliRunner().invoke(
+        commands,
+        ["register-llm-judge", "-n", "j", "-i", "no variables", "-x", experiment_id],
+    )
+
+    assert result.exit_code != 0
+    assert "at least one variable" in str(result.exception)
