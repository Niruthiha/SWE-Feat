+def _validate_feedback_value_type(feedback_value_type: Any) -> None:
+    """
+    Validate that feedback_value_type is one of the supported types for judge output.
+
+    Supported types are int, float, str, bool, Literal types with primitive values,
+    dict[str, T] and list[T] where T is one of int, float, str or bool.
+    """
+    if feedback_value_type in _PRIMITIVE_TYPES:
+        return
+
+    origin = get_origin(feedback_value_type)
+    args = get_args(feedback_value_type)
+
+    if origin is Literal:
+        if args and all(type(arg) in _PRIMITIVE_TYPES for arg in args):
+            return
+        raise MlflowException.invalid_parameter_value(
+            "The `feedback_value_type` argument does not support a Literal type with "
+            f"non-primitive values. Got {feedback_value_type}. Literal values must be of "
+            "type int, float, str or bool."
+        )
+
+    if origin is dict:
+        if len(args) == 2 and args[0] is str and args[1] in _PRIMITIVE_TYPES:
+            return
+        raise MlflowException.invalid_parameter_value(
+            "The `feedback_value_type` argument does not support a dict type with non-str keys "
+            f"or non-primitive values. Got {feedback_value_type}. Use dict[str, T] where T is "
+            "one of int, float, str or bool."
+        )
+
+    if origin is list:
+        if len(args) == 1 and args[0] in _PRIMITIVE_TYPES:
+            return
+        raise MlflowException.invalid_parameter_value(
+            "The `feedback_value_type` argument does not support a list type with "
+            f"non-primitive values. Got {feedback_value_type}. Use list[T] where T is "
+            "one of int, float, str or bool."
+        )
+
+    raise MlflowException.invalid_parameter_value(
+        f"Unsupported feedback_value_type: {feedback_value_type}. Supported types are "
+        "int, float, str, bool, Literal types with primitive values, dict[str, T] and "
+        "list[T] where T is one of int, float, str or bool."
+    )
+
+
+@experimental(version="3.4.0")
+@record_usage_event(MakeJudgeEvent)
+def make_judge(
+    name: str,
+    instructions: str,
+    model: str | None = None,
+    description: str | None = None,
+    feedback_value_type: Any = str,
+) -> Judge:
+    """
+    Create a custom MLflow judge instance.
+
+    Args:
+        name: The name of the judge.
+        instructions: Natural language instructions for evaluation. Must contain at least one
+            template variable: {{ inputs }}, {{ outputs }}, {{ expectations }},
+            or {{ trace }} to reference evaluation data. Custom variables are not
+            supported.
+        model: The model identifier to use for evaluation (e.g., "openai:/gpt-4").
+            If not provided, the default judge model is used.
+        description: A description of what the judge evaluates.
+        feedback_value_type: Type specification for the 'value' field in the Feedback
+            object. Defaults to ``str``. Supported types: ``int``, ``float``, ``str``,
+            ``bool``, ``Literal`` of primitive values, ``dict[str, T]`` and ``list[T]``
+            where ``T`` is one of ``int``, ``float``, ``str`` or ``bool``.
+
+    Returns:
+        An InstructionsJudge instance configured with the provided parameters.
+
+    Example:
+        .. code-block:: python
+
+            import mlflow
+            from mlflow.genai.judges import make_judge
+            from typing import Literal
+
+            # Create a judge that evaluates response quality using template variables
+            quality_judge = make_judge(
+                name="response_quality",
+                instructions=(
+                    "Evaluate if the response in {{ outputs }} correctly answers "
+                    "the question in {{ inputs }}. The response should be accurate, "
+                    "complete, and professional."
+                ),
+                model="openai:/gpt-4",
+                feedback_value_type=Literal["yes", "no"],
+            )
+
+            # Evaluate a response
+            result = quality_judge(
+                inputs={"question": "What is machine learning?"},
+                outputs="ML is basically when computers learn stuff on their own",
+            )
+
+            # Register the judge in an experiment
+            quality_judge.register(experiment_id="123")
+    """
+    _validate_feedback_value_type(feedback_value_type)
+
+    return InstructionsJudge(
+        name=name,
+        instructions=instructions,
+        model=model,
+        description=description,
+        feedback_value_type=feedback_value_type,
+    )
