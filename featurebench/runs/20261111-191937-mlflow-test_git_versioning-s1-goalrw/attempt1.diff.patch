--- /dev/null
+++ b/tests/genai/git_versioning/test_git_info.py
@@ -0,0 +1,93 @@
+import subprocess
+from unittest import mock
+
+import pytest
+
+from mlflow.genai.git_versioning.git_info import GitInfo, GitOperationError
+from mlflow.utils.mlflow_tags import (
+    MLFLOW_GIT_BRANCH,
+    MLFLOW_GIT_COMMIT,
+    MLFLOW_GIT_DIFF,
+    MLFLOW_GIT_DIRTY,
+    MLFLOW_GIT_REPO_URL,
+)
+
+
+def _git(*args: str) -> str:
+    return subprocess.check_output(["git", *args], text=True).strip()
+
+
+@pytest.fixture
+def git_repo(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    _git("init", "-b", "main")
+    _git("config", "user.email", "test@example.com")
+    _git("config", "user.name", "test")
+    (tmp_path / "file.txt").write_text("hello\n")
+    _git("add", "file.txt")
+    _git("commit", "-m", "init")
+    return tmp_path
+
+
+def test_from_env_clean_repo(git_repo):
+    (git_repo / "untracked.txt").write_text("untracked")
+    info = GitInfo.from_env(remote_name="origin")
+    assert info.branch == "main"
+    assert info.commit == _git("rev-parse", "HEAD")
+    assert info.dirty is False
+    assert info.repo_url is None
+    assert info.diff is None
+
+
+def test_from_env_dirty_repo_includes_staged_and_unstaged_diff(git_repo):
+    (git_repo / "file.txt").write_text("staged\n")
+    _git("add", "file.txt")
+    (git_repo / "file.txt").write_text("unstaged\n")
+    info = GitInfo.from_env(remote_name="origin")
+    assert info.dirty is True
+    assert "+unstaged" in info.diff
+    assert "-hello" in info.diff
+
+
+def test_from_env_repo_url(git_repo):
+    _git("remote", "add", "upstream", "https://example.com/repo.git")
+    assert GitInfo.from_env(remote_name="upstream").repo_url == "https://example.com/repo.git"
+    with mock.patch("mlflow.genai.git_versioning.git_info._logger.warning") as mock_warning:
+        assert GitInfo.from_env(remote_name="origin").repo_url is None
+    mock_warning.assert_called_once()
+
+
+def test_from_env_not_a_repo(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    with pytest.raises(GitOperationError, match="Not in a git repository"):
+        GitInfo.from_env(remote_name="origin")
+
+
+def test_from_env_detached_head(git_repo):
+    _git("checkout", "--detach")
+    with pytest.raises(GitOperationError, match="detached HEAD"):
+        GitInfo.from_env(remote_name="origin")
+
+
+def test_from_env_git_unavailable(git_repo):
+    with mock.patch.dict("sys.modules", {"git": None}):
+        with pytest.raises(GitOperationError, match="git"):
+            GitInfo.from_env(remote_name="origin")
+
+
+def test_to_mlflow_tags():
+    info = GitInfo(branch="main", commit="abc", dirty=False)
+    assert info.to_mlflow_tags() == {
+        MLFLOW_GIT_BRANCH: "main",
+        MLFLOW_GIT_COMMIT: "abc",
+        MLFLOW_GIT_DIRTY: "false",
+    }
+
+    info = GitInfo(branch="main", commit="abc", dirty=True, repo_url="url", diff="diff")
+    assert info.to_mlflow_tags() == {
+        MLFLOW_GIT_BRANCH: "main",
+        MLFLOW_GIT_COMMIT: "abc",
+        MLFLOW_GIT_DIRTY: "true",
+        MLFLOW_GIT_REPO_URL: "url",
+        MLFLOW_GIT_DIFF: "diff",
+    }
